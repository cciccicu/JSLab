{
  "package": "icu.ccicc.jslab.template",
  "name": "JSLab 模板",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.app"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.configuration"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.file"
    },
    {
      "name": "system.network"
    },
    {
      "name": "system.brightness"
    },
    {
      "name": "system.battery"
    },
    {
      "name": "system.geolocation"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.event"
    },
    {
      "name": "system.sensor"
    },
    {
      "name": "system.record"
    },
    {
      "name": "system.fetch"
    },
    {
      "name": "system.interconnect"
    },
    {
      "name": "system.uploadtask"
    },
    {
      "name": "system.request"
    },
    {
      "name": "system.crypto"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.audio"
    }
  ],
  "permissions": [
    {
      "name": "hapjs.permission.LOCATION"
    },
    {
      "name": "hapjs.permission.DEVICE_INFO"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 336
  },
  "router": {
    "entry": "pages/workspace/run",
    "pages": {
      "pages/overlay/select": {
        "component": "select",
        "path": "/overlay/select"
      },
      "pages/overlay/confirm": {
        "component": "confirm",
        "path": "/overlay/confirm"
      },
      "pages/overlay/number-input": {
        "component": "number-input",
        "path": "/overlay/number-input"
      },
      "pages/overlay/text-input": {
        "component": "text-input",
        "path": "/overlay/text-input"
      },
      "pages/workspace/run": {
        "component": "run",
        "path": "/workspace/run"
      },
      "pages/about": {
        "component": "about",
        "path": "/about"
      }
    }
  }
}
