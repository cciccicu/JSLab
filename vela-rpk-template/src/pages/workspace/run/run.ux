<template>
  <div class="page">
    <scroll id="ui-scroll" if="{{view === 'ui'}}" class="content" scroll-y="true" bounces="true">
      <div class="content-inner" style="{{ { height: '' + (layoutHeight) + 'px' } }}">
        <div if="{{uiNodes.length === 0}}" class="empty-card" style="{{ { top: '' + (contentTopPadding) + 'px' } }}">
          <text class="empty-title">{{emptyTitle}}</text>
          <text class="empty-detail">{{emptyDetail}}</text>
        </div>
        <div for="{{node in uiNodes}}" tid="id" class="node-wrap {{'node-' + node.kind}}" style="{{ { left: '' + (node.x) + 'px', top: '' + (node.y) + 'px', width: '' + (node.width) + 'px', height: '' + (node.height) + 'px', backgroundColor: '' + (node.background), borderRadius: '' + (node.radius) + 'px' } }}" @click="onNodePress(node.id, node.kind)">
          <text if="{{node.kind === 'heading' || node.kind === 'text'}}" class="ui-text" style="{{ { color: '' + (node.color), fontSize: '' + (node.size) + 'px', lineHeight: '' + (node.lineHeight) + 'px', fontWeight: '' + (node.bold), textAlign: '' + (node.align), lines: '' + (node.lines) } }}">{{node.text}}</text>
          <text elif="{{node.kind === 'button'}}" class="ui-text" style="{{ { width: '' + (node.width > 16 ? node.width - 16 : 0) + 'px', color: '' + (node.color), fontSize: '' + (node.size) + 'px', lineHeight: '' + (node.lineHeight) + 'px', lines: '' + (node.lines), fontWeight: '' + 'bold', textAlign: '' + 'center' } }}">{{node.text}}</text>
          <div elif="{{node.kind === 'switch'}}" class="control-copy" style="{{ { width: '' + (node.copyWidth) + 'px' } }}">
            <text class="control-label" style="{{ { width: '' + (node.copyWidth) + 'px', color: '' + (node.color) } }}">{{node.text}}</text>
            <text if="{{node.detail}}" class="control-detail" style="{{ { width: '' + (node.copyWidth) + 'px', color: '' + (node.detailColor) } }}">{{node.detail}}</text>
          </div>
          <div elif="{{node.kind === 'slider' || node.kind === 'progress'}}" class="value-header" style="{{ { width: '' + (node.width - 32) + 'px' } }}">
            <text class="value-label" style="{{ { color: '' + (node.color) } }}">{{node.text}}</text>
            <text class="value-text" style="{{ { color: '' + (node.accent) } }}">{{node.kind === 'progress' ? node.percent + '%' : node.value}}</text>
          </div>
          <qrcode elif="{{node.kind === 'qrcode'}}" value="{{node.value}}" style="{{ { width: '' + (node.qrSize) + 'px', height: '' + (node.qrSize) + 'px', color: '' + (node.color), backgroundColor: '' + (node.background) } }}"></qrcode>
          <image elif="{{(node.kind === 'image' || node.kind === 'canvas') && node.src}}" class="ui-image" src="{{node.src}}" style="{{ { width: '' + (node.width) + 'px', height: '' + (node.height) + 'px', objectFit: '' + (node.fit) } }}" @complete="onImageLoaded(node.id, node.src)" @error="onImageError(node.id, node.src)"></image>
          <switch if="{{node.kind === 'switch'}}" class="ui-switch" checked="{{node.checked}}" style="{{ { trackColor: '' + (node.accent), thumbColor: '' + (node.thumbColor) } }}" @change="onSwitchChange(node.id)"></switch>
          <slider elif="{{node.kind === 'slider'}}" class="ui-slider" min="{{node.min}}" max="{{node.max}}" step="{{node.step}}" value="{{node.value}}" style="{{ { width: '' + (node.width - 32) + 'px', height: '' + (node.height - 60) + 'px', color: '' + (node.trackColor), selectedColor: '' + (node.accent), blockColor: '' + (node.thumbColor) } }}" onchange="onSliderChange(node.id)"></slider>
          <progress elif="{{node.kind === 'progress'}}" class="ui-progress" percent="{{node.percent}}" style="{{ { width: '' + (node.width - 32) + 'px', color: '' + (node.accent), layerColor: '' + (node.trackColor) } }}"></progress>
        </div>
        <div if="{{error}}" class="error-card" style="{{ { top: '' + (errorTop) + 'px' } }}">
          <text class="error-title">运行错误</text>
          <text class="error-text">{{error}}</text>
        </div>
      </div>
    </scroll>
    <scroll if="{{view === 'console'}}" class="console-content" style="{{ { top: '' + (showTopBar ? screen.header : screen.topInset) + 'px', height: '' + (screen.height - (showTopBar ? screen.header : screen.topInset)) + 'px' } }}" scroll-y="true" @click="restoreUi">
      <text if="{{hasUi}}" class="console-hint">轻点日志返回界面</text>
      <text if="{{!logText && !error}}" class="console-hint">暂无日志</text>
      <text class="console-log">{{logText}}</text>
      <text if="{{error}}" class="console-error">{{error}}</text>
    </scroll>
    <image if="{{showTopBar}}" static src="/common/images/hd.png" class="topbar-bg" />
    <text if="{{showTopBar}}" class="time-text">{{nowTime}}</text>
    <text if="{{showTopBar && pageTitle.length <= 5}}" class="title-text">{{pageTitle}}</text>
    <marquee if="{{showTopBar && pageTitle.length > 5}}" class="title-marquee" scrollamount="4" loop="-1">{{pageTitle}}</marquee>
    <image if="{{showTopBar}}" static src="/common/images/back.png" class="btn btn-left-top" @click="onBack" />
    <image if="{{showTopBar}}" static src="/common/images/info.png" class="btn btn-right-top" @click="showAbout" />
  </div>
</template>

<script>
import file from '@system.file';
import app from '@system.app';
import router from '@system.router';
import { replace } from '../../../utils/core/routeManager.js';
import { vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { getPageElement, scheduleNextTick } from '../../../utils/core/runtimeCompat.js';
import { createScriptRuntimeApi } from '../../../utils/runtime/scriptRuntimeApi.js';
import { SCREEN } from '../../../utils/core/screen.js';
import { createUiSession } from '../../../utils/runtime/uiRuntime.js';
import { createUiPublisher } from '../../../utils/runtime/uiPublisher.js';
import { createConsoleBuffer, formatError } from '../../../utils/runtime/consoleBuffer.js';
const runs = new WeakMap();
export default {
  private: {
    screen:SCREEN, nowTime:'00:00', view:'console', pageTitle:'脚本', showTopBar:true, hasUi:false,
    contentTopPadding:SCREEN.header, uiNodes:[], emptyTitle:'空界面', emptyDetail:'脚本未提供显示组件',
    error:'', logText:'', layoutHeight:SCREEN.height, contentEnd:SCREEN.header, errorTop:SCREEN.header
  },
  onInit() {
    const pending={active:true,visible:true}; runs.set(this,pending);
    this.$app.$def.loadPayload().then(start => {
      if (pending.active) this.startRun(start,pending.visible);
    }, error => { if (pending.active) this.error=formatError(error); });
  },
  startRun(start,visible) {
    const state = { active:true, visible:visible, start:start || { name:'untitled.js', code:'' }, header:!start.options.hideTopBar, uiTitle:start.appName, publisher:createUiPublisher(), pending:null, logTimer:null, scroll:null };
    runs.set(this, state);
    state.logs = createConsoleBuffer(() => this.queueLogs());
    if (start.options.disableConsole) Object.keys(state.logs.console).forEach(key => { state.logs.console[key]=() => {}; });
    this.showTopBar=state.header; this.contentTopPadding=state.header ? SCREEN.header : SCREEN.topInset;
    state.session = createUiSession({
      files:file,
      mediaReady:this.$app.$def.uiMediaReady,
      top:() => state.header ? SCREEN.header : SCREEN.topInset,
      title:value => { state.uiTitle=value; if (this.view === 'ui') this.pageTitle=value; },
      header:value => { value=value && !state.start.options.hideTopBar; if (state.header === value) return false; state.header=value; if (this.view === 'ui') { this.showTopBar=value; this.contentTopPadding=value ? SCREEN.header : SCREEN.topInset; } return true; },
      show:() => this.showUi(), hide:() => this.showConsole(), scroll:value => this.requestScroll(value),
      publish:(nodes,height,end,changed) => this.publishUi(nodes,height,end,changed),
      error:error => this.reportError(error), clearError:() => this.clearRuntimeError()
    });
    state.session.setVisible(false);
    this.updateTime();
    this.pageTitle=state.start.appName.slice(0,80);
    const runtime=createScriptRuntimeApi(this.$app.$def, { name:state.start.name, owner:this,
      isActive:() => state.active && !state.navigating && !state.pending, reload:() => this.reload(), exit:() => this.navigate('exit') });
    try {
      const execute=new Function('console','ui','dialog','script','system',state.start.code);
      const result=execute(state.logs.console,state.session.ui,runtime.dialog,runtime.script,runtime.system);
      if (result && typeof result.then === 'function') result.then(null,error => this.reportError(error));
    } catch (error) { this.reportError(error); }
    this.flushLogs();
  },
  onShow() {
    startPageClock(this);
    const state=runs.get(this); if (!state || !state.active) return;
    state.visible=true; this.$app.$def.deliverDialog(this);
    if (state.pending) { const action=state.pending; state.pending=null; this.navigate(action); return; }
    if (state.session) state.session.setVisible(this.view === 'ui');
    if (state.logs && this.view === 'console') this.flushLogs();
    this.updateTime();
  },
  onHide() {
    stopPageClock(this);
    const state=runs.get(this); if (!state) return;
    state.visible=false; if (state.session) state.session.setVisible(false);
    if (state.logTimer !== null) clearTimeout(state.logTimer); state.logTimer=null;
  },
  onDestroy() {
    stopPageClock(this);
    const state=runs.get(this); if (!state) return;
    state.active=false; this.$app.$def.cancelOwnedDialog(this); if (state.session) state.session.dispose(); if (state.logs) state.logs.dispose();
    if (state.logTimer !== null) clearTimeout(state.logTimer);
    runs.delete(this);
  },
  updateTime() { this.nowTime=getCurrentClock(); },
  showUi() {
    const state=runs.get(this); if (!state || !state.active || state.navigating || state.pending || !state.session.hasFrame()) return false;
    const previousView=this.view;
    this.view='ui'; this.pageTitle=state.uiTitle; this.showTopBar=state.header; this.contentTopPadding=state.header ? SCREEN.header : SCREEN.topInset;
    if (state.logTimer !== null) clearTimeout(state.logTimer); state.logTimer=null;
    if (state.visible && state.session.setVisible(true) === false) {
      if (previousView === 'console') this.showConsole();
      return false;
    }
    this.hasUi=true;
    return true;
  },
  showConsole() {
    const state=runs.get(this); if (!state || !state.active || state.navigating || state.pending) return;
    state.session.setVisible(false); this.view='console'; this.showTopBar=!state.start.options.hideTopBar; this.pageTitle=state.start.appName.slice(0,80);
    if (state.visible) this.flushLogs();
  },
  restoreUi() { const state=runs.get(this); if (state && state.session) state.session.ui.show(); },
  onBack() { vibrate('short'); const state=runs.get(this); if (!state || !state.session) app.terminate(); else if (this.view === 'ui') this.showConsole(); else this.navigate('exit'); },
  showAbout() { router.push({uri:'/about'}); },
  onBackPress() { this.onBack(); return true; },
  reload() { this.navigate('reload'); },
  navigate(action) {
    const state=runs.get(this); if (!state || !state.active || state.navigating || state.pending) return;
    state.pending=action;
    try { if (this.$app.$def.closeOwnedDialog(this)) return; }
    catch (error) { state.pending=null; this.reportError(error); return; }
    state.pending=null;
    state.navigating=true;
    try {
      if (action === 'reload') replace('run');
      else app.terminate();
    } catch (error) { state.navigating=false; this.reportError(error); }
  },
  queueLogs() {
    const state=runs.get(this); if (!state || !state.visible || this.view !== 'console' || state.logTimer !== null) return;
    state.logTimer=setTimeout(() => { state.logTimer=null; this.flushLogs(); },32);
  },
  flushLogs() { const state=runs.get(this); if (state && state.logs && state.active && state.visible && this.view === 'console') this.logText=state.logs.read(); },
  reportError(error) {
    const state=runs.get(this); if (!state || !state.active) return;
    this.error=formatError(error); state.logs.console.error(this.error);
    this.errorTop=this.uiNodes.length ? this.contentEnd : this.contentTopPadding+140;
    if (this.view === 'ui') this.layoutHeight=Math.max(this.layoutHeight,this.errorTop+64+Math.ceil(this.error.length/12)*30);
    else this.flushLogs();
  },
  clearRuntimeError() { if (!this.error) return false; this.error=''; return true; },
  publishUi(nodes,height,end,changed) {
    const state=runs.get(this); if (!state || !state.active) return;
    if (changed) {
      try { const next=state.publisher.update(nodes,this.uiNodes); if (next !== this.uiNodes) this.uiNodes=next; }
      catch (error) { state.publisher=createUiPublisher(); throw error; }
    }
    this.contentEnd=end;
    if (this.error) { this.errorTop=nodes.length ? end : this.contentTopPadding+140; height=Math.max(height,this.errorTop+64+Math.ceil(this.error.length/12)*30); }
    this.layoutHeight=height;
    if (state.scroll !== null) this.requestScroll(state.scroll);
  },
  requestScroll(value) {
    const state=runs.get(this); if (!state) return; state.scroll=value;
    if (!state.visible || this.view !== 'ui') return;
    scheduleNextTick(this,() => {
      if (!state.active || !state.visible || this.view !== 'ui' || state.scroll === null) return;
      const element=getPageElement(this,'ui-scroll'); if (!element || !element.scrollTo) return;
      const target=state.scroll; state.scroll=null;
      element.scrollTo({ top:target === 'bottom' ? this.layoutHeight : target === 'top' ? 0 : Number(target)||0, left:0, behavior:'smooth' });
    });
  },
  onImageLoaded(id,src) { const state=runs.get(this); if (state && state.session) state.session.imageLoaded(id,src); },
  onImageError(id,src) { this.onImageLoaded(id,src); this.reportError(new Error('图片加载失败：' + id + '，请检查图片格式和地址')); },
  // Native controls can bubble clicks; only buttons use the root click target.
  onNodePress(id,kind) { if (kind === 'button') this.onButtonPress(id); },
  onButtonPress(id) { const state=runs.get(this); if (state && state.session.invoke(id)) vibrate('short'); },
  onSwitchChange(id,event) { const data=event && event.detail ? event.detail : event; const state=runs.get(this); if (state) state.session.invoke(id,!!(data && data.checked)); },
  onSliderChange(id,event) { const data=event && event.detail ? event.detail : event; if (data && data.isFromUser === false) return; const state=runs.get(this); if (state) state.session.invoke(id,Number(data && data.progress)||0); }
};
</script>

<style>
@import "./run.css";
</style>
