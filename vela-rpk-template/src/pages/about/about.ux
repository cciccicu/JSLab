<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="app-card">
        <image src="{{icon}}" class="logo" />
        <div class="app-text-group">
          <text class="app-name">{{name}}</text>
          <text class="app-version">版本 {{version}}</text>
        </div>
      </div>
      <text class="section-title">应用信息</text>
      <div class="info-card">
        <text class="card-label">作者</text>
        <text class="card-value">{{author}}</text>
      </div>
      <div class="info-card">
        <text class="card-label">包名</text>
        <text class="small-value">{{packageName}}</text>
        <text class="card-description">版本代码 {{versionCode}}</text>
      </div>
      <div class="info-card">
        <text class="card-label">脚本</text>
        <text class="small-value">{{scriptName}}</text>
      </div>
      <text class="section-title">运行选项</text>
      <div class="info-card">
        <text class="option-text">{{consoleLabel}}</text>
        <text class="option-text">{{headerLabel}}</text>
      </div>
      <text class="section-title">由 JSLab 提供支持</text>
      <div class="info-card promo-card">
        <text class="promo-brand">JSLab Cloud</text>
        <text class="promo-title">由 JSLab Cloud 生成</text>
        <text class="card-description">从云空间到独立快应用，让你的脚本随身可用。</text>
      </div>
      <div class="info-card promo-card">
        <text class="promo-brand">JSLab 脚本引擎</text>
        <text class="promo-title">使用 JSLab 脚本引擎运行</text>
        <text class="card-description">用 JavaScript 构建界面，让手腕上的创意成为日常工具。</text>
      </div>
      <div class="qrcode-card">
        <text class="card-title centered">发现更多脚本</text>
        <text class="card-description centered">扫码访问 JSLab Cloud</text>
        <qrcode value="https://ccicc.icu/jslab-cloud" class="cloud-qrcode"></qrcode>
        <text class="site-address">ccicc.icu/jslab-cloud</text>
      </div>
    </scroll>
    <image static src="/common/images/hd.png" class="topbar-bg" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">关于</text>
    <image static src="/common/images/back.png" class="back-button" @click="goBack" />
  </div>
</template>
<script>
import app from '@system.app';
import router from '@system.router';
import { vibrate } from '../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../utils/core/time.js';
const owners = new WeakMap();
export default {
  private: {
    nowTime:'00:00', name:'独立应用', version:'', icon:'/common/logo.png',
    author:'未填写', packageName:'', versionCode:'', scriptName:'',
    consoleLabel:'', headerLabel:''
  },
  onInit() {
    owners.set(this, true);
    this.updateTime();
    const info = app.getInfo();
    this.name = info.name;
    this.version = info.versionName;
    this.packageName = info.packageName;
    this.versionCode = String(info.versionCode);
    this.icon = info.icon || '/common/logo.png';
    this.$app.$def.loadPayload().then(data => {
      if (!owners.has(this)) return;
      this.name = data.appName;
      this.version = data.versionName;
      this.author = data.author || '未填写';
      this.scriptName = data.name;
      this.consoleLabel = data.options.disableConsole ? '日志输出：已关闭' : '日志输出：已开启';
      this.headerLabel = data.options.hideTopBar ? '运行顶栏：已隐藏' : '运行顶栏：已显示';
    }, () => {});
  },
  onShow() { startPageClock(this); },
  onHide() { stopPageClock(this); },
  onDestroy() { owners.delete(this); stopPageClock(this); },
  updateTime() { this.nowTime = getCurrentClock(); },
  goBack() { vibrate('short'); router.back(); },
  onBackPress() { this.goBack(); return true; }
};
</script>
<style>
@import "./about.css";
</style>
