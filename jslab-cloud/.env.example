# Node.js 24+. Run npm run setup before npm start.
JSLAB_HOST=127.0.0.1
JSLAB_PORT=3000
JSLAB_DATA_DIR=data
# Set your own public origin when using a reverse proxy or pairing a device.
# JSLAB_PUBLIC_ORIGIN=https://jslab.example.com
# Trust only your reverse proxy's address range.
# JSLAB_TRUST_PROXY=loopback
JSLAB_REGISTRATION=false
JSLAB_BODY_LIMIT=64mb
