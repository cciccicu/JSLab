{
  "name": "jslab-cloud",
  "version": "2.0.4",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.cjs",
    "setup": "node --env-file-if-exists=.env server/setup.cjs",
    "pretest": "npm run sync:docs",
    "test": "npm run check:docs && npm run check:rpk-template && node --test tests/*.test.js",
    "check:rpk-template": "node scripts/check-rpk-template.cjs",
    "sync:docs": "node scripts/sync-docs.cjs",
    "check:docs": "node scripts/sync-docs.cjs --check",
    "prepack": "npm run sync:docs && npm run check:rpk-template",
    "pack": "node scripts/pack-plugin.cjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "jsrsasign": "11.1.3",
    "jszip": "3.10.1",
    "markdown-it": "^14.3.2",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
