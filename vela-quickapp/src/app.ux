<script>
import { push } from './utils/core/routeManager.js';
import companionBridge from './utils/bridge/companionBridge.js';
import jsManager from './utils/files/jsManager.js';
import { createScriptStorage } from './utils/files/scriptData.js';
import deviceAccount from './utils/cloud/deviceAccount.js';
import deviceAi from './utils/cloud/deviceAi.js';
import marketClient from './utils/cloud/marketClient.js';
import cloudFilesClient from './utils/cloud/cloudFilesClient.js';
import { setCloudProxyRequest } from './utils/cloud/cloudTransport.js';
import { openDialog as requestDialog, getDialog, settleDialog, deliverDialog, cancelOwnedDialog, closeOwnedDialog, dialogDestroyed } from './utils/core/dialogState.js';
import configManager from './utils/core/configManager.js';

const cloudClients = { deviceAccount, deviceAi, marketClient, cloudFilesClient };

export default {
  runnerSource: null,
  marketRefreshNeeded: false,
  editor: {
    name: '',
    code: '',
    before: '',
    after: ''
  },

  onCreate() {
    configManager.init().catch((error) => {
      console.error('Failed to preload configuration:', error);
    });
    // The AstroBox sync plugin always uses Interconnect. This lifecycle bridge
    // must not depend on the user's separate cloud HTTP transport preference.
    companionBridge.start();
    setCloudProxyRequest(companionBridge.requestCloud);
  },

  onDestroy() {
    this.runnerSource = null;
    setCloudProxyRequest(null);
    companionBridge.stop();
  },

  getScriptManager() { return jsManager; },
  getScriptStorage(name) { return createScriptStorage(name); },
  getConfigManager() { return configManager; },
  getCloudClients() { return cloudClients; },

  openDialog(type, options, owner) { return requestDialog(type, options, owner); },
  getDialog(type, id) { return getDialog(type, id); },
  settleDialog(data, action, value) { return settleDialog(data, action, value); },
  deliverDialog(owner) { return deliverDialog(owner); },
  cancelOwnedDialog(owner) { return cancelOwnedDialog(owner); },
  closeOwnedDialog(owner) { return closeOwnedDialog(owner); },
  dialogDestroyed(data) { return dialogDestroyed(data); },

  openEditor(name, code) {
    this.editor.name = name;
    this.editor.code = '';
    this.editor.before = '';
    this.editor.after = code;
  },

  updateEditorCode(code) {
    this.editor.code = code;
  },

  openRunner(name, code) {
    this.runnerSource = { name: String(name || 'untitled.js'), code: String(code || '') };
    try { push('run'); }
    catch (error) { this.runnerSource = null; throw error; }
  }
};
</script>
