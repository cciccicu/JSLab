<import name="input-method" src="../../../components/InputMethod/InputMethod.ux"></import>
<template>
	<div class="page" style="flex-direction: column;">
		<!-- 高亮时按源码行渲染，避免 Vela 吞掉 span 内的换行。 -->
		<scroll
		id="code-scroll"
		class="scroll"
		scroll-x="true"
		scroll-y="true"
		bounces="true"
		@scroll="onCodeScroll"
		style="position:absolute;top:0px;left:0px;height:480px;width:100%;flex-direction: column;padding: 0px 6px;"
	  >
		<div class="code-top-spacer"></div>
		<div class="code-document" @click="onCodeClick" style="width: {{codeWidth}}px; height: {{codeHeight}}px;">
		  <text if="{{initialHighlightPending}}" class="rendering-status">正在渲染</text>
		  <div elif="{{highlightRendering}}" class="code-lines">
			<div for="{{line in codeLines}}" tid="lineKey" class="code-line" style="height: {{cursorHeight}}px;">
			  <text class="code code-line-text" style="font-family: {{fontFamily}}; font-size: {{fontSize}}px; line-height: {{cursorHeight}}px; height: {{cursorHeight}}px;"><span for="{{token in line.tokens}}" tid="tokenKey" style="color: {{token.color}};">{{token.text}}</span></text>
			</div>
		  </div>
		  <text elif="{{!highlightRendering}}" class="code code-plain-text" style="font-family: {{fontFamily}}; font-size: {{fontSize}}px; line-height: {{cursorHeight}}px; height: {{codeTextHeight}}px;">{{plainCodeText}}</text>
		  <div else class="code-lines"></div>
		  <div if="{{showCursor && !initialHighlightPending}}" class="code-cursor" style="left: {{cursorX}}px; top: {{cursorY}}px; width: {{fontSize/6}}px; height: {{cursorHeight}}px;"></div>
		</div>
		<div class="code-bottom-spacer" style="height: {{hideInputMethod ? 78 : 255}}px;"></div>
	  </scroll>

		<!-- 第三方输入法 -->
		<input-method if="{{!hideInputMethod}}"
			hide="{{hideInputMethod}}"
			initial-language="en"
			maxlength="{{maxlength}}"
			vibratemode="{{vibrateMode}}"
			@delete="onInputMethodDelete"
			@complete="onInputMethodComplete"
		></input-method>

		<!-- 光标方向控制 -->
		<div if="{{showCursorControls}}" class="cursormove">
			<img src="/common/images/up.png" class="cursor-btn" @click="move('up')"></img>
			<img src="/common/images/left.png" class="cursor-btn" @click="move('left')"></img>
			<img src="/common/images/right.png" class="cursor-btn" @click="move('right')"></img>
			<img src="/common/images/down.png" class="cursor-btn" @click="move('down')"></img>
		</div>

		<!-- 底部工具栏 -->
		<img if="{{!hideToolbar}}" class="btn {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/save.png" style="left: 6px;top: 402px;" @click="save" />
		<img if="{{!hideToolbar}}" class="btn {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/run.png" style="left: 90px;top: 402px;" @click="run" />
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/move.png" style="left: 174px;top: 402px;" @click="toggleCursorControls" />
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/edit.png" style="left: 258px;top: 402px;" @click="toggleKeyboard" />

		<!-- 顶栏 -->
		<img static src="/common/images/hd.png" class="topbar-bg" />
		<text class="time-text">{{nowTime}}</text>
		<text class="title-text">编辑脚本</text>
		<img static class="btn" src="/common/images/back.png" @click="goBack" style="left: 6px;top: 6px;" />
		<img static if="{{hideInputMethod}}" class="btn" src="/common/images/more.png" @click="openEditorMenu" style="left: 258px;top: 6px;" />
		<img static if="{{!hideInputMethod}}" class="btn" src="/common/images/down.png" @click="toggleKeyboard" style="left: 258px;top: 6px;" />
		<div if="{{showEditorMenu}}" class="editor-menu-dismiss" @click="closeEditorMenu"></div>
		<div if="{{showEditorMenu}}" class="editor-menu-card">
			<text class="editor-menu-item" @click="handleEditorMenu('ai')">AI 生成</text>
			<text class="editor-menu-item" @click="handleEditorMenu('saveAs')">另存为</text>
			<text class="editor-menu-item" @click="handleEditorMenu('settings')">编辑器设置</text>
			<text class="editor-menu-item" @click="handleEditorMenu('help')">帮助</text>
			<text class="editor-menu-item" @click="handleEditorMenu('clearData')">清除数据</text>
			<text class="editor-menu-item editor-menu-last" @click="handleEditorMenu('clearConfig')">清除配置</text>
		</div>
	</div>
</template>

<script>
import { DEFAULT_FONT_PROFILE, readActiveFontProfile } from '../../../utils/editor/fontProfile.js';
import { back as navigateBack, push } from '../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { commitHighlightedLines, createHighlightState, highlightCodeDocument } from '../../../utils/editor/javascriptHighlighter.js';
import { DEFAULT_HIGHLIGHT_PALETTE, normalizeHighlightPalette } from '../../../utils/editor/highlightPalette.js';
import { getLineHeight } from '../../../utils/editor/codeEditor.js';
import { createCodeDocument, deleteCodeBackward, insertCodeText, moveCodeCursor, moveCodeCursorToPoint } from '../../../utils/editor/codeDocument.js';
import { DEFAULT_FONT_SIZE, DEFAULT_HIGHLIGHT_CHAR_THRESHOLD, DEFAULT_HIGHLIGHT_LINE_THRESHOLD, normalizeFontSize, normalizeHighlightCharThreshold, normalizeHighlightLineThreshold } from '../../../utils/editor/editorPreferences.js';
import { formatError } from '../../../utils/core/userError.js';
import { IS_ASTROBOX_EDITION, showAstroBoxRestriction } from '../../../utils/core/edition.js';
const CODE_VIEWPORT_HEIGHT = 300;
const INITIAL_HIGHLIGHT_DELAY = 32;
const CODE_TOP_SPACER_HEIGHT = 84;
const KEYBOARD_TOP = 225;
const CARET_VISIBLE_WIDTH = 280;
const editorScrollPositions = new WeakMap();
const editorStates = new WeakMap();
function editorSource(state) {
  if (state.source === null) state.source = state.before + state.after;
  return state.source;
}
export default {
  private: {
    nowTime: "00:00",
    hideToolbar: false,
    codeLines: [],
    plainCodeText: '',
    highlightRendering: false,
    initialHighlightPending: false,
    initialHighlightComplete: false,
    initialHighlightTimer: null,
    highlightRevision: 0,
    codeHeight: CODE_VIEWPORT_HEIGHT,
    codeTextHeight: 20,
    largeFileMode: false,
    syntaxHighlightEnabled: false,
    highlightCharThreshold: DEFAULT_HIGHLIGHT_CHAR_THRESHOLD,
    highlightLineThreshold: DEFAULT_HIGHLIGHT_LINE_THRESHOLD,
    highlightPalette: DEFAULT_HIGHLIGHT_PALETTE,
    preferencesLoading: false,
    pageActive: true,
    pageReady: false,
    showCursorControls: false,
    hideInputMethod: true,
    showEditorMenu: false,
    maxlength: 5,
    vibrateMode: "short",
    fontFamily: 'JSLabActive',
    fontProfile: DEFAULT_FONT_PROFILE,
    fontSize: DEFAULT_FONT_SIZE,
    codeWidth: 336,
    // 光标状态
    showCursor: true,
    cursorX: 0,
    cursorY: 0,
    cursorHeight: 20,
    cursorBlinkTimer: null,
    cursorRevealTimer: null,
    lockToken: null,
    loadedEditorName: '',
    savedSource: '',
    editorVisible: false,
    backPromptOpen: false,
    pendingBackAfterDialog: false,
    saveInProgress: false,
    storageActionInProgress: false
  },
  onInit() {
    editorScrollPositions.set(this, { left: 0, top: 0 });
    this.activateEditorSession();
    this.loadEditorPreferences();
    this.updateTime();
  },
  onReady() {
    this.pageReady = true;
    this.scheduleInitialHighlight();
  },
  onDestroy() {
    stopPageClock(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
    this.cancelInitialHighlight();
    this.stopCursorBlink();
    if (this.cursorRevealTimer) clearTimeout(this.cursorRevealTimer);
    this.releaseEditorLock();
    editorScrollPositions.delete(this);
    editorStates.delete(this);
    this.codeLines = [];
    this.plainCodeText = '';
  },
  onShow() {
    startPageClock(this);
    this.$app.$def.deliverDialog(this);
    this.editorVisible = true;
    const editor = this.$app.$def.editor;
    if (!this.lockToken || editor.name !== this.loadedEditorName) this.activateEditorSession();
    const state = editorStates.get(this);
    if (state && (state.before !== editor.before || state.after !== editor.after)) {
      this.cancelInitialHighlight();
      this.initialHighlightComplete = false;
      this.initialHighlightPending = false;
      this.prepareInitialCodeDisplay();
    }
    if (this.pendingBackAfterDialog) {
      this.pendingBackAfterDialog = false;
      this.leaveEditor();
      return;
    }
    this.loadEditorPreferences();
    this.scheduleInitialHighlight();
    if (!this.largeFileMode) this.startCursorBlink();
  },
  onHide() {
    stopPageClock(this);
    this.editorVisible = false;
    this.showEditorMenu = false;
    this.cancelInitialHighlight(false);
    this.stopCursorBlink();
    if (this.cursorRevealTimer) clearTimeout(this.cursorRevealTimer);
    this.cursorRevealTimer = null;
  },
  activateEditorSession() {
    this.releaseEditorLock();
    editorStates.delete(this);
    const editor = this.$app.$def.editor;
    // 偏好读取完成前只走纯文本路径，不能沿用上一次会话的高亮状态。
    this.syntaxHighlightEnabled = false;
    this.highlightRendering = false;
    this.initialHighlightPending = false;
    this.initialHighlightComplete = false;
    this.cancelInitialHighlight();
    this.loadedEditorName = editor.name;
    if (editor.name) this.lockToken = this.$app.$def.getScriptManager().lock(editor.name);
    if (!editor.before && !editor.after && editor.code) editor.before = editor.code;
    editor.code = '';
    this.savedSource = editor.before + editor.after;
    this.codeLines = [];
    this.plainCodeText = '';
    this.codeWidth = 336;
    this.codeHeight = CODE_VIEWPORT_HEIGHT;
    this.codeTextHeight = getLineHeight(this.fontProfile, this.fontSize);
  },
  releaseEditorLock() {
    if (this.lockToken && this.loadedEditorName) {
      this.$app.$def.getScriptManager().unlock(this.loadedEditorName, this.lockToken);
    }
    this.lockToken = null;
  },
  loadEditorPreferences() {
    if (this.preferencesLoading) return;
    this.preferencesLoading = true;
    Promise.all([this.$app.$def.getConfigManager().get('editor.font.size', DEFAULT_FONT_SIZE), readActiveFontProfile(), this.$app.$def.getConfigManager().get('editor.highlight.enabled', true), this.$app.$def.getConfigManager().get('editor.highlight.maxChars', DEFAULT_HIGHLIGHT_CHAR_THRESHOLD), this.$app.$def.getConfigManager().get('editor.highlight.maxLines', DEFAULT_HIGHLIGHT_LINE_THRESHOLD), this.$app.$def.getConfigManager().get('editor.highlight.palette', DEFAULT_HIGHLIGHT_PALETTE)]).then(values => {
      this.preferencesLoading = false;
      if (!this.pageActive) return;
      const nextSize = normalizeFontSize(values[0]);
      const nextProfile = values[1];
      const nextHighlightEnabled = values[2] !== false;
      const nextCharThreshold = normalizeHighlightCharThreshold(values[3]);
      const nextLineThreshold = normalizeHighlightLineThreshold(values[4]);
      const nextPalette = normalizeHighlightPalette(values[5]);
      const profileChanged = JSON.stringify(nextProfile) !== JSON.stringify(this.fontProfile);
      const preferencesChanged = nextSize !== this.fontSize || profileChanged || nextHighlightEnabled !== this.syntaxHighlightEnabled || nextCharThreshold !== this.highlightCharThreshold || nextLineThreshold !== this.highlightLineThreshold || nextPalette !== this.highlightPalette;
      if (!preferencesChanged && (this.initialHighlightComplete || this.initialHighlightPending)) return;
      /*
       * A cached config can resolve before the first frame. Only select the
       * rendering path here; the expensive first highlight runs after onReady.
       */
      this.fontSize = nextSize;
      if (profileChanged) this.fontProfile = nextProfile;
      this.fontFamily = 'JSLabActive';
      this.syntaxHighlightEnabled = nextHighlightEnabled;
      this.highlightCharThreshold = nextCharThreshold;
      this.highlightLineThreshold = nextLineThreshold;
      this.highlightPalette = nextPalette;
      this.prepareInitialCodeDisplay();
    }).catch(error => {
      this.preferencesLoading = false;
      if (!this.pageActive) return;
      console.error('Failed to load editor preferences:', error);
      this.prepareInitialCodeDisplay();
      showToast(formatError(error, '读取编辑器设置，已使用当前设置'));
    });
  },
  prepareInitialCodeDisplay() {
    this.cancelInitialHighlight();
    const state = this.getEditorState();
    const document = state.document;
    state.highlight = null;
    this.initialHighlightComplete = !this.syntaxHighlightEnabled ||
      document.sourceLength > this.highlightCharThreshold || document.lines.length > this.highlightLineThreshold;
    this.initialHighlightPending = !this.initialHighlightComplete;
    this.updateCodeDisplay();
  },
  scheduleInitialHighlight() {
    if (!this.initialHighlightPending || this.initialHighlightTimer || !this.pageReady || !this.editorVisible) return;
    const revision = this.highlightRevision;
    const editorName = this.loadedEditorName;
    this.initialHighlightTimer = setTimeout(() => {
      this.initialHighlightTimer = null;
      if (!this.pageActive || !this.editorVisible || revision !== this.highlightRevision || editorName !== this.loadedEditorName || !this.initialHighlightPending || !this.syntaxHighlightEnabled) return;
      this.initialHighlightComplete = true;
      this.initialHighlightPending = false;
      this.updateCodeDisplay();
    }, INITIAL_HIGHLIGHT_DELAY);
  },
  cancelInitialHighlight(invalidate = true) {
    if (this.initialHighlightTimer) {
      clearTimeout(this.initialHighlightTimer);
      this.initialHighlightTimer = null;
    }
    if (invalidate) this.highlightRevision += 1;
  },
  startCursorBlink() {
    if (this.cursorBlinkTimer || !this.editorVisible) return;
    this.cursorBlinkTimer = setInterval(() => {
      this.showCursor = !this.showCursor;
    }, 500);
  },
  stopCursorBlink() {
    if (this.cursorBlinkTimer) {
      clearInterval(this.cursorBlinkTimer);
      this.cursorBlinkTimer = null;
    }
  },
  routerTo(page) {
    vibrate('short');
    push(page);
  },
  goBack() {
    vibrate('short');
    this.handleBack();
  },
  onBackPress() {
    this.handleBack();
    return true;
  },
  handleBack() {
    if (this.showEditorMenu) {
      this.showEditorMenu = false;
      return;
    }
    if (!this.hideInputMethod) {
      this.hideInputMethod = true;
      this.hideToolbar = false;
      return;
    }
    if (this.showCursorControls) {
      this.showCursorControls = false;
      return;
    }
    this.requestBack();
  },
  hasUnsavedChanges() {
    const editor = this.$app.$def.editor;
    return editor.before + editor.after !== this.savedSource;
  },
  requestBack() {
    if (this.saveInProgress) {
      return;
    }
    if (!this.hasUnsavedChanges()) {
      this.leaveEditor();
      return;
    }
    if (this.backPromptOpen) return;
    this.backPromptOpen = true;
    this.$app.$def.openDialog('confirm', {
      title: '保存修改？',
      message: "是否保存当前修改？",
      confirmText: "保存",
      secondaryText: "不保存",
      cancelText: "继续编辑"
    }, this).then(result => {
      if (result.action === "confirm") {
        this.backPromptOpen = false;
        this.saveCurrentCode(true);
      }
      if (result.action === "secondary") {
        this.backPromptOpen = false;
        this.discardAndLeave();
      }
      if (result.action === "cancel") {
        this.backPromptOpen = false;
      }
    }).catch(error => {
      this.backPromptOpen = false;
      showToast(error.message || "无法打开对话框");
    });
  },
  discardAndLeave() {
    const editor = this.$app.$def.editor;
    editor.before = '';
    editor.after = this.savedSource;
    this.leaveEditor();
  },
  leaveEditor() {
    if (!this.editorVisible) {
      this.pendingBackAfterDialog = true;
      return;
    }
    this.releaseEditorLock();
    this.loadedEditorName = '';
    navigateBack();
  },
  toggleKeyboard() {
    vibrate('short');
    this.showEditorMenu = false;
    this.hideInputMethod = !this.hideInputMethod;
    this.hideToolbar = !this.hideInputMethod;
    if (this.showCursorControls) this.showCursorControls = false;
    if (!this.hideInputMethod) this.scheduleCursorReveal();
  },
  toggleCursorControls() {
    vibrate('short');
    this.showCursorControls = !this.showCursorControls;
  },
  openEditorMenu() {
    if (this.saveInProgress) return;
    vibrate('short');
    this.showEditorMenu = !this.showEditorMenu;
  },
  closeEditorMenu() { this.showEditorMenu = false; },
  handleEditorMenu(action) {
    this.showEditorMenu = false;
    if (action === 'ai') this.openAiGenerator();
    else if (action === 'saveAs') { vibrate('short'); this.startSaveAs(); }
    else if (action === 'settings') this.routerTo('settingsEditor');
    else if (action === 'help') this.routerTo('settingsHelp');
    else if (action === 'clearData') this.clearScriptArea('data');
    else if (action === 'clearConfig') this.clearScriptArea('config');
  },
  clearScriptArea(area) {
    if (this.storageActionInProgress || !this.editorVisible) return;
    const name = this.$app.$def.editor.name;
    const label = area === 'data' ? '数据' : '配置';
    this.storageActionInProgress = true;
    vibrate('short');
    this.$app.$def.openDialog('confirm', {
      title: '清除' + label + '？',
      message: '将清除「' + name + '」保存的全部' + label + '。脚本文件不会删除。',
      confirmText: '清除',
      cancelText: '取消'
    }, this).then(result => {
      if (result.action !== 'confirm') return;
      return this.$app.$def.getScriptStorage(name)[area].clear().then(() => {
        if (this.pageActive) showToast(label + '已清除');
      });
    }).catch(error => {
      if (this.pageActive) showToast('清除' + label + '失败：' + formatError(error));
    }).then(() => { this.storageActionInProgress = false; });
  },
  openAiGenerator() {
    vibrate('short');
    if (IS_ASTROBOX_EDITION) {
      showAstroBoxRestriction(this).catch(error => console.error('无法显示版本说明:', error));
      return;
    }
    push('aiGenerate');
  },
  startSaveAs() {
    const currentName = this.$app.$def.editor.name;
    const baseName = currentName.replace(/\.js$/i, '');
    this.$app.$def.openDialog('text', {
      title: '另存为',
      message: '输入新文件名',
      placeholder: '文件名',
      value: baseName.slice(0, 123) + '-copy',
      maxLength: 128,
      required: true
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        this.confirmSaveAs(value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  confirmSaveAs(inputValue) {
    if (this.saveInProgress) return;
    vibrate('short');
    const editor = this.$app.$def.editor;
    let nextName = String(inputValue || '').trim();
    if (!nextName) {
      showToast('文件名不能为空');
      return;
    }
    if (!/\.js$/i.test(nextName)) nextName += '.js';
    if (nextName === editor.name) {
      showToast('请输入不同的文件名');
      return;
    }
    const source = editor.before + editor.after;
    this.saveInProgress = true;
    this.$app.$def.getScriptManager().list().then(files => {
      if (!this.pageActive) return;
      if (files.some(fileInfo => fileInfo.name === nextName)) throw new Error('文件已存在');
      return this.$app.$def.getScriptManager().write(nextName, source);
    }).then(() => {
      if (!this.pageActive) return;
      const oldName = editor.name;
      this.$app.$def.getScriptManager().unlock(oldName, this.lockToken);
      editor.name = nextName;
      this.loadedEditorName = nextName;
      this.lockToken = this.$app.$def.getScriptManager().lock(nextName);
      this.savedSource = source;
      showToast('已另存为 ' + nextName);
    }).catch(error => { if (this.pageActive) showToast(formatError(error, '另存脚本为 ' + nextName)); })
      .then(() => { if (this.pageActive) this.saveInProgress = false; });
  },
  onInputMethodDelete() {
    this.remove();
  },
  onInputMethodComplete(evt) {
    if (evt && evt.detail && evt.detail.content) {
      this.insert(evt.detail.content);
    }
  },
  onCodeClick(event) {
    const detail = event && event.detail ? event.detail : event || {};
    const position = editorScrollPositions.get(this);
    if (!position) return;
    // pageX/pageY omit the inner scroll offset on the target device. Convert
    // viewport coordinates explicitly; offset coordinates are already local.
    const clientX = Number(detail.clientX);
    const clientY = Number(detail.clientY);
    const x = detail.clientX != null && isFinite(clientX) ?
      clientX + position.left - 6 : Number(detail.offsetX);
    const y = detail.clientY != null && isFinite(clientY) ?
      clientY + position.top - CODE_TOP_SPACER_HEIGHT : Number(detail.offsetY);
    if (!isFinite(x) || !isFinite(y)) return;
    this.moveCursorTo(x, y);
    vibrate('short');
  },
  moveCursorTo(x, y) {
    const state = this.getEditorState();
    moveCodeCursorToPoint(state.document, x, y);
    this.commitCursorPosition(state);
  },
  getEditorState() {
    const editor = this.$app.$def.editor;
    let state = editorStates.get(this);
    if (!state || state.before !== editor.before || state.after !== editor.after ||
      state.fontProfile !== this.fontProfile || state.fontSize !== this.fontSize) {
      const source = editor.before + editor.after;
      state = { before: editor.before, after: editor.after, source, fontProfile: this.fontProfile,
        fontSize: this.fontSize, highlight: null,
        document: createCodeDocument(source, this.fontProfile, this.fontSize, editor.before.length) };
      editorStates.set(this, state);
    }
    if (editor.code) editor.code = '';
    return state;
  },
  commitCursorPosition(state) {
    const editor = this.$app.$def.editor;
    const offset = state.document.cursor.offset;
    const distance = offset - editor.before.length;
    if (distance < 0) {
      editor.after = editor.before.slice(offset) + editor.after;
      editor.before = editor.before.slice(0, offset);
    } else if (distance > 0) {
      editor.before += editor.after.slice(0, distance);
      editor.after = editor.after.slice(distance);
    }
    state.before = editor.before;
    state.after = editor.after;
    this.applyCursorPosition(state.document.cursor);
    this.scheduleCursorReveal();
  },
  updateCodeDisplay(change) {
    const state = this.getEditorState();
    const document = state.document;
    const isLarge = document.sourceLength > this.highlightCharThreshold || document.lines.length > this.highlightLineThreshold;
    const wasLarge = this.largeFileMode;
    if (wasLarge !== isLarge) this.largeFileMode = isLarge;
    const position = document.cursor;
    const textHeight = document.lines.length * position.height;
    const codeHeight = Math.max(CODE_VIEWPORT_HEIGHT, textHeight);
    if (this.cursorHeight !== position.height) this.cursorHeight = position.height;
    if (this.codeTextHeight !== textHeight) this.codeTextHeight = textHeight;
    if (this.codeHeight !== codeHeight) this.codeHeight = codeHeight;
    if (this.codeWidth !== document.width) this.codeWidth = document.width;
    this.applyCursorPosition(position);
    if (!wasLarge && isLarge) this.stopCursorBlink();
    else if (wasLarge && !isLarge) this.startCursorBlink();
    if ((isLarge || !this.syntaxHighlightEnabled) && this.initialHighlightPending) {
      this.cancelInitialHighlight();
      this.initialHighlightPending = false;
      this.initialHighlightComplete = true;
    }
    if (!this.initialHighlightComplete && !isLarge && this.syntaxHighlightEnabled) {
      this.initialHighlightPending = true;
      this.highlightRendering = false;
      if (this.codeLines.length) this.codeLines = [];
      if (this.plainCodeText) this.plainCodeText = '';
      this.cancelInitialHighlight();
      this.scheduleInitialHighlight();
      return;
    }
    let highlighted = false;
    if (!isLarge && this.syntaxHighlightEnabled) {
      try {
        if (!state.highlight || state.highlight.paletteId !== this.highlightPalette ||
          state.highlight.maxTokens !== this.highlightCharThreshold) {
          state.highlight = createHighlightState(this.highlightPalette, this.highlightCharThreshold);
        }
        const update = highlightCodeDocument(state.highlight, document, change);
        if (update) {
          const lines = commitHighlightedLines(this.codeLines, update);
          if (lines !== this.codeLines) this.codeLines = lines;
          highlighted = true;
        }
      } catch (error) {
        // Incomplete scripts are normal while editing; highlighting must not crash the page.
        console.error('Syntax highlighting failed, falling back to plain text:', error);
        state.highlight = null;
      }
    } else {
      state.highlight = null;
    }
    if (this.highlightRendering !== highlighted) this.highlightRendering = highlighted;
    if (highlighted) {
      if (this.plainCodeText) this.plainCodeText = '';
    } else {
      if (this.codeLines.length) this.codeLines = [];
      const source = editorSource(state);
      if (this.plainCodeText !== source) this.plainCodeText = source;
    }
  },
  insert(str) {
    const value = String(str || '');
    if (!value) return;
    const editor = this.$app.$def.editor;
    const state = this.getEditorState();
    const change = insertCodeText(state.document, value);
    editor.before += value;
    state.before = editor.before;
    state.source = null;
    this.updateCodeDisplay(change);
    this.scheduleCursorReveal();
  },
  remove() {
    const editor = this.$app.$def.editor;
    if (editor.before.length > 0) {
      const state = this.getEditorState();
      const change = deleteCodeBackward(state.document);
      editor.before = editor.before.slice(0, -1);
      state.before = editor.before;
      state.source = null;
      this.updateCodeDisplay(change);
      this.scheduleCursorReveal();
    }
  },
  onCodeScroll(event) {
    const detail = event && event.detail ? event.detail : event || {};
    const position = editorScrollPositions.get(this);
    if (!position) return;
    const left = Number(detail.scrollX);
    const top = Number(detail.scrollY);
    if (isFinite(left)) position.left = Math.max(0, left);
    if (isFinite(top)) position.top = Math.max(0, top);
  },
  getCursorRevealTarget() {
    const position = editorScrollPositions.get(this);
    if (!position) return null;
    const visibleHeight = KEYBOARD_TOP - CODE_TOP_SPACER_HEIGHT;
    let left = null;
    let top = null;
    if (this.cursorX < position.left + 8) left = Math.max(0, this.cursorX - 16);
    else if (this.cursorX > position.left + CARET_VISIBLE_WIDTH) left = Math.max(0, this.cursorX - CARET_VISIBLE_WIDTH);
    if (this.cursorY < position.top + 8) top = Math.max(0, this.cursorY - 20);
    else if (this.cursorY + this.cursorHeight > position.top + visibleHeight - 8) top = Math.max(0, this.cursorY - 70);
    if (left === position.left) left = null;
    if (top === position.top) top = null;
    if (left === null && top === null) return null;
    const target = { behavior: 'instant' };
    if (left !== null) target.left = left;
    if (top !== null) target.top = top;
    return target;
  },
  scheduleCursorReveal() {
    if (this.hideInputMethod || !this.pageActive || !this.editorVisible) return;
    if (this.cursorRevealTimer) clearTimeout(this.cursorRevealTimer);
    this.cursorRevealTimer = null;
    if (!this.getCursorRevealTarget()) return;
    this.cursorRevealTimer = setTimeout(() => {
      this.cursorRevealTimer = null;
      if (this.hideInputMethod || !this.pageActive || !this.editorVisible) return;
      const scroll = this.$element('code-scroll');
      if (!scroll || typeof scroll.scrollTo !== 'function') return;
      const target = this.getCursorRevealTarget();
      if (!target) return;
      const position = editorScrollPositions.get(this);
      if (!position) return;
      if (target.left !== undefined) position.left = target.left;
      if (target.top !== undefined) position.top = target.top;
      scroll.scrollTo(target);
    }, 0);
  },
  move(direction) {
    vibrate('short');
    const state = this.getEditorState();
    if (moveCodeCursor(state.document, direction)) this.commitCursorPosition(state);
  },
  applyCursorPosition(position) {
    if (this.cursorX !== position.x) this.cursorX = position.x;
    if (this.cursorY !== position.y) this.cursorY = position.y;
    if (this.cursorHeight !== position.height) this.cursorHeight = position.height;
    if (!this.showCursor) this.showCursor = true;
  },
  save() {
    vibrate('short');
    this.saveCurrentCode(false);
  },
  saveCurrentCode(leaveAfterSave) {
    if (this.saveInProgress) return;
    const editor = this.$app.$def.editor;
    const code = editor.before + editor.after;
    this.saveInProgress = true;
    this.$app.$def.getScriptManager().write(editor.name, code, {
      token: this.lockToken
    }).then(() => {
      if (!this.pageActive) return;
      this.saveInProgress = false;
      this.savedSource = code;
      showToast('代码已保存');
      if (leaveAfterSave) this.leaveEditor();
    }).catch(error => {
      if (!this.pageActive) return;
      this.saveInProgress = false;
      showToast(formatError(error, '保存脚本 ' + editor.name));
    });
  },
  run() {
    vibrate('short');
    if (this.saveInProgress) return;
    const editor = this.$app.$def.editor;
    this.$app.$def.openRunner(editor.name, editor.before + editor.after);
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  }
};
</script>

