	.editor-menu-layer { position: absolute; left: 0px; top: 78px; width: 336px; height: 402px; background-color: rgba(0,0,0,0.58); justify-content: flex-start; align-items: flex-start; }
	.editor-menu-card { width: 260px; height: 248px; margin-left: 70px; padding: 8px 12px; border-radius: 28px; background-color: #262626; flex-direction: column; flex-shrink: 0; }
	.editor-menu-item { width: 236px; height: 58px; border-bottom-width: 2px; border-bottom-color: #3d3d3d; color: #ffffff; font-size: 22px; font-weight: bold; text-align: left; padding-left: 18px; }
	.editor-menu-last { border-bottom-width: 0px; }
