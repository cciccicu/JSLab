<import name="input-method" src="../../../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page">
    <scroll class="scroll" scroll-x="true" scroll-y="true" bounces="true">
      <div class="code-document" @click="moveToPoint" style="width:{{codeWidth}}px;">
        <text class="code" style="font-family:{{fontFamily}};font-size:{{fontSize}}px;line-height:{{cursorHeight}}px;width:{{codeWidth}}px;">{{codeShow}}</text>
        <div if="{{showCursor}}" class="cursor" style="left:{{cursorX}}px;top:{{cursorY}}px;height:{{cursorHeight}}px;width:{{fontSize / 6}}px;"></div>
      </div>
      <div class="code-bottom-space"></div>
    </scroll>

    <input-method if="{{!hideInputMethod}}" hide="{{hideInputMethod}}" initial-language="en" maxlength="5" vibratemode="short" @delete="onInputMethodDelete" @complete="onInputMethodComplete"></input-method>
    <div if="{{showCursorControls}}" class="cursor-controls">
      <img src="/common/images/up.png" class="cursor-button" @click="move('up')" />
      <img src="/common/images/left.png" class="cursor-button" @click="move('left')" />
      <img src="/common/images/right.png" class="cursor-button" @click="move('right')" />
      <img src="/common/images/down.png" class="cursor-button" @click="move('down')" />
    </div>
    <img if="{{!hideToolbar}}" class="button {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/save.png" style="left:6px;top:402px;" @click="save" />
    <img if="{{!hideToolbar}}" class="button {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/run.png" style="left:90px;top:402px;" @click="run" />
    <img if="{{!hideToolbar}}" class="button" src="/common/images/move.png" style="left:174px;top:402px;" @click="toggleCursorControls" />
    <img if="{{!hideToolbar}}" class="button" src="/common/images/edit.png" style="left:258px;top:402px;" @click="toggleKeyboard" />

    <img static src="/common/images/hd.png" class="topbar" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">编辑 · v1</text>
    <img static src="/common/images/back.png" class="button" style="left:6px;top:6px;" @click="goBack" />
    <img static if="{{hideInputMethod}}" src="/common/images/more.png" class="button" style="left:258px;top:6px;" @click="openSettings" />
    <img static if="{{!hideInputMethod}}" src="/common/images/down.png" class="button" style="left:258px;top:6px;" @click="toggleKeyboard" />
  </div>
</template>

<script>
import configManager from '../../../../utils/core/configManager.js';
import jsManager from '../../../../utils/files/jsManager.js';
import { getCursorPosition, getTextWidth, moveCursorToPoint, moveCursorVertically } from '../../../../utils/editor/codeEditor.js';
import { back as navigateBack, push } from '../../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../../utils/core/time.js';
import { DEFAULT_FONT_SIZE, normalizeFontSize } from '../../../../utils/editor/editorPreferences.js';
import { formatError } from '../../../../utils/core/userError.js';
export default {
  private: {
    nowTime: '00:00',
    editorName: '',
    lockToken: null,
    hideInputMethod: true,
    hideToolbar: false,
    showCursorControls: false,
    codeShow: '',
    showCursor: true,
    cursorX: 0,
    cursorY: 0,
    cursorHeight: 20,
    cursorTimer: null,
    fontSize: DEFAULT_FONT_SIZE,
    fontFamily: '',
    fontProfile: {
      lineHeightRatio: 1,
      lineHeightOffset: 0,
      asciiWidthRatio: 0.5,
      wideWidthRatio: 1
    },
    codeWidth: 336,
    savedSource: '',
    pageActive: true,
    saveInProgress: false,
    backPromptOpen: false
  },
  onInit() {
    this.nowTime = getCurrentClock();
    this.activateSession();
  },
  onShow() {
    startPageClock(this);
    this.startCursorBlink();
    this.$app.$def.deliverDialog(this);
    this.updateCodeDisplay();
    this.loadPreferences();
  },
  onHide() { stopPageClock(this); this.stopCursorBlink(); },
  onDestroy() {
    stopPageClock(this);
    this.pageActive = false;
    this.$app.$def.cancelOwnedDialog(this);
    this.stopCursorBlink();
    this.releaseLock();
  },
  activateSession() {
    this.editorName = this.$app.$def.editor.name;
    if (!this.editorName) {
      showToast('没有可编辑的文件');
      navigateBack();
      return;
    }
    this.lockToken = jsManager.lock(this.editorName);
    this.savedSource = this.source();
    this.updateCodeDisplay();
  },
  loadPreferences() {
    configManager.get('editor.font.size', DEFAULT_FONT_SIZE).then(value => {
      if (!this.pageActive) return;
      const size = normalizeFontSize(value);
      if (size === this.fontSize) return;
      this.fontSize = size;
      this.updateCodeDisplay();
    }).catch(error => { if (this.pageActive) console.error('Failed to load editor font size:', error); });
  },
  releaseLock() {
    if (this.lockToken && this.editorName) jsManager.unlock(this.editorName, this.lockToken);
    this.lockToken = null;
  },
  source() {
    return this.$app.$def.editor.before + this.$app.$def.editor.after;
  },
  updateCodeDisplay() {
    const editor = this.$app.$def.editor;
    const source = this.source();
    editor.code = source;
    this.codeShow = source;
    this.codeWidth = Math.max(336, getTextWidth(source, this.fontProfile, this.fontSize) + 40);
    const cursor = getCursorPosition(editor.before, this.fontProfile, this.fontSize);
    this.cursorX = cursor.x;
    this.cursorY = cursor.y;
    this.cursorHeight = cursor.height;
  },
  startCursorBlink() {
    if (this.cursorTimer) return;
    this.showCursor = true;
    this.cursorTimer = setInterval(() => {
      this.showCursor = !this.showCursor;
    }, 500);
  },
  stopCursorBlink() {
    if (this.cursorTimer) clearInterval(this.cursorTimer);
    this.cursorTimer = null;
  },
  insert(text) {
    this.$app.$def.editor.before += String(text || '');
    this.showCursor = true;
    this.updateCodeDisplay();
  },
  remove() {
    const editor = this.$app.$def.editor;
    if (editor.before.length) editor.before = editor.before.slice(0, -1);
    this.showCursor = true;
    this.updateCodeDisplay();
  },
  moveToPoint(event) {
    const detail = event && event.detail ? event.detail : event || {};
    const x = Number(detail.offsetX || 0);
    const y = Number(detail.offsetY || 0);
    const target = moveCursorToPoint(this.source(), x, y, this.fontProfile, this.fontSize);
    this.$app.$def.editor.before = target.before;
    this.$app.$def.editor.after = target.after;
    this.showCursor = true;
    this.updateCodeDisplay();
    vibrate('short');
  },
  move(direction) {
    vibrate('short');
    const editor = this.$app.$def.editor;
    if (direction === 'left' && editor.before.length) {
      editor.after = editor.before.slice(-1) + editor.after;
      editor.before = editor.before.slice(0, -1);
    } else if (direction === 'right' && editor.after.length) {
      editor.before += editor.after.charAt(0);
      editor.after = editor.after.slice(1);
    } else if (direction === 'up' || direction === 'down') {
      const target = moveCursorVertically(editor.before, editor.after, direction === 'up' ? -1 : 1);
      if (target) {
        editor.before = target.before;
        editor.after = target.after;
      }
    }
    this.showCursor = true;
    this.updateCodeDisplay();
  },
  save() {
    if (this.saveInProgress) return Promise.resolve(false);
    vibrate('short');
    const source = this.source();
    this.saveInProgress = true;
    return jsManager.write(this.editorName, source, {
      token: this.lockToken
    }).then(() => {
      if (!this.pageActive) return false;
      this.saveInProgress = false;
      this.savedSource = source;
      this.$app.$def.updateEditorCode(source);
      showToast('代码已保存');
      return true;
    }).catch(error => {
      if (!this.pageActive) return false;
      this.saveInProgress = false;
      showToast(formatError(error, '保存脚本 ' + this.editorName));
      return false;
    });
  },
  run() {
    if (this.saveInProgress) return;
    vibrate('short');
    this.$app.$def.openRunner(this.editorName, this.source());
  },
  toggleKeyboard() {
    vibrate('short');
    this.hideInputMethod = !this.hideInputMethod;
    this.hideToolbar = !this.hideInputMethod;
    this.showCursorControls = false;
  },
  toggleCursorControls() {
    vibrate('short');
    this.showCursorControls = !this.showCursorControls;
  },
  onInputMethodDelete() {
    this.remove();
  },
  onInputMethodComplete(event) {
    if (event && event.detail && event.detail.content) this.insert(event.detail.content);
  },
  openSettings() {
    vibrate('short');
    push('settingsEditor');
  },
  hasUnsavedChanges() {
    return this.source() !== this.savedSource;
  },
  requestBack() {
    if (this.saveInProgress || this.backPromptOpen) return;
    if (!this.hasUnsavedChanges()) {
      this.releaseLock();
      navigateBack();
      return;
    }
    this.backPromptOpen = true;
    this.$app.$def.openDialog('confirm', {
      title: '保存修改？',
      message: "是否保存当前修改？",
      confirmText: "保存",
      secondaryText: "不保存",
      cancelText: "继续编辑"
    }, this).then(result => {
      if (result.action === "confirm") {
        this.backPromptOpen = false;
        this.save().then(saved => {
          if (saved) {
            this.releaseLock();
            navigateBack();
          }
        });
      }
      if (result.action === "secondary") {
        this.backPromptOpen = false;
        this.$app.$def.editor.before = '';
        this.$app.$def.editor.after = this.savedSource;
        this.releaseLock();
        navigateBack();
      }
      if (result.action === "cancel") {
        this.backPromptOpen = false;
      }
    }).catch(error => {
      this.backPromptOpen = false;
      showToast(error.message || "无法打开对话框");
    });
  },
  goBack() {
    vibrate('short');
    this.handleBack();
  },
  onBackPress() {
    this.handleBack();
    return true;
  },
  handleBack() {
    if (!this.hideInputMethod) {
      this.hideInputMethod = true;
      this.hideToolbar = false;
      return;
    }
    if (this.showCursorControls) {
      this.showCursorControls = false;
      return;
    }
    this.requestBack();
  }
};
</script>

<style>
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:84px 6px 78px; flex-direction:column; }
.code-document { position:relative; flex-shrink:0; min-height:280px; }
.code { color:#ffffff; flex-shrink:0; }
.cursor { position:absolute; background-color:#ffffff; }
.code-bottom-space { height:260px; flex-shrink:0; }
.button { position:absolute; width:72px; height:72px; }
.disabled-icon { background-color:#303030; border-radius:36px; }
.topbar { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.title-text { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:30px; font-weight:bold; color:#ffffff; text-align:center; }
.cursor-controls { position:absolute; left:6px; top:300px; width:324px; height:90px; border-radius:36px; background-color:#333333; flex-direction:row; justify-content:space-around; align-items:center; }
.cursor-button { width:72px; height:72px; }
</style>
