<import name="input-method" src="../../../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <text class="code">{{codeShow}}</text>
      <div class="code-bottom-space"></div>
    </scroll>

    <input-method if="{{!hideInputMethod}}" hide="{{hideInputMethod}}" initial-language="en" maxlength="5" vibratemode="short" @delete="onInputMethodDelete" @complete="onInputMethodComplete"></input-method>

    <div if="{{showCursorControls}}" class="cursor-controls">
      <img src="/common/images/up.png" class="cursor-button" @click="move('up')" />
      <img src="/common/images/left.png" class="cursor-button" @click="move('left')" />
      <img src="/common/images/right.png" class="cursor-button" @click="move('right')" />
      <img src="/common/images/down.png" class="cursor-button" @click="move('down')" />
    </div>

    <img if="{{!hideToolbar}}" class="button {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/save.png" style="left:6px;top:402px;" @click="save" />
    <img if="{{!hideToolbar}}" class="button {{saveInProgress ? 'disabled-icon' : ''}}" src="/common/images/run.png" style="left:90px;top:402px;" @click="run" />
    <img if="{{!hideToolbar}}" class="button" src="/common/images/move.png" style="left:174px;top:402px;" @click="toggleCursorControls" />
    <img if="{{!hideToolbar}}" class="button" src="/common/images/edit.png" style="left:258px;top:402px;" @click="toggleKeyboard" />

    <img static src="/common/images/hd.png" class="topbar" />
    <img static src="/common/images/back.png" class="button" style="left:6px;top:6px;" @click="goBack" />
    <img static if="{{hideInputMethod}}" src="/common/images/more.png" class="button" style="left:258px;top:6px;" @click="openSettings" />
    <img static if="{{!hideInputMethod}}" src="/common/images/down.png" class="button" style="left:258px;top:6px;" @click="toggleKeyboard" />
    <text class="time-text">{{nowTime}}</text>
    <marquee class="title-marquee" scrollamount="4" loop="-1">编辑JS · v0</marquee>
  </div>
</template>

<script>
import jsManager from '../../../../utils/files/jsManager.js';
import { back as navigateBack, push } from '../../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock } from '../../../../utils/core/time.js';
import { formatError } from '../../../../utils/core/userError.js';

export default {
  private: {
    nowTime: '00:00', timer: null, editorName: '', lockToken: null,
    codeShow: '┃', hideInputMethod: true, hideToolbar: false, showCursorControls: false,
    savedSource: '', saveInProgress: false, backPromptOpen: false
  },
  onInit() {
    this.nowTime = getCurrentClock();
    this.timer = setInterval(() => { this.nowTime = getCurrentClock(); }, 60000);
    this.activateSession();
  },
  onShow() { this.updateCodeDisplay(); },
  onDestroy() {
    if (this.timer) clearInterval(this.timer);
    this.releaseLock();
  },
  activateSession() {
    const editor = this.$app.$def.editor;
    this.editorName = editor.name;
    if (!this.editorName) { showToast('没有可编辑的文件'); navigateBack(); return; }
    this.lockToken = jsManager.lock(this.editorName);
    this.savedSource = this.source();
    this.updateCodeDisplay();
  },
  releaseLock() {
    if (this.lockToken && this.editorName) jsManager.unlock(this.editorName, this.lockToken);
    this.lockToken = null;
  },
  source() { return this.$app.$def.editor.before + this.$app.$def.editor.after; },
  updateCodeDisplay() {
    const editor = this.$app.$def.editor;
    editor.code = this.source();
    this.codeShow = editor.before + '┃' + editor.after;
  },
  insert(text) {
    this.$app.$def.editor.before += String(text || '');
    this.updateCodeDisplay();
  },
  remove() {
    const editor = this.$app.$def.editor;
    if (editor.before.length) editor.before = editor.before.slice(0, -1);
    this.updateCodeDisplay();
  },
  move(direction) {
    vibrate('short');
    const editor = this.$app.$def.editor;
    if (direction === 'left' && editor.before.length) {
      editor.after = editor.before.slice(-1) + editor.after;
      editor.before = editor.before.slice(0, -1);
    } else if (direction === 'right' && editor.after.length) {
      editor.before += editor.after.charAt(0);
      editor.after = editor.after.slice(1);
    } else if (direction === 'up' || direction === 'down') {
      this.moveVertical(direction === 'up' ? -1 : 1);
    }
    this.updateCodeDisplay();
  },
  moveVertical(direction) {
    const editor = this.$app.$def.editor;
    const source = this.source(); const lines = source.split('\n');
    const beforeLines = editor.before.split('\n'); const row = beforeLines.length - 1;
    const target = row + direction; if (target < 0 || target >= lines.length) return;
    const column = beforeLines[row].length;
    editor.before = lines.slice(0, target).join('\n') + (target ? '\n' : '') + lines[target].slice(0, Math.min(column, lines[target].length));
    editor.after = lines[target].slice(Math.min(column, lines[target].length)) + (target < lines.length - 1 ? '\n' + lines.slice(target + 1).join('\n') : '');
  },
  save() {
    if (this.saveInProgress) return Promise.resolve(false);
    vibrate('short');
    const source = this.source();
    this.saveInProgress = true;
    return jsManager.write(this.editorName, source, { token: this.lockToken }).then(() => {
      this.saveInProgress = false;
      this.savedSource = source;
      this.$app.$def.updateEditorCode(source); showToast('代码已保存');
      return true;
    }).catch((error) => {
      this.saveInProgress = false;
      showToast(formatError(error, '保存脚本 ' + this.editorName));
      return false;
    });
  },
  run() {
    if (this.saveInProgress) return;
    this.save().then((saved) => { if (saved) this.$app.$def.openRunner(this.editorName, this.source()); });
  },
  toggleKeyboard() { vibrate('short'); this.hideInputMethod = !this.hideInputMethod; this.hideToolbar = !this.hideInputMethod; this.showCursorControls = false; },
  toggleCursorControls() { vibrate('short'); this.showCursorControls = !this.showCursorControls; },
  onInputMethodDelete() { this.remove(); },
  onInputMethodComplete(event) { if (event && event.detail && event.detail.content) this.insert(event.detail.content); },
  openSettings() { vibrate('short'); push('settingsEditor'); },
  hasUnsavedChanges() { return this.source() !== this.savedSource; },
  requestBack() {
    if (this.saveInProgress || this.backPromptOpen) return;
    if (!this.hasUnsavedChanges()) { this.releaseLock(); navigateBack(); return; }
    this.backPromptOpen = true;
    const dialogId = this.$app.$def.openDialog('confirm', {
      title: '保存修改？', message: '确认：保存并返回\n拒绝：不保存并返回\n返回：继续编辑',
      callbacks: {
        onConfirm: () => { this.backPromptOpen = false; this.save().then((saved) => { if (saved) { this.releaseLock(); navigateBack(); } }); },
        onReject: () => { this.backPromptOpen = false; this.releaseLock(); navigateBack(); },
        onCancel: () => { this.backPromptOpen = false; }
      }
    });
    if (!dialogId) this.backPromptOpen = false;
  },
  goBack() { vibrate('short'); this.requestBack(); },
  onBackPress() { this.requestBack(); return true; }
};
</script>

<style>
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:102px 6px 78px; flex-direction:column; }
.code { width:324px; color:#ffffff; font-size:20px; line-height:24px; flex-shrink:0; }
.code-bottom-space { height:240px; flex-shrink:0; }
.button { position:absolute; width:72px; height:72px; }
.disabled-icon { background-color:#303030; border-radius:36px; }
.topbar { position:absolute; left:0px; top:0px; width:336px; height:102px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.title-text { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:30px; font-weight:bold; color:#ffffff; text-align:center; }
.title-marquee { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:30px; font-weight:bold; color:#ffffff; text-align:center; }
.cursor-controls { position:absolute; left:6px; top:300px; width:324px; height:90px; border-radius:36px; background-color:#333333; flex-direction:row; justify-content:space-around; align-items:center; }
.cursor-button { width:72px; height:72px; }
</style>
