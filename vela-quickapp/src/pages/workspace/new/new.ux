<import name="input-method" src="../../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="flex-direction: column;">

    <!-- 文件名、模板按创建流程排列。 -->
    <div class="field-group">
      <text class="label">文件名（自动补 .js）</text>
      <div class="input-box" @click="toggleKeyboard">
        <text class="input-text">{{fileName}}_</text>
      </div>
    </div>


    <div class="field-group">
      <text class="label">模板</text>
      <picker class="picker"
              type="text"
              selected="{{selectedTemplateIndex}}"
              range="{{templateOptions}}"
              @change="onTemplateChange">
      </picker>
    </div>

    <!-- 第三方输入法组件 -->
    <input-method
      if="{{!hideInputMethod}}"
      hide="{{hideInputMethod}}"
      initial-language="en"
      maxlength="5"
      vibratemode="{{vibrateMode}}"
      @delete="onInputMethodDelete"
      @complete="onInputMethodComplete"
    >
    </input-method>

    <img static src="/common/images/hd.png" class="header-img" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">新建脚本</text>
    <img static src="/common/images/back.png" class="btn" style="left: 6px;top: 6px;" @click="goBack" />
    <img if="{{hideInputMethod}}" src="/common/images/conform.png" class="btn {{busy ? 'disabled-icon' : ''}}" style="left: 258px;top: 6px;" @click="confirmAdd" />
    <img if="{{!hideInputMethod}}" static src="/common/images/down.png" class="btn" style="left: 258px;top: 6px;" @click="toggleKeyboard" />

  </div>
</template>

<script>
import { back as navigateBack, replace } from '../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { getTemplates } from '../../../data/scriptTemplates.js';
import { formatError } from '../../../utils/core/userError.js';

export default {
  private: {
    nowTime: "00:00",
    busy: false,
    pageActive: true,

    // 输入法相关
    hideInputMethod: true,
    vibrateMode: "short",

    // 文件相关
    fileName: "",
    selectedTemplateIndex: 0,
    templateOptions: []
  },

  updateTime() {
    this.nowTime = getCurrentClock();
  },

  onInit() {
    this.refreshTemplateOptions();
    this.updateTime();
  },

  onShow() { startPageClock(this); },
  onHide() { stopPageClock(this); },
  onDestroy(){
    stopPageClock(this);
      this.pageActive = false;
  },

  goBack(){
    vibrate('short');
    this.handleBack();
  },
  onBackPress() { this.handleBack(); return true; },
  handleBack() {
    if (!this.hideInputMethod) { this.hideInputMethod = true; return; }
    navigateBack();
  },

  toggleKeyboard() {
    vibrate('short');
    this.hideInputMethod = !this.hideInputMethod;
  },

  onInputMethodDelete() {
    if (this.fileName.length > 0) {
      this.fileName = this.fileName.slice(0, -1);
    }
  },
  onInputMethodComplete(evt) {
    if (evt && evt.detail && evt.detail.content) {
      const nextName = this.fileName + evt.detail.content;
      if (nextName.length > 128) { showToast('文件名过长'); return; }
      this.fileName = nextName;
    }
  },
  onTemplateChange(e) {
    this.selectedTemplateIndex = e.newSelected;
  },
  refreshTemplateOptions() {
    this.templateOptions = getTemplates().map(template => template.label);
  },
  getTemplateContent() {
    const templates = getTemplates();
    const selected = templates[this.selectedTemplateIndex] || templates[0];
    return selected ? selected.content : '';
  },
  confirmAdd() {
    if (this.busy) return;
    vibrate('short');
    if (!this.fileName || this.fileName.trim() === "") {
      showToast('请输入文件名');
      return;
    }
    let fileName = this.fileName.trim();
    if (!/\.js$/i.test(fileName)) fileName += '.js';
    const templateContent = this.getTemplateContent();
    this.busy = true;
    this.$app.$def.getScriptManager().list()
      .then((files) => {
        if (files.some(fileInfo => fileInfo.name === fileName)) {
          throw new Error('文件已存在，不会覆盖');
        }
        return this.$app.$def.getScriptManager().write(fileName, templateContent);
      })
      .then(() => {
        if (!this.pageActive) return;
        showToast(`文件 ${fileName} 创建成功`);
        this.$app.$def.openEditor(fileName, templateContent);
        replace('editor');
      })
      .catch(error => {
        if (!this.pageActive) return;
        console.error(`创建文件 ${fileName} 失败:`, error.message);
        showToast(formatError(error, '创建本地脚本 ' + fileName));
      }).then(() => { if (this.pageActive) this.busy = false; });
  }
};
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding-top: 84px;
  overflow: hidden;
}

/* 顶部 */
.header-img {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 84px;
}

.btn {
  position: absolute;
  width: 72px;
  height: 72px;
}

.disabled-icon {
  background-color: #303030;
  border-radius: 36px;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  font-weight: bold;
  font-size: 24px;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}

/* 创建流程字段 */
.field-group {
  width: 324px;
  margin-bottom: 10px;
  flex-direction: column;
  flex-shrink: 0;
}

.label {
  width: 324px;
  height: 30px;
  font-size: 22px;
  color: rgba(255,255,255,0.8);
  margin-bottom: 4px;
  font-weight: bold;
}

.input-box {
  width: 324px;
  height: 56px;
  background-color: #262626;
  border-radius: 36px;
  padding: 0 20px;
  justify-content: space-between;
  align-items: center;
}

.input-text {
  width: 284px;
  font-size: 24px;
  color: white;
}

.picker {
  width: 324px;
  height: 56px;
  background-color: #262626;
  border-radius: 36px;
  padding: 0 20px;
}

</style>
