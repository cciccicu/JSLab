<template>
  <div class="page">
    <scroll id="ui-scroll" class="content" scroll-y="true" bounces="true" onscroll="onUiScroll">
      <div class="content-inner" style="height: {{layoutHeight}}px;">
        <div if="{{uiNodes.length === 0}}" class="empty-card" style="top: {{contentTopPadding}}px;">
          <text class="empty-title">{{emptyTitle}}</text>
          <text class="empty-detail">{{emptyDetail}}</text>
        </div>
        <div for="{{node in uiNodes}}" tid="id" class="node-wrap" style="left: {{node.x}}px; top: {{node.y}}px; width: {{node.width}}px; height: {{node.height}}px; background-color: {{node.background}}; border-radius: {{node.radius}}px;">
          <text if="{{node.kind === 'heading' || node.kind === 'text'}}" class="ui-text" style="color: {{node.color}}; font-size: {{node.size}}px; line-height: {{node.lineHeight}}px; font-weight: {{node.bold}}; text-align: {{node.align}}; lines: {{node.lines}};">{{node.text}}</text>
          <div elif="{{node.kind === 'button'}}" class="ui-button" @click="onButtonPress(node.id)">
            <text class="ui-text" style="color: {{node.color}}; font-size: {{node.size}}px; line-height: {{node.lineHeight}}px; lines: {{node.lines}}; font-weight: bold; text-align: center;">{{node.text}}</text>
          </div>
          <div elif="{{node.kind === 'switch'}}" class="control-card">
            <div class="control-copy" style="width: {{node.copyWidth}}px;">
              <text class="control-label" style="color: {{node.color}};">{{node.text}}</text>
              <text if="{{node.detail}}" class="control-detail" style="color: {{node.detailColor}};">{{node.detail}}</text>
            </div>
            <switch class="ui-switch" checked="{{node.checked}}" style="track-color: {{node.accent}}; thumb-color: {{node.thumbColor}};" @change="onSwitchChange(node.id)"></switch>
          </div>
          <div elif="{{node.kind === 'slider'}}" class="value-card">
            <div class="value-header">
              <text class="value-label" style="color: {{node.color}};">{{node.text}}</text>
              <text class="value-text" style="color: {{node.accent}};">{{node.value}}</text>
            </div>
            <slider class="ui-slider" min="{{node.min}}" max="{{node.max}}" step="{{node.step}}" value="{{node.value}}" style="color: {{node.trackColor}}; selected-color: {{node.accent}}; block-color: {{node.thumbColor}};" onchange="onSliderChange(node.id)"></slider>
          </div>
          <div elif="{{node.kind === 'progress'}}" class="value-card">
            <div class="value-header">
              <text class="value-label" style="color: {{node.color}};">{{node.text}}</text>
              <text class="value-text" style="color: {{node.accent}};">{{node.percent}}%</text>
            </div>
            <progress class="ui-progress" percent="{{node.percent}}" style="color: {{node.accent}}; layer-color: {{node.trackColor}};"></progress>
          </div>
          <qrcode elif="{{node.kind === 'qrcode'}}" value="{{node.value}}" style="width: {{node.qrSize}}px; height: {{node.qrSize}}px; color: {{node.color}}; background-color: {{node.background}};"></qrcode>
        </div>
        <div if="{{error}}" class="error-card" style="top: {{errorTop}}px;">
          <text class="error-title">运行错误</text>
          <text class="error-text">{{error}}</text>
        </div>
      </div>
    </scroll>
    <div if="{{canScroll}}" class="scroll-track" style="top: {{scrollTrackTop}}px; height: {{scrollTrackHeight}}px;"></div>
    <div if="{{canScroll}}" class="scroll-thumb" style="top: {{scrollThumbTop}}px; height: {{scrollThumbHeight}}px;"></div>
    <img if="{{showTopBar}}" static src="/common/images/hd.png" class="topbar-bg" />
    <img if="{{showTopBar}}" static src="/common/images/back.png" class="btn btn-left-top" @click="onBack" />
    <text if="{{showTopBar}}" class="time-text">{{nowTime}}</text>
    <text if="{{showTopBar && pageTitle.length <= 5}}" class="title-text">{{pageTitle}}</text>
    <marquee if="{{showTopBar && pageTitle.length > 5}}" class="title-marquee" scrollamount="4" loop="-1">{{pageTitle}}</marquee>
  </div>
</template>

<script>
import { back as navigateBack } from '../../../utils/core/routeManager.js';
import { vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock } from '../../../utils/core/time.js';
import { getPageElement, scheduleAfterRender } from '../../../utils/core/runtimeCompat.js';
import { createScriptRuntimeApi } from '../../../utils/runtime/scriptRuntimeApi.js';
import { createUiSession } from '../../../utils/runtime/uiRuntime.js';

// Sessions contain user functions; keep them outside Vela's reactive ViewModel.
const sessions = new WeakMap();

export default {
  private: {
    nowTime: '00:00', timer: null, pageTitle: 'UI 应用', showTopBar: true,
    contentTopPadding: 102, uiNodes: [], emptyTitle: '等待界面',
    emptyDetail: '脚本尚未调用 ui.render()', error: '', destroyed: false,
    layoutHeight: 480, contentEnd: 102, errorTop: 102, scrollY: 0,
    scrollThumbTop: 106, scrollThumbHeight: 0, scrollTrackTop: 106,
    scrollTrackHeight: 360, canScroll: false,
    pendingScrollTarget: null, scrollScheduled: false
  },
  onInit() {
    this.destroyed = false;
    this.updateTime();
    this.timer = setInterval(() => this.updateTime(), 60000);
    const editor = this.$app.$def.editor;
    const code = editor.code || editor.before + editor.after;
    editor.code = '';
    this.runCode(code);
  },
  onDestroy() {
    this.cancelRun();
    this.destroyed = true;
    if (this.timer) clearInterval(this.timer);
    this.timer = null;
    this.uiNodes = [];
  },
  updateTime() { this.nowTime = getCurrentClock(); },
  onBack() { vibrate('short'); this.cancelRun(); navigateBack(); },
  cancelRun() {
    const session = sessions.get(this);
    if (session) session.dispose();
    sessions.delete(this);
  },
  publishUi(nodes, height, end, changed) {
    if (this.destroyed) return;
    if (changed) {
      // Keep unchanged native nodes (especially QR codes) and avoid replacing
      // the list when topology is stable. Splice is observable on Vela arrays.
      const stable = nodes.length === this.uiNodes.length && nodes.every((node, i) => node.id === this.uiNodes[i].id && node.kind === this.uiNodes[i].kind);
      if (stable) nodes.forEach((node, i) => { if (node !== this.uiNodes[i]) this.uiNodes.splice(i, 1, node); });
      else this.uiNodes = nodes;
    }
    this.error = '';
    this.contentEnd = end;
    this.emptyDetail = '脚本尚未提供可显示组件';
    if (height !== this.layoutHeight) {
      this.layoutHeight = height;
      // Native scrolling clamps automatically when content shrinks.
      this.scrollY = Math.min(this.scrollY, Math.max(0, height - 480));
      this.updateScrollThumb();
    }
    if (this.pendingScrollTarget !== null) this.scheduleScroll();
  },
  setTopBarVisible(visible) {
    if (visible === this.showTopBar) return false;
    this.showTopBar = visible;
    this.contentTopPadding = visible ? 102 : 12;
    this.scrollTrackTop = visible ? 106 : 12;
    this.scrollTrackHeight = visible ? 360 : 456;
    this.updateScrollThumb();
    return true;
  },
  onUiScroll(eventData) {
    const value = eventData && typeof eventData.scrollY !== 'undefined'
      ? eventData.scrollY : eventData && eventData.detail ? eventData.detail.scrollY : 0;
    this.scrollY = Math.max(0, Number(value) || 0);
    this.updateScrollThumb();
  },
  updateScrollThumb() {
    this.canScroll = this.layoutHeight > 484;
    if (!this.canScroll) { this.scrollThumbHeight = 0; return; }
    const thumb = Math.max(32, Math.round(this.scrollTrackHeight * 480 / this.layoutHeight));
    const ratio = Math.min(1, this.scrollY / Math.max(1, this.layoutHeight - 480));
    this.scrollThumbHeight = thumb;
    this.scrollThumbTop = this.scrollTrackTop + Math.round((this.scrollTrackHeight - thumb) * ratio);
  },
  requestScroll(position) { this.pendingScrollTarget = position; this.scheduleScroll(); },
  scheduleScroll() {
    if (this.scrollScheduled) return;
    this.scrollScheduled = true;
    scheduleAfterRender(this, () => {
      this.scrollScheduled = false;
      if (this.destroyed || this.pendingScrollTarget === null) return;
      const element = getPageElement(this, 'ui-scroll');
      if (!element || typeof element.scrollTo !== 'function') return;
      const target = this.pendingScrollTarget;
      const top = target === 'bottom' ? this.layoutHeight - 480 : target === 'top' ? 0 : Number(target) || 0;
      this.pendingScrollTarget = null;
      element.scrollTo({ top: Math.min(Math.max(0, top), this.layoutHeight - 480), left: 0, behavior: 'smooth' });
    });
  },
  onButtonPress(id) {
    const session = sessions.get(this);
    if (session && session.invoke(id)) vibrate('short');
  },
  onSwitchChange(id, eventData) {
    const checked = eventData && typeof eventData.checked !== 'undefined' ? eventData.checked : !!(eventData && eventData.detail && eventData.detail.checked);
    const session = sessions.get(this);
    if (session) session.invoke(id, checked);
  },
  onSliderChange(id, eventData) {
    const data = eventData && eventData.detail ? eventData.detail : eventData;
    if (data && data.isFromUser === false) return;
    const session = sessions.get(this);
    if (session) session.invoke(id, Number(data && data.progress) || 0);
  },
  showRuntimeError(error) {
    if (this.destroyed) return;
    this.error = ((error && error.name ? error.name + ': ' : '') + (error && error.message ? error.message : String(error))).slice(0, 512);
    this.errorTop = this.uiNodes.length ? this.contentEnd : this.contentTopPadding + 140;
    this.layoutHeight = Math.max(480, this.errorTop + 64 + Math.ceil(this.error.length / 12) * 30);
    this.updateScrollThumb();
    this.requestScroll('bottom');
  },
  runCode(code) {
    this.cancelRun();
    if (!String(code || '').trim()) { this.emptyTitle = '没有代码'; this.emptyDetail = '返回编辑器添加 UI 脚本'; return; }
    const session = createUiSession({
      top: () => this.contentTopPadding,
      title: value => { this.pageTitle = value; },
      header: value => this.setTopBarVisible(value),
      scroll: value => this.requestScroll(value),
      publish: (nodes, height, end, changed) => this.publishUi(nodes, height, end, changed),
      error: error => this.showRuntimeError(error)
    });
    sessions.set(this, session);
    const runtime = createScriptRuntimeApi(this.$app.$def, {
      name: this.$app.$def.editor.name || 'untitled.ui.js', mode: 'ui',
      isActive: () => sessions.get(this) === session && !this.destroyed,
      exit: () => this.onBack()
    });
    try {
      const userFunction = new Function('system', 'ui', 'dialog', 'script', code);
      setTimeout(() => {
        if (sessions.get(this) !== session || this.destroyed) return;
        try { userFunction(runtime.system, session.ui, runtime.dialog, runtime.script); }
        catch (error) { this.showRuntimeError(error); }
      }, 0);
    } catch (error) { this.showRuntimeError(error); }
  }
};
</script>

<style>
.page { width:336px; height:480px; overflow:hidden; background-color:#000000; }
.content { width:336px; height:480px; flex-direction:column; }
.content-inner { width:336px; flex-shrink:0; }
.node-wrap { position:absolute; flex-direction:column; justify-content:center; align-items:center; overflow:hidden; }
.ui-text { width:100%; flex-shrink:0; text-overflow:ellipsis; }
.ui-button { width:100%; height:100%; padding:0px 8px; justify-content:center; align-items:center; }
.control-card { width:100%; height:100%; padding:12px 16px; flex-direction:row; align-items:center; }
.control-copy { flex-direction:column; }
.control-label { width:100%; font-size:23px; line-height:28px; font-weight:bold; lines:1; text-overflow:ellipsis; }
.control-detail { width:100%; font-size:20px; line-height:26px; lines:2; text-overflow:ellipsis; }
.ui-switch { width:68px; margin-left:8px; }
.value-card { width:100%; height:100%; padding:12px 16px; flex-direction:column; justify-content:center; }
.value-header { width:100%; flex-direction:row; align-items:center; }
.value-label { flex:1; font-size:23px; line-height:28px; font-weight:bold; lines:1; text-overflow:ellipsis; }
.value-text { font-size:21px; line-height:28px; font-weight:bold; margin-left:6px; }
.ui-slider { width:100%; margin-top:8px; padding-left:0px; padding-right:0px; }
.ui-progress { width:100%; margin-top:12px; stroke-width:12px; }
.empty-card, .error-card { position:absolute; left:6px; width:324px; padding:16px 18px; border-radius:32px; background-color:#24262a; flex-direction:column; }
.empty-title, .error-title { color:#ffffff; font-size:28px; line-height:36px; font-weight:bold; }
.empty-detail { color:#999999; font-size:20px; line-height:28px; margin-top:6px; }
.error-card { background-color:#3a2020; }
.error-title, .error-text { color:#f48771; }
.error-text { font-size:22px; line-height:30px; margin-top:8px; }
.scroll-track { position:absolute; right:3px; width:4px; border-radius:2px; background-color:#202020; }
.scroll-thumb { position:absolute; right:3px; width:4px; border-radius:2px; background-color:#a6a6a6; }
.topbar-bg { position:absolute; left:0px; top:0px; width:336px; height:102px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; color:#999999; font-size:24px; font-weight:bold; text-align:center; }
.title-text, .title-marquee { position:absolute; left:78px; top:35px; width:180px; line-height:42px; color:#ffffff; font-size:30px; font-weight:bold; text-align:center; }
.btn { position:absolute; width:72px; height:72px; }
.btn-left-top { left:6px; top:6px; }
</style>
