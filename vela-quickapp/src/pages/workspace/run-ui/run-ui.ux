<template>
  <div class="page">
    <scroll id="ui-scroll" class="content" scroll-y="true" bounces="true" onscroll="onUiScroll">
      <div class="content-inner" style="height: {{layoutHeight}}px; padding-top: {{contentTopPadding}}px;">
        <div if="{{uiNodes.length === 0}}" class="empty-card">
          <text class="empty-title">{{emptyTitle}}</text>
          <text class="empty-detail">{{emptyDetail}}</text>
        </div>

        <div for="{{node in uiNodes}}" tid="id" class="node-wrap">
          <text if="{{node.kind === 'heading'}}" class="ui-heading" style="color: {{node.color}}; font-size: {{node.size}}px; text-align: {{node.align}};">{{node.text}}</text>
          <text if="{{node.kind === 'text'}}" class="ui-text" style="color: {{node.color}}; font-size: {{node.size}}px; text-align: {{node.align}};">{{node.text}}</text>

          <div if="{{node.kind === 'button'}}" class="{{node.className}}" @click="onButtonPress(node.id)">
            <text class="ui-button-text">{{node.text}}</text>
          </div>

          <div if="{{node.kind === 'switch'}}" class="control-card">
            <div class="control-copy">
              <text class="control-label">{{node.text}}</text>
              <text if="{{node.detail}}" class="control-detail">{{node.detail}}</text>
            </div>
            <switch class="ui-switch" checked="{{node.checked}}" @change="onSwitchChange(node.id)"></switch>
          </div>

          <div if="{{node.kind === 'slider'}}" class="slider-card">
            <div class="slider-header">
              <text class="control-label">{{node.text}}</text>
              <text class="slider-value">{{node.value}}</text>
            </div>
            <slider class="ui-slider" min="{{node.min}}" max="{{node.max}}" step="{{node.step}}" value="{{node.value}}" onchange="onSliderChange(node.id)"></slider>
          </div>

          <div if="{{node.kind === 'progress'}}" class="progress-card">
            <div class="slider-header">
              <text class="control-label">{{node.text}}</text>
              <text class="slider-value">{{node.percent}}%</text>
            </div>
            <progress class="ui-progress" percent="{{node.percent}}" style="color: {{node.color}};"></progress>
          </div>

          <div if="{{node.kind === 'grid'}}" class="ui-grid">
            <div for="{{row in node.rows}}" tid="id" class="ui-grid-row">
              <div for="{{cell in row.cells}}" tid="id" class="{{cell.className}}" style="height: {{node.cellHeight}}px;">
                <text class="ui-grid-text" style="color: {{cell.color}}; font-size: {{cell.size}}px;">{{cell.text}}</text>
              </div>
            </div>
          </div>

          <div if="{{node.kind === 'buttonRow'}}" class="ui-button-row">
            <div for="{{button in node.buttons}}" tid="id" class="{{button.className}}" @click="onButtonPress(button.id)">
              <text class="ui-mini-button-text">{{button.text}}</text>
            </div>
          </div>

          <div if="{{node.kind === 'divider'}}" class="ui-divider"></div>
          <div if="{{node.kind === 'spacer'}}" style="height: {{node.size}}px;"></div>
        </div>

        <div if="{{error}}" class="error-card">
          <text class="error-title">运行错误</text>
          <text class="error-text">{{error}}</text>
        </div>
      </div>
    </scroll>

    <div if="{{canScroll}}" class="scroll-track" style="top: {{scrollTrackTop}}px; height: {{scrollTrackHeight}}px;"></div>
    <div if="{{canScroll}}" class="scroll-thumb" style="top: {{scrollThumbTop}}px; height: {{scrollThumbHeight}}px;"></div>

    <img if="{{showTopBar}}" static src="/common/images/hd.png" class="topbar-bg" />
    <img if="{{showTopBar}}" static src="/common/images/back.png" class="btn btn-left-top" @click="onBack" />
    <text if="{{showTopBar}}" class="time-text">{{nowTime}}</text>
    <text if="{{showTopBar && pageTitle.length <= 5}}" class="title-text">{{pageTitle}}</text>
    <marquee if="{{showTopBar && pageTitle.length > 5}}" class="title-marquee" scrollamount="4" loop="-1">{{pageTitle}}</marquee>
  </div>
</template>

<script>
import { back as navigateBack } from '../../../utils/core/routeManager.js';
import { vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock } from '../../../utils/core/time.js';
import { getPageElement, scheduleAfterRender } from '../../../utils/core/runtimeCompat.js';
import { createScriptRuntimeApi } from '../../../utils/runtime/scriptRuntimeApi.js';

const MAX_UI_NODES = 40;
const MAX_TEXT_LENGTH = 1024;

function clamp(value, min, max, fallback) {
  const number = Number(value);
  if (isNaN(number)) return fallback;
  return Math.min(max, Math.max(min, number));
}

function safeText(value) {
  return String(value == null ? '' : value).slice(0, MAX_TEXT_LENGTH);
}

function safeColor(value, fallback) {
  const color = String(value || '');
  return /^(#[0-9a-fA-F]{6}|rgba?\([0-9.,\s]+\))$/.test(color) ? color : fallback;
}

function makeNode(kind, props) {
  return Object.assign({ kind }, props || {});
}

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    code: '',
    pageTitle: 'UI 应用',
    showTopBar: true,
    contentTopPadding: 102,
    uiNodes: [],
    emptyTitle: '等待界面',
    emptyDetail: '脚本尚未调用 ui.render()',
    error: '',
    isRunning: false,
    runId: 0,
    destroyed: false,
    renderSource: null,
    eventHandlers: null,
    layoutHeight: 480,
    scrollY: 0,
    scrollContentHeight: 480,
    scrollThumbTop: 106,
    scrollThumbHeight: 0,
    scrollTrackTop: 106,
    scrollTrackHeight: 360,
    canScroll: false,
    pendingScrollTarget: null
  },

  onInit() {
    this.destroyed = false;
    this.eventHandlers = {};
    this.updateTime();
    this.timer = setInterval(() => this.updateTime(), 60000);
    const editor = this.$app.$def.editor;
    this.code = editor.code || editor.before + editor.after;
    editor.code = '';
    this.runCode();
  },

  onDestroy() {
    this.cancelRun();
    this.destroyed = true;
    if (this.timer) clearInterval(this.timer);
    this.timer = null;
    this.code = '';
    this.uiNodes = [];
    this.renderSource = null;
    this.eventHandlers = {};
    this.pendingScrollTarget = null;
  },

  updateTime() {
    this.nowTime = getCurrentClock();
  },

  onBack() {
    vibrate('short');
    this.cancelRun();
    navigateBack();
  },

  cancelRun() {
    this.runId += 1;
    this.isRunning = false;
    this.renderSource = null;
    this.eventHandlers = {};
  },

  createUiApi(runId) {
    const page = this;
    const ui = {
      version: 1,
      render(view) {
        if (!page.isRunActive(runId)) return;
        page.renderSource = view;
        page.renderUi(runId);
      },
      refresh() {
        if (page.isRunActive(runId)) page.renderUi(runId);
      },
      setTitle(title) {
        if (page.isRunActive(runId)) page.pageTitle = safeText(title).slice(0, 10) || 'UI 应用';
      },
      showHeader(visible) {
        if (page.isRunActive(runId)) page.setTopBarVisible(visible !== false);
      },
      heading(text, options) {
        return makeNode('heading', Object.assign({ text }, options || {}));
      },
      text(text, options) {
        return makeNode('text', Object.assign({ text }, options || {}));
      },
      button(text, onPress, options) {
        return makeNode('button', Object.assign({ text, onPress }, options || {}));
      },
      switch(text, checked, onChange, options) {
        return makeNode('switch', Object.assign({ text, checked, onChange }, options || {}));
      },
      slider(text, value, onChange, options) {
        return makeNode('slider', Object.assign({ text, value, onChange }, options || {}));
      },
      progress(text, percent, options) {
        return makeNode('progress', Object.assign({ text, percent }, options || {}));
      },
      grid(items, options) {
        return makeNode('grid', Object.assign({ items }, options || {}));
      },
      buttonRow(buttons, options) {
        return makeNode('buttonRow', Object.assign({ buttons }, options || {}));
      },
      divider() {
        return makeNode('divider');
      },
      spacer(size) {
        return makeNode('spacer', { size });
      },
      signal(initialValue) {
        let value = initialValue;
        return {
          get() { return value; },
          set(nextValue) {
            value = nextValue;
            ui.refresh();
            return value;
          },
          update(updater) {
            value = typeof updater === 'function' ? updater(value) : updater;
            ui.refresh();
            return value;
          }
        };
      },
      scrollTo(position) {
        if (page.isRunActive(runId)) page.requestScroll(position);
      },
      scrollTop() {
        if (page.isRunActive(runId)) page.requestScroll('top');
      },
      scrollBottom() {
        if (page.isRunActive(runId)) page.requestScroll('bottom');
      }
    };
    return ui;
  },

  isRunActive(runId) {
    return !this.destroyed && this.isRunning && runId === this.runId;
  },

  renderUi(runId) {
    if (!this.isRunActive(runId)) return;
    let source;
    try {
      source = typeof this.renderSource === 'function' ? this.renderSource() : this.renderSource;
      const rawNodes = Array.isArray(source) ? source : source ? [source] : [];
      const handlers = {};
      const usedIds = {};
      this.uiNodes = rawNodes.slice(0, MAX_UI_NODES).map((node, index) => {
        const raw = node && typeof node === 'object' ? node : { kind: 'text', text: node };
        const requestedId = safeText(raw.id || 'ui-node-' + index).slice(0, 56) || 'ui-node-' + index;
        const id = usedIds[requestedId] ? requestedId + '-' + index : requestedId;
        usedIds[id] = true;
        const kind = ['heading', 'text', 'button', 'switch', 'slider', 'progress', 'grid', 'buttonRow', 'divider', 'spacer'].indexOf(raw.kind) !== -1
          ? raw.kind
          : 'text';
        if (kind === 'grid') {
          const columns = Math.round(clamp(raw.columns, 2, 4, 4));
          const items = Array.isArray(raw.items) ? raw.items.slice(0, columns * 9) : [];
          const rows = [];
          for (let rowIndex = 0; rowIndex < Math.ceil(items.length / columns); rowIndex += 1) {
            const cells = [];
            for (let columnIndex = 0; columnIndex < columns; columnIndex += 1) {
              const itemIndex = rowIndex * columns + columnIndex;
              if (itemIndex >= items.length) break;
              const item = items[itemIndex] && typeof items[itemIndex] === 'object'
                ? items[itemIndex]
                : { text: items[itemIndex] };
              const cellTone = ['primary', 'success', 'warning', 'danger'].indexOf(item.tone) !== -1
                ? item.tone
                : 'neutral';
              cells.push({
                id: id + '-cell-' + itemIndex,
                text: safeText(item.text).slice(0, 8),
                color: safeColor(item.color, '#ffffff'),
                size: clamp(item.size, 16, 30, 24),
                className: 'ui-grid-cell ui-grid-cell-' + columns + ' ui-grid-cell-' + cellTone
              });
            }
            rows.push({ id: id + '-row-' + rowIndex, cells });
          }
          return {
            id,
            kind,
            rows,
            cellHeight: clamp(raw.cellHeight, 44, 72, 52)
          };
        }
        if (kind === 'buttonRow') {
          const sourceButtons = Array.isArray(raw.buttons) ? raw.buttons.slice(0, 4) : [];
          const buttonCount = Math.max(1, sourceButtons.length);
          const buttons = sourceButtons.map((button, buttonIndex) => {
            const item = button && typeof button === 'object' ? button : { text: button };
            const buttonId = id + '-button-' + buttonIndex;
            if (typeof item.onPress === 'function') {
              handlers[buttonId] = { type: 'press', callback: item.onPress };
            }
            const buttonTone = item.tone === 'danger'
              ? 'danger'
              : item.tone === 'neutral' ? 'neutral' : 'primary';
            return {
              id: buttonId,
              text: safeText(item.text).slice(0, 8),
              className: 'ui-mini-button ui-mini-button-' + buttonCount + ' ui-button-' + buttonTone
            };
          });
          return { id, kind, buttons };
        }
        if (typeof raw.onPress === 'function') handlers[id] = { type: 'press', callback: raw.onPress };
        if (typeof raw.onChange === 'function') handlers[id] = { type: 'change', callback: raw.onChange };
        const tone = raw.tone === 'danger' ? 'danger' : raw.tone === 'neutral' ? 'neutral' : 'primary';
        const min = clamp(raw.min, -100000, 100000, 0);
        const max = Math.max(min, clamp(raw.max, -100000, 100000, 100));
        return {
          id,
          kind,
          text: safeText(raw.text),
          detail: safeText(raw.detail),
          color: safeColor(raw.color, kind === 'progress' ? '#0d6eff' : '#ffffff'),
          size: kind === 'spacer'
            ? clamp(raw.size, 0, 96, 12)
            : clamp(raw.size, 16, 36, kind === 'heading' ? 30 : 24),
          align: ['left', 'center', 'right'].indexOf(raw.align) !== -1 ? raw.align : 'left',
          className: 'ui-button ui-button-' + tone,
          checked: !!raw.checked,
          value: clamp(raw.value, min, max, min),
          min,
          max,
          step: clamp(raw.step, 0.01, 100000, 1),
          percent: Math.round(clamp(raw.percent, 0, 100, 0))
        };
      });
      this.eventHandlers = handlers;
      this.error = '';
      this.emptyTitle = '等待界面';
      this.emptyDetail = '脚本尚未提供可显示组件';
      this.layoutHeight = this.calculateLayoutHeight(this.uiNodes);
      this.scrollContentHeight = this.layoutHeight;
      this.canScroll = this.layoutHeight > 484;
      this.updateScrollThumb();
      this.scheduleAfterRender(() => this.updateScrollMetrics());
    } catch (error) {
      this.showRuntimeError(error);
    }
  },

  calculateLayoutHeight(nodes) {
    let height = this.contentTopPadding + 24;
    nodes.forEach((node) => {
      switch (node.kind) {
        case 'heading': {
          const charsPerLine = Math.max(7, Math.floor(288 / Math.max(16, node.size)));
          height += Math.max(1, Math.ceil(node.text.length / charsPerLine)) * 40 + 10;
          break;
        }
        case 'text': {
          const charsPerLine = Math.max(8, Math.floor(288 / Math.max(16, node.size)));
          height += Math.max(1, Math.ceil(node.text.length / charsPerLine)) * 32 + 10;
          break;
        }
        case 'button':
          height += 74;
          break;
        case 'switch':
          height += node.detail ? 94 : 76;
          break;
        case 'slider':
          height += 100;
          break;
        case 'progress':
          height += 90;
          break;
        case 'grid':
          height += node.rows.length * (node.cellHeight + 6) + 4;
          break;
        case 'buttonRow':
          height += 66;
          break;
        case 'divider':
          height += 20;
          break;
        case 'spacer':
          height += node.size;
          break;
      }
    });
    if (this.error) height += 110;
    return Math.max(480, Math.ceil(height));
  },

  setTopBarVisible(visible) {
    this.showTopBar = !!visible;
    this.contentTopPadding = this.showTopBar ? 102 : 12;
    this.scrollTrackTop = this.showTopBar ? 106 : 12;
    this.scrollTrackHeight = this.showTopBar ? 360 : 456;
    this.layoutHeight = this.calculateLayoutHeight(this.uiNodes);
    this.scrollContentHeight = this.layoutHeight;
    this.canScroll = this.layoutHeight > 484;
    this.updateScrollThumb();
    this.scheduleAfterRender(() => this.updateScrollMetrics());
  },

  scheduleAfterRender(callback) {
    scheduleAfterRender(this, callback);
  },

  onUiScroll(eventData) {
    const value = eventData && typeof eventData.scrollY !== 'undefined'
      ? eventData.scrollY
      : eventData && eventData.detail ? eventData.detail.scrollY : 0;
    this.scrollY = Math.max(0, Number(value) || 0);
    this.updateScrollThumb();
  },

  updateScrollMetrics() {
    if (this.destroyed) return;
    const element = getPageElement(this, 'ui-scroll');
    if (!element || typeof element.getScrollRect !== 'function') return;
    element.getScrollRect({
      success: (rect) => {
        if (this.destroyed) return;
        this.scrollContentHeight = Math.max(this.layoutHeight, Number(rect && rect.height) || 480);
        this.canScroll = this.scrollContentHeight > 484;
        this.updateScrollThumb();
        this.applyPendingScroll();
      }
    });
  },

  updateScrollThumb() {
    const trackHeight = this.scrollTrackHeight;
    const viewportHeight = 480;
    if (!this.canScroll) {
      this.scrollThumbHeight = 0;
      this.scrollThumbTop = this.scrollTrackTop;
      return;
    }
    const thumbHeight = Math.max(32, Math.round(trackHeight * viewportHeight / this.scrollContentHeight));
    const maxScroll = Math.max(1, this.scrollContentHeight - viewportHeight);
    const ratio = Math.min(1, this.scrollY / maxScroll);
    this.scrollThumbHeight = thumbHeight;
    this.scrollThumbTop = this.scrollTrackTop + Math.round((trackHeight - thumbHeight) * ratio);
  },

  requestScroll(position) {
    this.pendingScrollTarget = position;
    this.scheduleAfterRender(() => this.updateScrollMetrics());
  },

  applyPendingScroll() {
    if (this.pendingScrollTarget === null || this.destroyed) return;
    const element = getPageElement(this, 'ui-scroll');
    if (!element || typeof element.scrollTo !== 'function') return;
    let top;
    if (this.pendingScrollTarget === 'bottom') {
      top = Math.max(0, this.scrollContentHeight - 480);
    } else if (this.pendingScrollTarget === 'top') {
      top = 0;
    } else {
      top = Math.max(0, Number(this.pendingScrollTarget) || 0);
    }
    this.pendingScrollTarget = null;
    element.scrollTo({ top, left: 0, behavior: 'smooth' });
  },

  invokeHandler(id, value) {
    if (!this.isRunning) return;
    const entry = this.eventHandlers[id];
    if (!entry || typeof entry.callback !== 'function') return;
    try {
      entry.callback(value);
    } catch (error) {
      this.showRuntimeError(error);
    }
  },

  onButtonPress(id) {
    vibrate('short');
    this.invokeHandler(id);
  },

  onSwitchChange(id, eventData) {
    const checked = eventData && typeof eventData.checked !== 'undefined'
      ? eventData.checked
      : !!(eventData && eventData.detail && eventData.detail.checked);
    this.invokeHandler(id, checked);
  },

  onSliderChange(id, eventData) {
    const progressValue = eventData && typeof eventData.progress !== 'undefined'
      ? eventData.progress
      : eventData && eventData.detail ? eventData.detail.progress : 0;
    this.invokeHandler(id, Number(progressValue));
  },

  showRuntimeError(error) {
    if (this.destroyed) return;
    this.error = (error && error.name ? error.name + ': ' : '') + (error && error.message ? error.message : String(error));
    this.layoutHeight = Math.max(this.showTopBar ? 590 : 500, this.calculateLayoutHeight(this.uiNodes));
    this.scheduleAfterRender(() => this.updateScrollMetrics());
  },

  runCode() {
    this.cancelRun();
    const runId = this.runId;
    this.isRunning = true;
    this.pageTitle = 'UI 应用';
    this.showTopBar = true;
    this.contentTopPadding = 102;
    this.scrollTrackTop = 106;
    this.scrollTrackHeight = 360;
    this.uiNodes = [];
    this.error = '';
    this.emptyTitle = '等待界面';
    this.emptyDetail = '脚本尚未调用 ui.render()';
    this.eventHandlers = {};
    this.layoutHeight = 480;
    this.scrollY = 0;
    this.pendingScrollTarget = 'top';

    if (!this.code.trim()) {
      this.isRunning = false;
      this.emptyTitle = '没有代码';
      this.emptyDetail = '返回编辑器添加 UI 脚本';
      return;
    }

    const ui = this.createUiApi(runId);
    const runtime = createScriptRuntimeApi(this.$app.$def, {
      name: this.$app.$def.editor.name || 'untitled.ui.js',
      mode: 'ui',
      isActive: () => this.isRunActive(runId),
      exit: () => this.onBack()
    });
    const exposedModules = {
      system: runtime.system,
      ui, dialog: runtime.dialog, script: runtime.script,
    };

    try {
      const userFunction = new Function(...Object.keys(exposedModules), this.code);
      setTimeout(() => {
        if (!this.isRunActive(runId)) return;
        try {
          userFunction(...Object.values(exposedModules));
        } catch (error) {
          this.showRuntimeError(error);
        }
      }, 0);
    } catch (error) {
      this.isRunning = false;
      this.showRuntimeError(error);
      this.emptyTitle = '编译失败';
      this.emptyDetail = '返回编辑器后重新运行';
    }
  }
};
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  overflow: hidden;
  background-color: #000000;
}

.content {
  width: 336px;
  height: 480px;
}

.content-inner {
  width: 336px;
  flex-direction: column;
  padding: 102px 6px 84px;
  flex-shrink: 0;
}

.node-wrap {
  width: 324px;
  flex-direction: column;
  flex-shrink: 0;
}

.empty-card, .error-card, .control-card, .slider-card, .progress-card {
  width: 324px;
  flex-direction: column;
  padding: 16px 18px;
  margin-bottom: 10px;
  border-radius: 36px;
  background-color: #24262a;
  flex-shrink: 0;
}

.empty-title, .error-title {
  color: #ffffff;
  font-size: 28px;
  font-weight: bold;
}

.empty-detail, .control-detail {
  color: rgba(255,255,255,0.58);
  font-size: 20px;
  margin-top: 6px;
}

.error-card {
  background-color: #3a2020;
}

.error-title, .error-text {
  color: #f48771;
}

.error-text {
  font-size: 22px;
  margin-top: 8px;
}

.ui-heading, .ui-text {
  width: 324px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.ui-heading {
  font-weight: bold;
  line-height: 40px;
}

.ui-text {
  line-height: 32px;
}

.ui-button {
  width: 324px;
  min-height: 64px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  border-radius: 32px;
  flex-shrink: 0;
}

.ui-button-primary { background-color: #0d6eff; }
.ui-button-danger { background-color: #d94343; }
.ui-button-neutral { background-color: #34373d; }

.ui-button-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.control-card {
  flex-direction: row;
  align-items: center;
}

.control-copy {
  width: 210px;
  flex-direction: column;
}

.control-label {
  color: #ffffff;
  font-size: 23px;
  font-weight: bold;
}

.ui-switch {
  width: 68px;
  margin-left: 8px;
}

.slider-header {
  width: 276px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.slider-value {
  color: #65a0ff;
  font-size: 21px;
  font-weight: bold;
}

.ui-slider {
  width: 276px;
  margin-top: 10px;
  padding-left: 0px;
  padding-right: 0px;
  selected-color: #0d6eff;
  block-color: #ffffff;
}

.ui-progress {
  width: 276px;
  margin-top: 12px;
  stroke-width: 12px;
  layer-color: #3b3e44;
}

.ui-grid {
  width: 324px;
  flex-direction: column;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.ui-grid-row {
  width: 324px;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.ui-grid-cell {
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  flex-shrink: 0;
}

.ui-grid-cell-2 { width: 157px; }
.ui-grid-cell-3 { width: 104px; }
