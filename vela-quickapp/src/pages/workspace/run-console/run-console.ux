<template>
  <div class="page">
    <!-- 输出控制台 -->
    <scroll bounces="true" class="scroll-container" scroll-y="true">
      <div class="console-card">
        <text class="result-title">console：</text>
        <text class="run-status" style="color: {{statusColor}};">{{statusText}}</text>
        <div class="result-box">
          <text class="result" if="{{!hasError}}">{{result}}</text>
          <text class="error" if="{{hasError}}">{{error}}</text>
          <text class="runtime" if="{{runTime}}">同步运行耗时: {{runTime}} ms</text>
        </div>
      </div>
    </scroll>

    <!-- 顶部工具栏 -->
    <img static src="/common/images/hd.png" class="topbar-bg" />
    <img static src="/common/images/back.png" class="btn" style="left: 6px; top: 6px;" @click="onBack" />
    <img static if="{{!isRunning}}" src="/common/images/rerun.png" class="btn" style="left: 258px; top: 6px;" @click="onRerun" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">运行JS</text>

    <!-- 右上角根据运行状态切换停止/重试。 -->
    <div if="{{isRunning}}" class="stop-button" @click="onStop">
      <div class="stop-symbol"></div>
    </div>
  </div>
</template>

<script>
  import { back as navigateBack } from '../../../utils/core/routeManager.js';
  import { vibrate } from '../../../utils/core/uiFeedback.js';
  import { getCurrentClock } from '../../../utils/core/time.js';
  import { createScriptRuntimeApi } from '../../../utils/runtime/scriptRuntimeApi.js';

  const MAX_CONSOLE_CHARACTERS = 6 * 1024;
  const CONSOLE_FLUSH_DELAY = 80;
	const MAX_PREVIEW_ITEMS = 20;
  let consoleBuffer = '';
  let consoleFlushTimer = null;
  let consoleOutputTruncated = false;

	function formatConsoleArgument(argument) {
	  if (typeof argument !== 'object' || argument === null) return String(argument);
	  try {
		if (Array.isArray(argument)) {
		  const preview = argument.slice(0, MAX_PREVIEW_ITEMS);
		  return JSON.stringify(preview) + (argument.length > MAX_PREVIEW_ITEMS ? ' …(' + argument.length + ' 项)' : '');
		}
		const keys = Object.keys(argument);
		const preview = {};
		keys.slice(0, MAX_PREVIEW_ITEMS).forEach((key) => { preview[key] = argument[key]; });
		return JSON.stringify(preview) + (keys.length > MAX_PREVIEW_ITEMS ? ' …(' + keys.length + ' 个字段)' : '');
	  } catch (error) {
		return '[object Object]';
	  }
	}

  export default {
    private: {
      nowTime: "00:00",
      timer: null,
      code: "",
      result: "",
      error: "",
      hasError: false,
      runTime: "",
      isRunning: false,
      statusText: "准备运行",
      statusColor: "#9aa0a8",
      runId: 0,
      destroyed: false,

      // 全局虚拟 window
      vwindow: null,

    },

    onInit() {
      this.destroyed = false;
      this.updateTime();
      this.timer = setInterval(() => {
        this.updateTime();
      }, 60000);

      const editor = this.$app.$def.editor;
      this.code = editor.code || editor.before + editor.after;
      editor.code = '';
      this.runCode();
    },

    onDestroy() {
      this.cancelRun();
      this.destroyed = true;
      if (this.timer) clearInterval(this.timer);
	  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
	  consoleFlushTimer = null;
	  consoleBuffer = '';
	  consoleOutputTruncated = false;
	  this.code = '';
	  this.result = '';
	  this.error = '';
    },

    updateTime() {
      this.nowTime = getCurrentClock();
    },

    onBack() {
      vibrate('short');
      this.cancelRun();
      navigateBack();
    },

    onRerun() {
      vibrate('short');
      this.runCode();
    },

    onStop() {
      if (!this.isRunning) return;
      vibrate('short');
      this.cancelRun();
      this.isRunning = false;
      this.statusText = '已停止';
      this.statusColor = '#9aa0a8';
      this.appendConsoleOutput('运行已停止');
      if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
      consoleFlushTimer = null;
      this.flushConsoleOutput();
    },


    initVWindow(runId) {
      // console 实现
      const vconsole = {
        log: (...args) => {
		  if (this.destroyed || runId !== this.runId) return;
		  const output = args.map(formatConsoleArgument).join(' ');
		  this.appendConsoleOutput(output);
        },
        error: (...args) => {
          if (this.destroyed || runId !== this.runId) return;
          const output = args.map(formatConsoleArgument).join(' ');
		  this.appendConsoleOutput("[ERROR] " + output);
        }
      };

      this.vwindow = {
        console: vconsole
      };
      return this.vwindow;
	},

	appendConsoleOutput(output) {
	  if (consoleOutputTruncated) return;
	  const separator = consoleBuffer ? '\n' : '';
	  const available = MAX_CONSOLE_CHARACTERS - consoleBuffer.length - separator.length;
	  if (available <= 0 || output.length > available) {
		consoleBuffer += separator + output.slice(0, Math.max(0, available));
		consoleBuffer += '\n…输出过多，已截断';
		consoleOutputTruncated = true;
	  } else {
		consoleBuffer += separator + output;
	  }
	  if (!consoleFlushTimer) {
		consoleFlushTimer = setTimeout(() => {
		  consoleFlushTimer = null;
		  this.flushConsoleOutput();
		}, CONSOLE_FLUSH_DELAY);
	  }
	},

	flushConsoleOutput() {
	  if (this.destroyed) return;
	  this.result = consoleBuffer || '暂无输出';
	},

    cancelRun() {
      this.runId += 1;
    },

    runCode() {
	  this.runId += 1;
	  const runId = this.runId;
	  this.vwindow = this.initVWindow(runId);
	  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
	  consoleFlushTimer = null;
	  consoleBuffer = '';
	  consoleOutputTruncated = false;
      this.result = "";
      this.error = "";
      this.hasError = false;
      this.runTime = "";
      this.isRunning = true;
      this.statusText = '运行中';
      this.statusColor = '#72d39b';

      if (!this.code.trim()) {
        this.result = "没有代码可执行";
        this.isRunning = false;
        this.statusText = '无代码';
        this.statusColor = '#9aa0a8';
        return;
      }

      const isActive = () => !this.destroyed && runId === this.runId;
      const runtime = createScriptRuntimeApi(this.$app.$def, {
        name: this.$app.$def.editor.name || 'untitled.js',
        mode: 'console',
        isActive,
        exit: () => { this.cancelRun(); navigateBack(); }
      });

      const exposedModules = {
        system: runtime.system,
        console: this.vwindow.console,
        dialog: runtime.dialog,
        script: runtime.script
      };

      try {
        const userFunction = new Function(...Object.keys(exposedModules), `
            ${this.code}
        `);

		setTimeout(() => {
		  if (this.destroyed || runId !== this.runId) return;
		  const startTime = Date.now();
		  try {
			userFunction(...Object.values(exposedModules));
		  } catch (error) {
			if (this.destroyed || runId !== this.runId) return;
			this.error = `${error.name}: ${error.message}`;
			this.hasError = true;
			this.isRunning = false;
			this.statusText = '运行错误';
			this.statusColor = '#f48771';
		  }
		  if (!this.hasError) {
			this.isRunning = false;
			this.statusText = '已完成';
			this.statusColor = '#9aa0a8';
		  }
		  this.runTime = String(Date.now() - startTime);
		  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
		  consoleFlushTimer = null;
		  this.flushConsoleOutput();
		}, 0);
      } catch (e) {
        this.result = "";
        this.error = `${e.name}: ${e.message}`;
        this.hasError = true;
        this.isRunning = false;
        this.statusText = '编译失败';
        this.statusColor = '#f48771';
      }
    }
  }
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  position: relative;
  flex-direction: column;
	  overflow: hidden;
}

.scroll-container {
  position: absolute;
  top: 0px;
  left: 0px;
  width: 336px;
  height: 480px;
  flex-direction: column;
  padding: 102px 6px 84px;
}

.console-card {
	width: 324px;
  flex-direction: column;
  padding: 14px 20px;
  margin-bottom: 8px;
  border-radius: 36px;
  background-color: #262626;
	flex-shrink: 0;
}

.result-title {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 8px;
}

.run-status {
  font-size: 20px;
  margin-bottom: 8px;
}

.result-box {
  flex-direction: column;
	flex-shrink: 0;
}

.result {
  color: #9cdcfe;
  font-size: 24px;
}

.error {
  color: #f48771;
  font-size: 24px;
}

.runtime {
  color: rgba(200, 200, 200, 0.8);
  font-size: 20px;
  margin-top: 6px;
}


.topbar-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 336px;
  height: 102px;
}

.btn {
  position: absolute;
  width: 72px;
  height: 72px;
}

.stop-button {
  position: absolute;
  left: 258px;
  top: 6px;
  width: 72px;
  height: 72px;
  border-radius: 36px;
  background-color: #ff3b3b;
  justify-content: center;
  align-items: center;
}

.stop-symbol {
  width: 26px;
  height: 26px;
  border-radius: 3px;
  background-color: #ffffff;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  font-weight: bold;
  font-size: 24px;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}
</style>
