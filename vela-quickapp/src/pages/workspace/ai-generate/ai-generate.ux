<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="item status-item {{busy ? 'disabled-item' : ''}}" @click="loadEntitlement">
        <text class="item-title {{busy ? 'disabled-text' : ''}}">AI 服务</text>
        <text class="item-description {{busy ? 'disabled-text' : ''}}">{{activationText}}</text>
      </div>
      <div class="item {{busy ? 'disabled-item' : ''}}" @click="selectMode">
        <text class="item-title {{busy ? 'disabled-text' : ''}}">生成方式</text>
        <text class="item-description {{busy ? 'disabled-text' : ''}}">{{modeLabel}}</text>
      </div>
      <div class="item prompt-item {{busy ? 'disabled-item' : ''}}" @click="editPrompt">
        <text class="item-title {{busy ? 'disabled-text' : ''}}">需求</text>
        <text class="item-description {{busy ? 'disabled-text' : ''}}">{{promptDescription}}</text>
      </div>
      <div if="{{active}}" class="item action {{busy || loading ? 'disabled-item' : 'primary'}}" @click="generate">
        <text class="action-text {{busy || loading ? 'disabled-text' : ''}}">{{busy ? '正在生成...' : loading ? '正在检查...' : '生成并填入编辑器'}}</text>
      </div>
      <div if="{{!active}}" class="item action disabled-item">
        <text class="action-text disabled-text">{{inactiveActionText}}</text>
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">AI 生成</text>
    <img static src="/common/images/back.png" class="back-button" @click="goBack" />
    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import { RUNTIME_CONTRACT } from '../../../utils/runtime/runtimeContract.js';
import { errorMessage } from '../../../utils/cloud/cloudError.js';
import { startNetworkFeedback, updateNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../../utils/core/networkFeedback.js';
import { back } from '../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { enterNetworkPage } from '../../../utils/cloud/serverSelection.js';
const MODE_OPTIONS = ['创作新脚本', '改写当前脚本'];
export default {
  private: {
    nowTime: '00:00',
    paired: false,
    active: false,
    loading: false,
    initialized: false,
    busy: false,
    networkStatus: '',
    networkStage: '',
    mode: 'create',
    modeLabel: MODE_OPTIONS[0],
    prompt: '',
    promptDescription: '点击填写要实现的功能',
    activationText: '正在检查激活状态',
    inactiveActionText: '正在检查服务状态',
    pageActive: true
  },
  onInit() {
    this.updateTime();
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    if (this.initialized) return;
    this.initialized = true;
    enterNetworkPage(this, () => this.loadEntitlement());
  },
  onHide() { stopPageClock(this); setNetworkFeedbackVisible(this, false); },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  loadEntitlement() {
    if (this.loading || this.busy) return;
    this.loading = true;
    startNetworkFeedback(this, '正在检查 AI 服务');
    this.$app.$def.getCloudClients().deviceAccount.getState().then(state => {
      if (!this.pageActive) return null;
      this.paired = state.paired;
      if (!state.paired) throw new Error('device_auth_required');
      updateNetworkFeedback(this, '正在验证 AI 激活状态');
      return this.$app.$def.getCloudClients().deviceAccount.getEntitlements();
    }).then(entitlement => {
      if (!this.pageActive || !entitlement) return;
      this.loading = false;
      if (entitlement.runtimeContract !== RUNTIME_CONTRACT) throw new Error('设备与云端运行契约不一致，请同步更新应用和云插件');
      this.active = entitlement.cloudEnabled && entitlement.aiEnabled;
      this.inactiveActionText = this.active ? '' : '请先在网页端激活';
      this.activationText = this.active ? '已激活，余额 ¥' + (entitlement.aiCreditCents / 100).toFixed(2) : '未激活，请在网页端兑换激活码';
      stopNetworkFeedback(this);
    }).catch(error => {
      if (!this.pageActive) return;
      this.loading = false;
      stopNetworkFeedback(this);
      this.active = false;
      this.inactiveActionText = error && error.message === 'device_auth_required' ? '请先登录并配对设备' : errorMessage(error, '检查 AI 服务状态');
      this.activationText = error && error.message === 'device_auth_required' ? '请先在云账户页配对设备' : errorMessage(error, '验证 AI 激活状态');
    });
  },
  selectMode() {
    if (this.busy) return;
    vibrate('short');
    this.$app.$def.openDialog('select', {
      title: '生成方式',
      items: [{label:MODE_OPTIONS[0],value:'create'},{label:MODE_OPTIONS[1],value:'rewrite'}],
      value: this.mode
    }, this).then(result => {
      if (result.action === "confirm") {
        this.setMode(result.value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  setMode(mode) {
    this.mode = mode === 'rewrite' ? 'rewrite' : 'create';
    this.modeLabel = this.mode === 'rewrite' ? MODE_OPTIONS[1] : MODE_OPTIONS[0];
  },
  editPrompt() {
    if (this.busy) return;
    this.$app.$def.openDialog('text', {
      title: '脚本需求',
      message: '描述功能、输入和预期结果',
      value: this.prompt,
      maxLength: 4000
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        this.setPrompt(value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  setPrompt(value) {
    this.prompt = String(value || '').trim();
    this.promptDescription = this.prompt || '点击填写要实现的功能';
  },
  generate() {
    if (this.busy || this.loading) return;
    if (!this.paired) {
      showToast('请先在云账户页配对设备');
      return;
    }
    if (!this.active) {
      showToast('请先在网页端激活 AI 功能');
      return;
    }
    if (!this.prompt) {
      showToast('请先填写脚本需求');
      return;
    }
    const editor = this.$app.$def.editor;
    if (!editor.name) {
      showToast('没有可写入的编辑器文件');
      return;
    }
    this.busy = true;
    startNetworkFeedback(this, '正在等待 AI 结果');
    const source = this.mode === 'rewrite' ? editor.before + editor.after : '';
    this.$app.$def.getCloudClients().deviceAi.generateAi(this.mode, this.prompt, source, editor.name).then(result => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      editor.before = result.code;
      editor.after = '';
      this.$app.$def.updateEditorCode(result.code);
      showToast('已生成，扣除 ¥' + ((Number(result.usage.chargedCents) || 0) / 100).toFixed(2));
      back();
    }).catch(error => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      if (error && error.message === 'activation_required') showToast('请先在网页端激活 AI 功能');else if (error && error.message === 'ai_credit_insufficient') showToast('AI 余额不足，请在网页端充值');else showToast(errorMessage(error, this.mode === 'rewrite' ? 'AI 改写当前脚本' : 'AI 生成新脚本'));
    }).then(() => {
      if (this.pageActive) this.busy = false;
    });
  },
  goBack() {
    vibrate('short');
    back();
  },
  loadingTap() { return false; }
};
</script>

<style>
@import "../../../common/styles/network-loading.css";
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:84px 6px 24px; flex-direction:column; }
.item { width:324px; height:112px; padding:14px 20px; margin-bottom:8px; background-color:#262626; border-radius:36px; flex-direction:column; flex-shrink:0; justify-content:space-between; }
.status-item { background-color:#1f3045; }
.prompt-item { height:136px; }
.item-title { width:284px; font-size:28px; line-height:36px; font-weight:bold; color:#ffffff; text-overflow:ellipsis; lines:1; }
.item-description { width:284px; font-size:20px; line-height:28px; color:rgba(255,255,255,0.68); text-overflow:ellipsis; lines:2; }
.action { justify-content:center; }
.primary { background-color:#0D6EFF; }
.disabled-item { background-color:#303030; }
.action-text { width:284px; font-size:28px; line-height:36px; font-weight:bold; color:#ffffff; text-align:center; lines:2; text-overflow:ellipsis; }
.disabled-text { color:#8c8c8c; }
.topbar { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.back-button { position:absolute; left:6px; top:6px; width:72px; height:72px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.title-text { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:32px; font-weight:bold; color:#ffffff; text-align:center; }
</style>
