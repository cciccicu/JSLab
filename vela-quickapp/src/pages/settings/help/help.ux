<template>
  <div class="page">
    <scroll id="help-scroll" class="scroll" scroll-y="true" bounces="true">
      <div if="{{viewMode === 'directory'}}" class="directory-view">
        <div class="directory-header">
          <text class="directory-kicker">{{directoryKicker}}</text>
          <text class="directory-title">{{directoryHeading}}</text>
          <text class="directory-description">{{directoryDescription}}</text>
        </div>

        <div if="{{canGoUp}}" class="up-row" @click="goUp">
          <text class="up-arrow">‹</text>
          <text class="up-text">返回上一级</text>
        </div>

        <div class="menu-card" for="{{directoryItems}}" tid="id" @click="openItem($item.id)">
          <div if="{{$item.type === 'directory'}}" class="menu-marker marker-directory"></div>
          <div else class="menu-marker marker-document"></div>
          <div class="menu-copy">
            <text class="menu-title">{{$item.title}}</text>
            <text class="menu-summary">{{$item.summary}}</text>
          </div>
          <text class="chevron">›</text>
        </div>
      </div>

      <div if="{{viewMode === 'article'}}" class="article-view">
        <div class="article-header">
          <text class="article-kicker">{{articleKicker}}</text>
          <text class="article-title">{{activeDocument.title}}</text>
          <text class="article-summary">{{activeDocument.summary}}</text>
          <text class="article-intro">{{activeDocument.intro}}</text>
        </div>

        <div class="method-card" for="{{activeDocument.methods}}" tid="id">
          <text class="method-name">{{$item.name}}</text>
          <text class="method-description">{{$item.description}}</text>
          <text if="{{$item.example}}" class="code-label">示例</text>
          <text if="{{$item.example}}" class="code-block">{{$item.example}}</text>
          <text if="{{$item.note}}" class="method-note">{{$item.note}}</text>
        </div>

        <div if="{{activeDocument.note}}" class="article-note-card">
          <text class="article-note">{{activeDocument.note}}</text>
        </div>
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar-bg" />
    <text class="time-text">{{nowTime}}</text>
    <text if="{{pageTitle.length <= 5}}" class="title-text">{{pageTitle}}</text>
    <marquee if="{{pageTitle.length > 5}}" class="title-marquee" scrollamount="4" loop="-1">{{pageTitle}}</marquee>
    <img static src="/common/images/back.png" class="btn" @click="goBack" />
  </div>
</template>

<script>
import { back as navigateBack } from '../../../utils/core/routeManager.js';
import { vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { scheduleNextTick } from '../../../utils/core/runtimeCompat.js';
import { HELP_ROOT, findHelpNode, getDirectoryItems } from '../../../data/helpDocs.js';

const ROOT_TITLE = '帮助';
const ROOT_DESCRIPTION = '先了解如何创建和运行脚本，再按需要查找界面、设备与云端功能。';

export default {
  private: {
    nowTime: '00:00',
    viewMode: 'directory',
    currentDirectoryId: '',
    directoryTrail: [],
    directoryItems: HELP_ROOT,
    activeDocument: null,
    pageTitle: ROOT_TITLE,
    directoryKicker: '使用帮助',
    directoryHeading: ROOT_TITLE,
    directoryDescription: ROOT_DESCRIPTION,
    articleKicker: '使用帮助',
    canGoUp: false
  },

  onInit() {
    this.updateTime();
    this.restoreDirectory('');
  },

  onShow() {
    startPageClock(this);
    this.updateTime();
  },

  onHide() { stopPageClock(this); },
  onDestroy() {
    stopPageClock(this);
  },

  onBackPress() {
    this.goBack();
    return true;
  },

  updateTime() {
    this.nowTime = getCurrentClock();
  },

  resetScroll() {
    scheduleNextTick(this, () => {
      const scroll = this.$element('help-scroll');
      if (scroll) scroll.scrollTo({top:0, left:0, behavior:'instant'});
    });
  },

  openItem(id) {
    const node = findHelpNode(id);
    if (!node) return;
    vibrate('short');
    if (node.type === 'directory') {
      this.openDirectory(node);
      return;
    }
    this.activeDocument = node;
    this.viewMode = 'article';
    this.pageTitle = node.title;
    this.articleKicker = this.currentDirectoryId ? (findHelpNode(this.currentDirectoryId) || {}).title || '使用帮助' : '使用帮助';
    this.resetScroll();
  },

  openDirectory(node) {
    this.directoryTrail = this.directoryTrail.concat(this.currentDirectoryId);
    this.restoreDirectory(node.id);
  },

  restoreDirectory(id) {
    const node = id ? findHelpNode(id) : null;
    this.currentDirectoryId = id;
    this.directoryItems = getDirectoryItems(id);
    this.viewMode = 'directory';
    this.activeDocument = null;
    this.pageTitle = node ? node.title : ROOT_TITLE;
    this.directoryKicker = id ? '帮助目录' : '使用帮助';
    this.directoryHeading = node ? node.title : ROOT_TITLE;
    this.directoryDescription = node ? node.summary : ROOT_DESCRIPTION;
    this.canGoUp = this.directoryTrail.length > 0;
    this.resetScroll();
  },

  goUp(feedback) {
    if (!this.directoryTrail.length) return;
    if (feedback !== false) vibrate('short');
    const previousId = this.directoryTrail[this.directoryTrail.length - 1];
    this.directoryTrail = this.directoryTrail.slice(0, this.directoryTrail.length - 1);
    this.restoreDirectory(previousId);
  },

  goBack() {
    vibrate('short');
    if (this.viewMode === 'article') {
      this.restoreDirectory(this.currentDirectoryId);
      return;
    }
    if (this.directoryTrail.length) {
      this.goUp(false);
      return;
    }
    navigateBack();
  }
};
</script>

<style>
@import "./help.css";
</style>
