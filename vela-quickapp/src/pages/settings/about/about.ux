<template>
	<div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="app-card">
        <img src="/common/logo.png" class="logo" />
        <div class="app-text-group">
          <text class="app-name">{{appName}}</text>
          <text class="app-version">版本 {{appVer}}</text>
        </div>
      </div>

      <text class="section-title">开发与支持</text>
      <div class="info-card">
        <text class="card-title">@ccicc.icu</text>
        <text class="card-description">JSLab 开发者</text>
      </div>
      <div class="info-card">
        <text class="card-title">@juyinandxinyi</text>
        <text class="card-description">支持人员，一个用爱发电的好人</text>
      </div>

      <text class="section-title">参考和使用的项目</text>
      <div class="info-card resource-card">
        <text class="resource-text">使用：@NEORUAA 输入法</text>
        <text class="resource-text">参考：@NEORUAA 电子书</text>
        <text class="resource-text">参考：@无源流沙 UI 设计</text>
      </div>

      <text class="section-title">交流与反馈</text>
      <div class="qrcode-card">
        <text class="card-title centered">QQ群 1067265942</text>
        <qrcode value="https://qm.qq.com/q/jiknQFvvA" class="feedback-qrcode"></qrcode>
      </div>

      <div class="license-card">
        <text class="license-text">本项目使用 GPL-3.0 许可证</text>
        <text class="joke-text">免费开源，欢迎倒卖</text>
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar-bg" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">关于</text>
    <img static src="/common/images/back.png" class="back-button" @click="goBack" />
	</div>
</template>

<script>
  import app from '@system.app'
  import { back as navigateBack } from '../../../utils/core/routeManager.js';
  import { vibrate } from '../../../utils/core/uiFeedback.js';
  import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';


  export default {
	private: {
    nowTime:'00:00',
    appName:'JSLab',
    appVer:'0.0.0'
	},
	onInit() {
    this.updateTime();
    const info = app.getInfo();
    this.appName = info.name;
    this.appVer = info.versionName;
	},
  onShow(){
    startPageClock(this);
	  this.updateTime();
  },
  onHide() { stopPageClock(this); },
  onDestroy(){
    stopPageClock(this);
  },
	goBack(){
		vibrate('short');
		navigateBack();
	},
  updateTime() {
    this.nowTime = getCurrentClock();
  }

  }
</script>

