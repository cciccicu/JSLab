<template>
	<div class="page" style="flex-direction: column;">
	  <scroll class="scroll" scroll-y="true" bounces="true">

		<div class="item" @click="routerTo('settingsEditor')">
		  <div class="item-content">
			<text class="itemtext">编辑器设置</text>
			<text class="itemtext2">字号、高亮与字体</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
  
		<div class="item" @click="routerTo('settingsCloud')">
		  <div class="item-content">
			<text class="itemtext">登录</text>
			<text class="itemtext2">登录你的账户</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('settingsHelp')">
		  <div class="item-content">
			<text class="itemtext">帮助</text>
			<text class="itemtext2">查看帮助</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('settingsAbout')">
		  <div class="item-content">
			<text class="itemtext">关于</text>
			<text class="itemtext2">关于JSLab</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('toolsMoney')">
		  <div class="item-content">
			<text class="itemtext">捐助</text>
			<text class="itemtext2">捐助开发者</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
	  </scroll>
  
	  <img static src="/common/images/hd.png" class="topbar-bg" />
	  <img static src="/common/images/back.png" class="back-button" @click="goBack" />
	  <text class="time-text">{{nowTime}}</text>
	  <text class="title-text">设置</text>
	</div>
  </template>
  
  <script>
  import { back, push } from '../../utils/core/routeManager.js';
  import { vibrate } from '../../utils/core/uiFeedback.js';
  import { getCurrentClock } from '../../utils/core/time.js';

  export default {
	private: {
	  nowTime: '00:00',
	  timer: null,
	  settingsLoading: false
	},

	updateTime() {
	  this.nowTime = getCurrentClock();
	},

	onInit() {
	  this.updateTime();
	  this.timer = setInterval(() => this.updateTime(), 60000);

	},

	onDestroy() {
	  if (this.timer) clearInterval(this.timer);
	},

	routerTo(route) {
	  vibrate('short');
	  push(route);
	},

	goBack() {
	  vibrate('short');
	  back();
	},

  };
  </script>
  
