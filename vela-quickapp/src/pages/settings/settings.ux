<template>
	<div class="page" style="flex-direction: column;">
	  <scroll class="scroll" scroll-y="true" bounces="true">

		<div class="item" @click="routerTo('settingsEditor')">
		  <div class="item-content">
			<text class="itemtext">编辑器设置</text>
			<text class="itemtext2">字号、高亮与字体</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>

		<div class="item" @click="selectTransport">
		  <div class="item-content">
			<text class="itemtext">传输方式</text>
			<text class="itemtext2">{{transportLabel}}</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('settingsCloud')">
		  <div class="item-content">
			<text class="itemtext">云账户</text>
			<text class="itemtext2">设备配对与账户状态</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('settingsHelp')">
		  <div class="item-content">
			<text class="itemtext">帮助</text>
			<text class="itemtext2">查看帮助</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('settingsAbout')">
		  <div class="item-content">
			<text class="itemtext">关于</text>
			<text class="itemtext2">关于JSLab</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
		<div class="item" @click="routerTo('toolsMoney')">
		  <div class="item-content">
			<text class="itemtext">捐助</text>
			<text class="itemtext2">捐助开发者</text>
		  </div>
		  <img src="/common/images/enter.png" style="width:40px;height: 40px;" />
		</div>
	  </scroll>

	  <img static src="/common/images/hd.png" class="topbar-bg" />
	  <text class="time-text">{{nowTime}}</text>
	  <text class="title-text">设置</text>
	  <img static src="/common/images/back.png" class="back-button" @click="goBack" />
	</div>
  </template>

  <script>
  import { back, push } from '../../utils/core/routeManager.js';
  import { showToast, vibrate } from '../../utils/core/uiFeedback.js';
  import { getCurrentClock, startPageClock, stopPageClock } from '../../utils/core/time.js';
  import { formatError } from '../../utils/core/userError.js';

  export default {
	private: {
	  nowTime: '00:00',
    transport: 'fetch',
    transportLabel: '正在读取...',
    transportLoading: false,
    transportLoaded: false,
    transportBusy: false,
    pageActive: true
	},

	updateTime() {
	  this.nowTime = getCurrentClock();
	},

	onInit() {
	  this.updateTime();

	},

	onShow() {
    startPageClock(this);
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    this.loadTransport();
  },
  onHide() { stopPageClock(this); },
  onDestroy() {
    stopPageClock(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
	},

  getTransportLabel(transport) {
    return transport === 'interconnect' ? 'AstroBox 网络桥接' : 'fetch 直连';
  },
  loadTransport() {
    if (this.transportLoading || this.transportBusy) return;
    this.transportLoading = true;
    return this.$app.$def.getCloudClients().deviceAccount.getState().then(state => {
      if (!this.pageActive) return;
      this.transport = state.transport;
      this.transportLabel = this.getTransportLabel(state.transport);
      this.transportLoaded = true;
    }).catch(error => {
      if (!this.pageActive) return;
      if (!this.transportLoaded) this.transportLabel = '读取失败，点击重试';
      showToast(formatError(error, '读取云服务传输方式'));
    }).then(() => {
      if (this.pageActive) this.transportLoading = false;
    });
  },
  selectTransport() {
    if (this.transportLoading || this.transportBusy) return;
    if (!this.transportLoaded) return this.loadTransport();
    vibrate('short');
    return this.$app.$def.openDialog('select', {
      title: '传输方式',
      message: '选择云 API 的请求方式',
      items: [{label:'fetch 直连',value:'fetch'},{label:'JSLabSync网络桥接',value:'interconnect'}],
      value: this.transport
    }, this).then(result => {
      if (this.pageActive && result.action === 'confirm') return this.saveTransport(result.value);
    }).catch(error => {
      if (this.pageActive) showToast(error.message || '无法打开对话框');
    });
  },
  saveTransport(transport) {
    if (this.transportBusy || (transport !== 'fetch' && transport !== 'interconnect')) return;
    this.transportBusy = true;
    return this.$app.$def.getConfigManager().set('cloud.transport', transport).then(() => {
      if (!this.pageActive) return;
      this.transport = transport;
      this.transportLabel = this.getTransportLabel(transport);
      showToast('已切换为' + this.transportLabel);
    }).catch(error => {
      if (this.pageActive) showToast(formatError(error, '保存云服务传输方式'));
    }).then(() => {
      if (this.pageActive) this.transportBusy = false;
    });
  },

	routerTo(route) {
	  vibrate('short');
	  push(route);
	},

	goBack() {
	  vibrate('short');
	  back();
	},

  };
  </script>

  <style>
@import "./settings.css";
</style>
