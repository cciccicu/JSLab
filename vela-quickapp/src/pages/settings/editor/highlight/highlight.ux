<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="item">
        <div class="item-content">
          <text class="item-title">高亮开关</text>
          <text class="item-description">编辑器彩色代码</text>
        </div>
        <switch class="setting-switch" checked="{{highlightEnabled}}" @change="onHighlightChange"></switch>
      </div>

      <div class="item" @click="setCharThreshold">
        <div class="item-content">
          <text class="item-title">字符阈值</text>
          <text class="item-description">最多 {{charThreshold}} 字符</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>

      <div class="item" @click="setLineThreshold">
        <div class="item-content">
          <text class="item-title">行数阈值</text>
          <text class="item-description">最多 {{lineThreshold}} 行</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>

      <div class="item" @click="selectPalette">
        <div class="item-content">
          <text class="item-title">配色预设</text>
          <text class="item-description">当前：{{paletteLabel}}</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar-bg" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">高亮设置</text>
    <img static src="/common/images/back.png" class="back-button" @click="goBack" />
  </div>
</template>

<script>
import { back as navigateBack } from '../../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../../utils/core/time.js';
import { formatError } from '../../../../utils/core/userError.js';
import { DEFAULT_HIGHLIGHT_PALETTE, getHighlightPalettePresets, normalizeHighlightPalette } from '../../../../utils/editor/highlightPalette.js';
import { DEFAULT_HIGHLIGHT_ENABLED, DEFAULT_HIGHLIGHT_CHAR_THRESHOLD, DEFAULT_HIGHLIGHT_LINE_THRESHOLD, MIN_HIGHLIGHT_CHAR_THRESHOLD, MAX_HIGHLIGHT_CHAR_THRESHOLD, MIN_HIGHLIGHT_LINE_THRESHOLD, MAX_HIGHLIGHT_LINE_THRESHOLD, normalizeHighlightCharThreshold, normalizeHighlightLineThreshold } from '../../../../utils/editor/editorPreferences.js';
const PALETTE_PRESETS = getHighlightPalettePresets();
function getPaletteLabel(id) {
  for (let index = 0; index < PALETTE_PRESETS.length; index += 1) {
    if (PALETTE_PRESETS[index].id === id) return PALETTE_PRESETS[index].label;
  }
  return PALETTE_PRESETS[0].label;
}

export default {
  private: {
    nowTime: '00:00',
    settingsLoading: false,
    pendingWrites: 0,
    highlightEnabled: DEFAULT_HIGHLIGHT_ENABLED,
    charThreshold: DEFAULT_HIGHLIGHT_CHAR_THRESHOLD,
    lineThreshold: DEFAULT_HIGHLIGHT_LINE_THRESHOLD,
    paletteId: DEFAULT_HIGHLIGHT_PALETTE,
    paletteLabel: getPaletteLabel(DEFAULT_HIGHLIGHT_PALETTE),
    highlightChangeId: 0,
    pageActive: true
  },
  onInit() {
    this.updateTime();
    this.loadSettings();
  },
  onShow() {
    startPageClock(this);
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    this.loadSettings();
  },
  onHide() { stopPageClock(this); },
  onDestroy() {
    stopPageClock(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  loadSettings() {
    if (this.settingsLoading || this.pendingWrites > 0) return;
    this.settingsLoading = true;
    Promise.all([this.$app.$def.getConfigManager().get('editor.highlight.enabled', DEFAULT_HIGHLIGHT_ENABLED), this.$app.$def.getConfigManager().get('editor.highlight.maxChars', DEFAULT_HIGHLIGHT_CHAR_THRESHOLD), this.$app.$def.getConfigManager().get('editor.highlight.maxLines', DEFAULT_HIGHLIGHT_LINE_THRESHOLD), this.$app.$def.getConfigManager().get('editor.highlight.palette', DEFAULT_HIGHLIGHT_PALETTE)]).then(values => {
      if (!this.pageActive) return;
      this.settingsLoading = false;
      this.highlightEnabled = values[0] === true;
      this.charThreshold = normalizeHighlightCharThreshold(values[1]);
      this.lineThreshold = normalizeHighlightLineThreshold(values[2]);
      this.paletteId = normalizeHighlightPalette(values[3]);
      this.paletteLabel = getPaletteLabel(this.paletteId);
    }).catch(error => {
      if (!this.pageActive) return;
      this.settingsLoading = false;
      console.error('Failed to load highlight settings:', error);
      showToast(formatError(error, '读取语法高亮开关、阈值与配色'));
    });
  },
  onHighlightChange(eventData) {
    if (this.settingsLoading || !this.pageActive) return;
    const previous = this.highlightEnabled;
    const enabled = eventData && typeof eventData.checked !== 'undefined' ? !!eventData.checked : !!(eventData && eventData.detail && eventData.detail.checked);
    if (enabled === previous) return;
    const changeId = this.highlightChangeId + 1;
    this.highlightChangeId = changeId;
    this.highlightEnabled = enabled;
    this.pendingWrites += 1;
    this.$app.$def.getConfigManager().set('editor.highlight.enabled', enabled).then(() => {
      if (!this.pageActive) return;
      this.pendingWrites -= 1;
      if (changeId === this.highlightChangeId) showToast('语法高亮已' + (enabled ? '开启' : '关闭'));
    }).catch(error => {
      if (!this.pageActive) return;
      this.pendingWrites -= 1;
      console.error('Failed to save syntax highlighting:', error);
      if (changeId === this.highlightChangeId) this.highlightEnabled = previous;
      showToast(formatError(error, '保存语法高亮开关'));
    });
  },
  setCharThreshold() {
    if (this.settingsLoading) return;
    vibrate('short');
    this.$app.$def.openDialog('number', {
      title: '字符阈值',
      message: '输入 512-100000',
      value: this.charThreshold,
      min: MIN_HIGHLIGHT_CHAR_THRESHOLD, max: MAX_HIGHLIGHT_CHAR_THRESHOLD,
      decimals: 0,
      required: true
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        this.saveCharThreshold(value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  saveCharThreshold(value) {
    const nextValue = normalizeHighlightCharThreshold(value, this.charThreshold);
    this.charThreshold = nextValue;
    this.saveSetting('editor.highlight.maxChars', nextValue, '字符阈值已更新');
  },
  setLineThreshold() {
    if (this.settingsLoading) return;
    vibrate('short');
    this.$app.$def.openDialog('number', {
      title: '行数阈值',
      message: '输入 40-2000',
      value: this.lineThreshold,
      min: MIN_HIGHLIGHT_LINE_THRESHOLD, max: MAX_HIGHLIGHT_LINE_THRESHOLD,
      decimals: 0,
      required: true
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        this.saveLineThreshold(value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  saveLineThreshold(value) {
    const nextValue = normalizeHighlightLineThreshold(value, this.lineThreshold);
    this.lineThreshold = nextValue;
    this.saveSetting('editor.highlight.maxLines', nextValue, '行数阈值已更新');
  },
  selectPalette() {
    if (this.settingsLoading) return;
    vibrate('short');
    this.$app.$def.openDialog('select', {
      title: '配色预设',
      message: '选择编辑器高亮配色',
      items: PALETTE_PRESETS.map(item => ({label:item.label,value:item.id})),
      value: this.paletteId
    }, this).then(result => {
      if (result.action === "confirm") {
        this.savePalette(result.value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  savePalette(id) {
    const nextId = id;
    this.paletteId = nextId;
    this.paletteLabel = getPaletteLabel(nextId);
    this.saveSetting('editor.highlight.palette', nextId, '配色已切换为' + this.paletteLabel);
  },
  saveSetting(key, value, successMessage) {
    this.pendingWrites += 1;
    this.$app.$def.getConfigManager().set(key, value).then(() => {
      if (!this.pageActive) return;
      this.pendingWrites -= 1;
      showToast(successMessage);
    }).catch(error => {
      if (!this.pageActive) return;
      this.pendingWrites -= 1;
      console.error('Failed to save highlight setting:', error);
      showToast(formatError(error, '保存高亮设置 ' + key));
      this.loadSettings();
    });
  },
  goBack() {
    vibrate('short');
    navigateBack();
  }
};
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  overflow: hidden;
}

.scroll {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 480px;
  padding: 84px 6px 24px;
  flex-direction: column;
}

.item {
  width: 324px;
  height: 112px;
  margin-bottom: 8px;
  padding: 14px 20px;
  background-color: #262626;
  border-radius: 36px;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
}

.item-content {
  height: 84px;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  width: 100%;
  height: 40px;
  line-height: 40px;
  color: #ffffff;
  font-size: 30px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.item-description {
  width: 100%;
  height: 34px;
  line-height: 34px;
  color: rgba(255,255,255,0.6);
  font-size: 24px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.setting-switch {
  width: 72px;
  height: 42px;
  margin-left: 12px;
  flex-shrink: 0;
}

.enter-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
}

.topbar-bg {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 84px;
}

.back-button {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  color: rgba(255,255,255,0.6);
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  color: #ffffff;
  font-size: 32px;
  font-weight: bold;
  text-align: center;
}
</style>
