<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="item" @click="setFontSize">
        <div class="item-content">
          <text class="itemtext">字号</text>
          <text class="itemtext2">{{fontSizeDescription}}</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>
      <div class="item" @click="openHighlightSettings">
        <div class="item-content">
          <text class="itemtext">语法高亮</text>
          <text class="itemtext2">开关、阈值与配色</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>
      <div class="item" @click="openFontSettings">
        <div class="item-content">
          <text class="itemtext">字体</text>
          <text class="itemtext2">即将上线</text>
        </div>
        <img src="/common/images/enter.png" class="enter-icon" />
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">编辑器设置</text>
    <img static src="/common/images/back.png" class="back-button" @click="goBack" />
  </div>
</template>

<script>
import { back, push } from '../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import { DEFAULT_FONT_SIZE, MAX_FONT_SIZE, MIN_FONT_SIZE, normalizeFontSize } from '../../../utils/editor/editorPreferences.js';
import { formatError } from '../../../utils/core/userError.js';
export default {
  private: {
    nowTime: '00:00',
    currentFontSize: DEFAULT_FONT_SIZE,
    fontSizeDescription: '当前：16px',
    settingsLoading: false,
    settingsWritePending: false,
    pageActive: true
  },
  onInit() {
    this.updateTime();
    this.loadSettings();
  },
  onShow() {
    startPageClock(this);
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    this.loadSettings();
  },
  onHide() { stopPageClock(this); },
  onDestroy() {
    stopPageClock(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  loadSettings() {
    if (this.settingsLoading || this.settingsWritePending) return;
    this.settingsLoading = true;
    this.$app.$def.getConfigManager().get('editor.font.size', DEFAULT_FONT_SIZE).then(value => {
      this.settingsLoading = false;
      if (!this.pageActive) return;
      this.currentFontSize = normalizeFontSize(value, DEFAULT_FONT_SIZE);
      this.fontSizeDescription = '当前：' + this.currentFontSize + 'px';
    }).catch(error => {
      this.settingsLoading = false;
      if (!this.pageActive) return;
      showToast(formatError(error, '读取编辑器字号设置'));
    });
  },
  setFontSize() {
    if (this.settingsLoading || this.settingsWritePending) return;
    vibrate('short');
    this.$app.$def.openDialog('number', {
      title: '设置字号',
      message: '请输入编辑器字号（' + MIN_FONT_SIZE + '-' + MAX_FONT_SIZE + '）',
      value: this.currentFontSize,
      min: MIN_FONT_SIZE, max: MAX_FONT_SIZE,
      decimals: 0,
      required: true
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        this.saveFontSize(value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  saveFontSize(value) {
    if (this.settingsWritePending) return;
    const previous = this.currentFontSize;
    const size = normalizeFontSize(value, this.currentFontSize);
    this.currentFontSize = size;
    this.fontSizeDescription = '当前：' + size + 'px';
    this.settingsWritePending = true;
    this.$app.$def.getConfigManager().set('editor.font.size', size).then(() => {
      if (this.pageActive) showToast('字号已设为 ' + size + 'px');
    }).catch(error => {
      if (!this.pageActive) return;
      this.currentFontSize = previous;
      this.fontSizeDescription = '当前：' + previous + 'px';
      showToast(formatError(error, '保存编辑器字号 ' + size + 'px'));
    }).then(() => {
      if (this.pageActive) this.settingsWritePending = false;
    });
  },
  openHighlightSettings() {
    this.routerTo('settingsHighlight');
  },
  openFontSettings() {
    vibrate('short');
    showToast('即将上线');
  },
  routerTo(route) {
    vibrate('short');
    push(route);
  },
  goBack() {
    vibrate('short');
    back();
  }
};
</script>

<style>
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:84px 6px 24px; flex-direction:column; }
.item { width:324px; height:112px; padding:14px 20px; margin-bottom:8px; background-color:#262626; border-radius:36px; flex-shrink:0; align-items:center; justify-content:space-between; }
.item-content { width:244px; height:84px; flex-shrink:0; flex-direction:column; justify-content:space-between; }
.itemtext { width:244px; font-size:32px; line-height:40px; font-weight:bold; color:#ffffff; text-overflow:ellipsis; lines:1; }
.itemtext2 { width:244px; font-size:24px; line-height:32px; font-weight:bold; color:rgba(255,255,255,0.6); text-overflow:ellipsis; lines:1; }
.enter-icon { width:40px; height:40px; flex-shrink:0; }
.topbar { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.back-button { position:absolute; left:6px; top:6px; width:72px; height:72px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.title-text { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:32px; font-weight:bold; color:#ffffff; text-align:center; }
</style>
