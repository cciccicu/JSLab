<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div if="{{loadError}}" class="item error-item {{busy || loading ? 'disabled-item' : ''}}" @click="loadState">
        <text class="item-title {{busy || loading ? 'disabled-text' : ''}}">无法读取云账户</text>
        <text class="item-description {{busy || loading ? 'disabled-text' : ''}}">{{loadErrorText}}</text>
      </div>
      <div class="item transport-item {{busy || loading ? 'disabled-item' : ''}}" @click="selectTransport">
        <text class="item-title {{busy || loading ? 'disabled-text' : ''}}">传输方式</text>
        <text class="item-description {{busy || loading ? 'disabled-text' : ''}}">{{transportLabel}}</text>
      </div>
      <div class="item device-item">
        <text class="item-title">当前设备</text>
        <text class="item-description">{{deviceName}}</text>
      </div>
      <div if="{{paired}}" class="item status-item {{busy || loading ? 'disabled-item' : ''}}" @click="loadState">
        <text class="item-title {{busy || loading ? 'disabled-text' : ''}}">JSLab Cloud 与 AI</text>
        <text class="item-description {{busy || loading ? 'disabled-text' : ''}}">{{activationText}}</text>
      </div>
      <div if="{{!paired && !pairingCode}}" class="item action {{busy || loading ? 'disabled-item' : ''}}" @click="startPairing">
        <text class="action-text {{busy || loading ? 'disabled-text' : ''}}">{{busy ? '正在生成...' : loading ? '正在读取账户...' : '生成配对二维码'}}</text>
      </div>
      <div if="{{pairingCode}}" class="pairing-card">
        <qrcode value="{{pairingQr}}" class="pairing-qr"></qrcode>
        <text class="pairing-code">{{pairingCode}}</text>
        <text class="pairing-status">{{pairingStatusText}}</text>
        <div class="pairing-cancel" @click="cancelPairing"><text class="pairing-cancel-text">取消配对</text></div>
      </div>
      <div if="{{paired && !activated && !loadError}}" class="item action disabled-item">
        <text class="action-text disabled-text">请在网页端激活云空间</text>
      </div>
      <div if="{{paired}}" class="item action danger {{busy || loading ? 'disabled-item' : ''}}" @click="logout">
        <text class="action-text {{busy || loading ? 'disabled-text' : ''}}">退出设备</text>
      </div>
    </scroll>
    <img static src="/common/images/hd.png" class="header" />
    <text class="time-text">{{nowTime}}</text>
    <text class="heading">云账户</text>
    <img static src="/common/images/back.png" class="back" @click="goBack" />
  </div>
</template>

<script>
import { back } from '../../../utils/core/routeManager.js';
import cloudService from '../../../utils/cloud/cloudService.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
import configManager from '../../../utils/core/configManager.js';
import { getDeviceName } from '../../../utils/core/deviceInfo.js';
import { formatError } from '../../../utils/core/userError.js';
export default {
  private: {
    paired: false,
    activated: false,
    activationText: '请在网页端激活云空间与 AI',
    busy: false,
    loading: false,
    initialized: false,
    transport: 'fetch',
    transportLabel: 'fetch 直连',
    deviceName: '',
    loadError: false,
    loadErrorText: '云账户状态尚未读取，点击重新读取',
    nowTime: '00:00',
    pairingTimer: null,
    pairingCode: '',
    pairingQr: '',
    pairingStatusText: '',
    pairingExpiresAt: 0,
    pairingPollBusy: false,
    pairingPollError: false,
    pairingPollTick: 0,
    pageActive: true,
    pageVisible: false,
    transportChangeId: 0
  },
  onInit() {
    this.updateTime();
    this.loadDeviceName();
  },
  onShow() {
    startPageClock(this);
    this.pageVisible = true;
    if (this.pairingCode) {
      if (Date.now() >= this.pairingExpiresAt) {
        this.clearPairing();
        showToast('配对码已过期，请重新生成');
      } else this.pollPairing();
    }
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    if (this.initialized) return;
    this.initialized = true;
    this.loadState();
  },
  onHide() {
    stopPageClock(this);
    this.pageVisible = false;
    if (this.pairingTimer) clearInterval(this.pairingTimer);
    this.pairingTimer = null;
  },
  onDestroy() {
    stopPageClock(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
    this.pageVisible = false;
    if (this.pairingTimer) clearInterval(this.pairingTimer);
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  loadDeviceName() {
    return getDeviceName().then(name => {
      if (this.pageActive) this.deviceName = name;
      return name;
    });
  },
  loadState() {
    if (this.busy || this.loading) return;
    this.loading = true;
    cloudService.getState().then(state => {
      if (!this.pageActive) return null;
      this.paired = state.paired;
      this.loadError = false;
      this.transport = state.transport;
      this.transportLabel = this.getTransportLabel(state.transport);
      if (!state.paired) {
        this.activated = false;
        this.activationText = '配对后可在网页端激活';
        return null;
      }
      return cloudService.getEntitlements().then(entitlement => {
        if (!this.pageActive) return;
        this.activated = entitlement.cloudEnabled;
        this.activationText = entitlement.cloudEnabled ? '已激活，AI 余额 ¥' + (entitlement.aiCreditCents / 100).toFixed(2) : '未激活，请在网页端兑换激活码';
      }).catch(error => {
        if (!this.pageActive) return;
        if (this.isAuthenticationExpired(error)) {
          this.paired = false;
          this.activated = false;
          this.loadError = false;
          this.activationText = '配对已失效，请重新配对';
          return;
        }
        this.activated = false;
        this.loadError = true;
        this.loadErrorText = cloudService.errorMessage(error, '读取云账户激活状态') + '，点击重新读取';
        this.activationText = cloudService.errorMessage(error, '验证云账户激活状态');
      });
    }).catch(error => {
      if (!this.pageActive) return;
      if (this.isAuthenticationExpired(error)) {
        this.paired = false;
        this.activated = false;
        this.loadError = false;
        this.activationText = '配对已失效，请重新配对';
        return;
      }
      this.loadError = true;
      this.activated = false;
      this.loadErrorText = cloudService.errorMessage(error, '读取云账户配置') + '，点击重新读取';
      this.activationText = cloudService.errorMessage(error, '读取云账户配置');
    }).then(() => { if (this.pageActive) this.loading = false; });
  },
  isAuthenticationExpired(error) {
    return !!error && (error.status === 401 || error.message === 'device_auth_required');
  },
  startPairing() {
    if (this.busy || this.loading || this.pairingCode) return;
    this.busy = true;
    this.loadDeviceName().then(name => cloudService.startPairing(name)).then(result => {
      if (!this.pageActive) return;
      this.pairingCode = result.code;
      this.pairingQr = result.qrValue;
      this.pairingExpiresAt = Date.now() + Number(result.expiresIn || 600) * 1000;
      if (this.pageVisible) this.pollPairing();
    }).catch(error => {
      if (this.pageActive) showToast(cloudService.errorMessage(error, '生成配对二维码'));
    }).then(() => {
      if (this.pageActive) this.busy = false;
    });
  },
  pollPairing() {
    if (this.pairingTimer) clearInterval(this.pairingTimer);
    this.pairingPollTick = 0;
    this.pairingPollError = false;
    this.updatePairingStatus('等待网页确认');
    this.checkPairing();
    this.pairingTimer = setInterval(() => {
      if (!this.pairingCode) return;
      if (Date.now() >= this.pairingExpiresAt) {
        this.clearPairing();
        showToast('配对码已过期，请重新生成');
        return;
      }
      this.pairingPollTick += 1;
      if (this.pairingPollBusy) {
        this.updatePairingStatus('正在连接云端');
      } else if (!this.pairingPollError) {
        this.updatePairingStatus('等待网页确认');
      }
      if (this.pairingPollTick % 2 === 0) this.checkPairing();
    }, 1000);
  },
  updatePairingStatus(prefix) {
    const seconds = Math.max(0, Math.ceil((this.pairingExpiresAt - Date.now()) / 1000));
    const minutes = Math.floor(seconds / 60);
    const rest = seconds % 60;
    this.pairingStatusText = prefix + ' · 剩余 ' + minutes + ':' + (rest < 10 ? '0' : '') + rest;
  },
  checkPairing() {
    if (!this.pageVisible || !this.pairingCode || this.pairingPollBusy) return;
    this.pairingPollBusy = true;
    const code = this.pairingCode;
    cloudService.pollPairing(code).then(result => {
      if (!this.pageActive || !this.pageVisible) return null;
      if (code !== this.pairingCode) return null;
      this.pairingPollError = false;
      if (result.status === 'claimed') {
        this.updatePairingStatus('网页已确认，正在完成配对');
        return cloudService.exchangePairing(code, this.deviceName).then(() => {
          if (!this.pageActive || code !== this.pairingCode) return;
          this.clearPairing();
          showToast('配对成功');
          this.loadState();
        });
      }
      if (result.status === 'expired' || result.status === 'used') {
        this.clearPairing();
        showToast('配对码已失效，请重新生成');
      } else this.updatePairingStatus('等待网页确认');
      return null;
    }).catch(error => {
      if (!this.pageActive) return;
      if (code === this.pairingCode) {
        this.pairingPollError = true;
        this.updatePairingStatus(cloudService.errorMessage(error, '查询配对确认状态'));
      }
    }).then(() => {
      if (this.pageActive) this.pairingPollBusy = false;
    });
  },
  cancelPairing() {
    if (!this.pairingCode) return;
    this.$app.$def.openDialog('confirm', {
      title: '取消配对？',
      message: '当前配对码将立即失效，需要重新生成。'
    }, this).then(result => {
      if (result.action === "confirm") {
        this.confirmCancelPairing();
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  confirmCancelPairing() {
    const code = this.pairingCode;
    this.clearPairing();
    if (code) cloudService.cancelPairing(code).catch(error => {
      if (this.pageActive) showToast(cloudService.errorMessage(error, '通知云服务取消配对码'));
    });
  },
  clearPairing() {
    if (this.pairingTimer) clearInterval(this.pairingTimer);
    this.pairingTimer = null;
    this.pairingCode = '';
    this.pairingQr = '';
    this.pairingStatusText = '';
    this.pairingExpiresAt = 0;
    this.pairingPollBusy = false;
    this.pairingPollError = false;
    this.pairingPollTick = 0;
  },
  getTransportLabel(transport) {
    return transport === 'interconnect' ? 'AstroBox 网络桥接' : 'fetch 直连';
  },
  selectTransport() {
    if (this.busy || this.loading) return;
    vibrate('short');
    this.$app.$def.openDialog('select', {
      title: '传输方式',
      message: '选择云 API 的请求方式',
      items: [{label:'fetch 直连',value:'fetch'},{label:'AstroBox 网络桥接',value:'interconnect'}],
      value: this.transport
    }, this).then(result => {
      if (result.action === "confirm") {
        this.saveTransport(result.value);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  saveTransport(transport) {
    if (this.busy) return;
    const changeId = this.transportChangeId + 1;
    this.transportChangeId = changeId;
    this.busy = true;
    configManager.set('cloud.transport', transport).then(() => {
      if (!this.pageActive || changeId !== this.transportChangeId) return;
      this.transport = transport;
      this.transportLabel = this.getTransportLabel(transport);
      this.busy = false;
      this.loadState();
      showToast('已切换为' + this.transportLabel);
    }).catch(error => {
      if (this.pageActive && changeId === this.transportChangeId) showToast(formatError(error, '保存云服务传输方式'));
    }).then(() => {
      if (this.pageActive && changeId === this.transportChangeId) this.busy = false;
    });
  },
  logout() {
    if (this.busy || this.loading) return;
    this.$app.$def.openDialog('confirm', {
      title: '退出当前设备？',
      message: '退出后需要重新配对才能使用云空间和 AI。'
    }, this).then(result => {
      if (result.action === "confirm") {
        this.confirmLogout();
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  confirmLogout() {
    if (this.busy) return;
    this.busy = true;
    cloudService.logout().then(result => {
      if (!this.pageActive) return;
      showToast(result && result.alreadyRevoked ? '设备已失效，本地已退出' : '已退出');
      this.paired = false;
      this.activated = false;
      this.loadError = false;
      this.activationText = '配对后可在网页端激活';
      this.busy = false;
      this.loadState();
    }).catch(error => {
      if (this.pageActive) showToast(cloudService.errorMessage(error, '撤销当前设备并退出'));
    }).then(() => {
      if (this.pageActive) this.busy = false;
    });
  },
  goBack() {
    vibrate('short');
    back();
  }
};
</script>

<style>
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:84px 6px 24px; flex-direction:column; }
.header { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.back { position:absolute; left:6px; top:6px; width:72px; height:72px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.heading { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:32px; font-weight:bold; color:#ffffff; text-align:center; }
.item { width:100%; height:112px; padding:14px 20px; margin-bottom:8px; border-radius:36px; background-color:#262626; flex-direction:column; flex-shrink:0; }
.status-item { justify-content:space-between; }
.item-title { width:100%; font-size:28px; line-height:36px; color:#ffffff; font-weight:bold; text-overflow:ellipsis; lines:1; }
.item-description { width:100%; font-size:20px; line-height:28px; color:rgba(255,255,255,0.6); text-overflow:ellipsis; lines:2; }
.action { justify-content:center; }
.danger { background-color:#542020; }
.disabled-item { background-color:#303030; }
.error-item { background-color:#542020; justify-content:center; }
.pairing-card { width:100%; min-height:270px; padding:12px 20px; margin-bottom:8px; border-radius:24px; background-color:#ffffff; align-items:center; flex-direction:column; flex-shrink:0; }
.pairing-qr { width:150px; height:150px; color:#000000; background-color:#ffffff; }
.pairing-code { margin-top:6px; font-size:30px; line-height:36px; color:#000000; font-weight:bold; letter-spacing:2px; }
.pairing-status { width:100%; margin-top:4px; font-size:20px; line-height:28px; color:#333333; text-align:center; }
.pairing-cancel { width:100%; height:60px; margin-top:4px; justify-content:center; align-items:center; }
.pairing-cancel-text { font-size:24px; line-height:32px; color:#b42318; font-weight:bold; text-align:center; }
.action-text { width:100%; font-size:28px; line-height:36px; color:#ffffff; font-weight:bold; text-align:center; }
.disabled-text { color:#8c8c8c; }
</style>
