<template>
  <div class="page">
    <img if="{{stateReady && !loading && !loadError && paired && activated && cloudScripts.length === 0}}" src="/common/images/empty.png" class="empty-img" />
    <text if="{{stateReady && !loading && !loadError && paired && activated && cloudScripts.length === 0}}" class="empty-text">云空间为空</text>
    <text if="{{loading || checkingState || !stateReady}}" class="state-text">正在读取云空间...</text>
    <text elif="{{loadError}}" class="state-text" @click="loadFiles">{{loadErrorText}}</text>
    <text elif="{{stateReady && !paired}}" class="state-text">请先配对设备</text>
    <text elif="{{stateReady && paired && !activated}}" class="state-text">请先在网页激活云空间</text>

    <list if="{{stateReady && paired && activated && !loading && !loadError}}" bounces="true" class="list">
      <list-item for="{{(index, script) in cloudScripts}}" tid="id" type="cloud-file"
        class="item {{selectedFileIndex === index ? 'item-selected' : ''}} {{busy ? 'disabled-item' : ''}}" @click="selectFile(index)">
        <text class="item-name {{busy ? 'disabled-text' : ''}}">{{script.name}}</text>
        <text class="item-meta {{busy ? 'disabled-text' : ''}}">更新时间：{{script.updatedText}}</text>
      </list-item>
    </list>

    <img static src="/common/images/hd.png" class="header" />
    <text class="time-text">{{nowTime}}</text>
    <text class="heading">云空间</text>
    <img static src="/common/images/back.png" class="btn top-left" @click="goBack" />
    <img src="/common/images/rerun.png" class="btn top-right {{loading || checkingState || busy ? 'disabled-icon' : ''}}" @click="loadFiles" />

    <img if="{{selectedFileIndex !== -1}}" src="/common/images/download.png" class="btn action-left {{busy ? 'disabled-icon' : ''}}" @click="downloadSelected" />
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/save.png" class="btn action-center {{busy ? 'disabled-icon' : ''}}" @click="saveAsSelected" />
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/delete.png" class="btn action-right {{busy ? 'disabled-icon' : ''}}" @click="removeSelected" />
    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import { errorMessage } from '../../../../utils/cloud/cloudError.js';
import { startNetworkFeedback, updateNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../../../utils/core/networkFeedback.js';
import { back } from '../../../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../../utils/core/time.js';
import { enterNetworkPage } from '../../../../utils/cloud/serverSelection.js';
export default {
  private: {
    paired: false,
    activated: false,
    loading: false,
    checkingState: false,
    stateReady: false,
    initialized: false,
    busy: false,
    networkStatus: '',
    networkStage: '',
    loadError: false,
    loadErrorText: '云空间文件尚未读取，点击重新读取',
    cloudScripts: [],
    selectedFileIndex: -1,
    nowTime: '00:00',
    pageActive: true
  },
  onInit() {
    this.updateTime();
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    if (this.initialized) return;
    this.initialized = true;
    enterNetworkPage(this, () => this.loadFiles());
  },
  onHide() { stopPageClock(this); setNetworkFeedbackVisible(this, false); },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  formatUpdated(value) {
    const text = String(value || '').replace('T', ' ').replace('Z', '');
    return text ? text.slice(0, 16) : '未知';
  },
  loadFiles() {
    if (this.loading || this.checkingState || this.busy) return;
    const selected = this.cloudScripts[this.selectedFileIndex];
    const selectedId = selected ? selected.id : null;
    this.selectedFileIndex = -1;
    this.checkingState = true;
    this.stateReady = false;
    this.loadError = false;
    startNetworkFeedback(this, '正在检查云账户');
    this.$app.$def.getCloudClients().deviceAccount.getState().then(state => {
      if (!this.pageActive) return null;
      this.paired = state.paired;
      if (!state.paired) return null;
      this.loading = true;
      updateNetworkFeedback(this, '正在验证云空间');
      return this.$app.$def.getCloudClients().deviceAccount.getEntitlements().then(entitlement => {
        if (!this.pageActive) return null;
        this.activated = entitlement.cloudEnabled;
        if (this.activated) updateNetworkFeedback(this, '正在读取云文件列表');
        return this.activated ? this.$app.$def.getCloudClients().cloudFilesClient.listCloudScripts() : null;
      });
    }).then(scripts => {
      if (!this.pageActive) return;
      if (!scripts) {
        this.cloudScripts = [];
        this.selectedFileIndex = -1;
        return;
      }
      this.cloudScripts = scripts.map(script => Object.assign({}, script, {
        updatedText: this.formatUpdated(script.updated_at)
      }));
      this.selectedFileIndex = selectedId == null ? -1 : this.cloudScripts.findIndex(script => script.id === selectedId);
    }).catch(error => {
      if (!this.pageActive) return;
      this.loadError = true;
      this.loadErrorText = errorMessage(error, '读取云空间文件列表') + '，点击重新读取';
      this.selectedFileIndex = -1;
      showToast(errorMessage(error, '读取云空间文件列表'));
    }).then(() => {
      if (!this.pageActive) return;
      this.loading = false;
      this.checkingState = false;
      this.stateReady = true;
      stopNetworkFeedback(this);
    });
  },
  selectFile(index) {
    if (this.busy) return;
    vibrate('short');
    this.selectedFileIndex = this.selectedFileIndex === index ? -1 : index;
  },
  selectedFile() {
    if (this.loading || this.checkingState || this.loadError) return null;
    return this.selectedFileIndex === -1 ? null : this.cloudScripts[this.selectedFileIndex];
  },
  downloadSelected() {
    const script = this.selectedFile();
    if (!script || this.busy) return;
    this.busy = true;
    startNetworkFeedback(this, '正在下载云文件');
    this.$app.$def.getCloudClients().cloudFilesClient.downloadScript(script.id, script.name, false).then(() => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      this.busy = false;
      showToast('已下载 ' + script.name);
    }).catch(error => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      this.busy = false;
      if (error.message !== 'file_exists') {
        showToast(errorMessage(error, '下载云空间文件 ' + script.name));
        return;
      }
      this.$app.$def.openDialog('confirm', {
        title: '本地文件已存在',
        message: '覆盖本地同名文件？'
      }, this).then(result => {
        if (result.action === "confirm") {
          this.downloadOverwrite(script);
        }
      }).catch(error => {
        showToast(error.message || "无法打开对话框");
      });
    });
  },
  downloadOverwrite(script) {
    if (this.busy) return;
    this.busy = true;
    startNetworkFeedback(this, '正在覆盖本地文件');
    this.$app.$def.getCloudClients().cloudFilesClient.downloadScript(script.id, script.name, true).then(() => {
      if (!this.pageActive) return;
      showToast('已覆盖本地文件');
    }).catch(error => {
      if (this.pageActive) showToast(errorMessage(error, '覆盖本地文件 ' + script.name));
    }).then(() => {
      if (this.pageActive) { this.busy = false; stopNetworkFeedback(this); }
    });
  },
  saveAsSelected() {
    const script = this.selectedFile();
    if (!script || this.busy) return;
    this.$app.$def.openDialog('text', {
      title: '另存为',
      value: script.name,
      maxLength: 128,
      required: true
    }, this).then(result => {
      if (result.action === "confirm") {
        const name = result.value;
        this.saveAs(script, name);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  saveAs(script, name) {
    if (this.busy) return;
    let target = String(name || '').trim();
    if (!target) return;
    if (!/\.js$/i.test(target)) target += '.js';
    this.busy = true;
    startNetworkFeedback(this, '正在另存云文件');
    this.$app.$def.getCloudClients().cloudFilesClient.downloadScript(script.id, target, false).then(() => {
      if (!this.pageActive) return;
      showToast('已另存为 ' + target);
    }).catch(error => {
      if (!this.pageActive) return;
      showToast(error.message === 'file_exists' ? '另存云空间文件：本地已有同名文件 ' + target : errorMessage(error, '另存云空间文件为 ' + target));
    }).then(() => {
      if (this.pageActive) { this.busy = false; stopNetworkFeedback(this); }
    });
  },
  removeSelected() {
    const script = this.selectedFile();
    if (!script || this.busy) return;
    this.$app.$def.openDialog('confirm', {
      title: '删除云端文件',
      message: '只删除云空间文件，不影响本地和市场。'
    }, this).then(result => {
      if (result.action === "confirm") {
        this.removeCloud(script);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  removeCloud(script) {
    if (this.busy) return;
    this.busy = true;
    startNetworkFeedback(this, '正在删除云文件');
    this.$app.$def.getCloudClients().cloudFilesClient.deleteCloudScript(script.id).then(() => {
      if (!this.pageActive) return;
      this.selectedFileIndex = -1;
      this.busy = false;
      stopNetworkFeedback(this);
      showToast('已从云空间删除');
      this.loadFiles();
    }).catch(error => {
      if (!this.pageActive) return;
      this.busy = false;
      stopNetworkFeedback(this);
      showToast(errorMessage(error, '删除云空间文件 ' + script.name));
    });
  },
  goBack() {
    vibrate('short');
    back();
  },
  loadingTap() { return false; }
};
</script>

<style>
@import "../../../../common/styles/network-loading.css";
.page { width:336px; height:480px; background-color:#000000; color:#ffffff; text-align:center; overflow:hidden; }
.list { position:absolute; left:0px; top:0px; width:336px; height:480px; padding:84px 6px 86px; }
.item { width:100%; height:138px; padding:12px 20px; margin-bottom:8px; background-color:#262626; border-radius:36px; flex-direction:column; justify-content:space-between; }
.item-selected { background-color:#0D6EFF; }
.disabled-item { background-color:#303030; }
.item-name { width:100%; font-size:32px; line-height:40px; font-weight:bold; color:#ffffff; text-overflow:ellipsis; lines:1; }
.item-meta { width:100%; font-size:18px; line-height:27px; color:rgba(255,255,255,0.6); text-overflow:ellipsis; lines:1; }
.disabled-text { color:#8c8c8c; }
.empty-img { position:absolute; left:104px; top:146px; width:128px; height:128px; }
.empty-text { position:absolute; left:0px; top:298px; width:336px; line-height:42px; font-size:32px; font-weight:bold; color:#ffffff; text-align:center; }
.state-text { position:absolute; left:18px; top:180px; width:300px; line-height:32px; font-size:22px; lines:6; text-overflow:ellipsis; font-weight:bold; color:#ffffff; text-align:center; }
.header { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.heading { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:32px; font-weight:bold; color:#ffffff; text-align:center; }
.btn { position:absolute; width:72px; height:72px; }
.disabled-icon { background-color:#303030; border-radius:36px; }
.top-left { left:6px; top:6px; }
.top-right { left:258px; top:6px; }
.action-left { left:6px; top:402px; }
.action-center { left:132px; top:402px; }
.action-right { left:258px; top:402px; }
</style>
