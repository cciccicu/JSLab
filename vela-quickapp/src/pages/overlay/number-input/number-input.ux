<template>
  <div class="page">
    <div class="input-card">
      <text class="note {{error ? 'error' : ''}}">{{error || dialog.message || '请输入数字'}}</text>
      <text class="input-value number-value">{{inputValue || '空'}}_</text>
      <text class="note">{{dialog.confirmText}}：右上角勾选</text>
    </div>
    <div class="keys">
      <div class="key-row">
        <text class="key" @click="input('7')">7</text>
        <text class="key" @click="input('8')">8</text>
        <text class="key" @click="input('9')">9</text>
      </div>
      <div class="key-row">
        <text class="key" @click="input('4')">4</text>
        <text class="key" @click="input('5')">5</text>
        <text class="key" @click="input('6')">6</text>
      </div>
      <div class="key-row">
        <text class="key" @click="input('1')">1</text>
        <text class="key" @click="input('2')">2</text>
        <text class="key" @click="input('3')">3</text>
      </div>
      <div class="key-row">
        <text class="key {{dialog.min >= 0 ? 'disabled' : ''}}" @click="input('-')">-</text>
        <text class="key" @click="input('0')">0</text>
        <text class="key {{dialog.decimals === 0 ? 'disabled' : ''}}" @click="input('.')">.</text>
      </div>
      <div class="key-row">
        <text class="key key-wide" @click="input('clear')">清空</text>
        <text class="key key-wide" @click="input('del')">退格</text>
      </div>
    </div>
    <img static src="/common/images/hd.png" class="topbar-bg" />
    <text class="time-text">{{nowTime}}</text>
    <text if="{{dialog.title.length <= 5}}" class="title-text">{{dialog.title}}</text>
    <marquee if="{{dialog.title.length > 5}}" class="title-text" scrollamount="4" loop="-1">{{dialog.title}}</marquee>
    <img static src="/common/images/back.png" class="btn btn-back" @click="onCancel" />
    <img static src="/common/images/conform.png" class="btn btn-confirm" @click="onConfirm" />
  </div>
</template>
<script>
import { back } from '../../../utils/core/routeManager.js';
import { vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
export default {
  protected: { dialogId: '' },
  private: { dialog:{id:'',type:'' ,title:'',message:'',confirmText:'确认',cancelText:'取消',secondaryText:''}, nowTime:'00:00', error:'', closing:false, invalid:false,inputValue:'', replaceOnInput:true },
  onInit() {
    const data=this.$app.$def.getDialog('number', this.dialogId);
    if (!data) { this.invalid=true; return; }
    this.dialog=data;
    this.inputValue=data.value;
    this.nowTime=getCurrentClock();
  },
  onReady() {
    if (this.invalid) {
      // Release only the request that opened this page, before native return.
      this.$app.$def.dialogDestroyed({ id:this.dialogId });
      this.closing=true; back();
    }
  },
  onShow() { startPageClock(this); },
  onHide() { stopPageClock(this); },
  onDestroy() {
    stopPageClock(this); this.$app.$def.dialogDestroyed(this.dialog);  },
  close(action,value) {
    if (this.closing || this.invalid) return;
    this.closing=true; vibrate('short');
    this.$app.$def.settleDialog(this.dialog,action,value); back();
  },
  onCancel() { this.close('cancel',null); },
  onBackPress() { this.onCancel(); return true; },
  input(key) {
    vibrate('short'); this.error='';
    if (key === 'clear') { this.inputValue=''; this.replaceOnInput=false; return; }
    if (key === 'del') { this.inputValue=this.replaceOnInput ? '' : this.inputValue.slice(0,-1); this.replaceOnInput=false; return; }
    if (key === '-' && this.dialog.min !== undefined && this.dialog.min >= 0) return;
    if (key === '.' && this.dialog.decimals === 0) return;
    if (this.replaceOnInput) { this.inputValue=''; this.replaceOnInput=false; }
    if (key === '-') { this.inputValue=this.inputValue.charAt(0) === '-' ? this.inputValue.slice(1) : '-'+this.inputValue; return; }
    if (key === '.' && this.inputValue.indexOf('.') >= 0) return;
    const next=this.inputValue+key;
    const parts=next.replace('-','').split('.');
    if (parts[0].length > 15 || (parts[1] && parts[1].length > this.dialog.decimals)) { this.error='已达到位数限制'; return; }
    this.inputValue=key === '.' && (this.inputValue === '' || this.inputValue === '-') ? this.inputValue+'0.' : next;
  },
  onConfirm() {
    if (!this.inputValue) { if (this.dialog.required) { this.error='请输入数字'; return; } this.close('confirm',null); return; }
    const value=Number(this.inputValue);
    const fraction=this.inputValue.split('.')[1] || '';
    if (!isFinite(value) || this.inputValue === '-' || fraction.length > this.dialog.decimals) { this.error='数字格式无效'; return; }
    if ((this.dialog.min !== undefined && value < this.dialog.min) || (this.dialog.max !== undefined && value > this.dialog.max)) { this.error='数字超出允许范围'; return; }
    this.close('confirm',value);
  }

};
</script>
<style>
@import "../../../common/styles/dialog.css";
.input-card { height:102px; }
.key-wide { width:160px; }
</style>
