<template>
  <div class="page" style="flex-direction: column;">
  
    <list bounces="true" class="list">
      <list-item for="{{(index, file) in fileList}}" tid="name" class="item {{selectedFileIndex === index ? 'item2' : ''}}"
        @click="selectFile(index)" type="nook">
        <text class="itemtext">{{file.name}}</text>
        <text class="itemmeta">大小：{{file.sizeText}}</text>
        <text class="itemmeta">最终修改日期：{{file.modifiedText}}</text>
      </list-item>
    </list>
  
    <img if="{{fileListReady && !fileListError && fileList.length == 0}}" src="/common/images/empty.png" class="empty-img" />
    <text if="{{fileListError && fileList.length == 0}}" class="empty-text" @click="loadFileList">{{fileListErrorText}}</text>
    <text elif="{{fileListReady && fileList.length == 0}}" class="empty-text">啥也没有</text>

    <img static src="/common/images/hd.png" class="header-img" />
    <img static src="/common/images/back.png" class="btn" style="left: 6px;top: 6px;" @click="exit" />
    <img static src="/common/images/more.png" class="btn" style="left: 258px;top: 6px;" @click="routerTo('settings')" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">JSLab</text>
  
    <!-- 底部按钮根据选择状态显示 -->
    <img if="{{selectedFileIndex === -1}}" src="/common/images/market.png" style="left: 6px;top: 402px;" class="btn" @click="routerTo('toolsMarket')"/>
    <img if="{{selectedFileIndex === -1}}" src="/common/images/cloud.png" style="left: 132px;top: 402px;" class="btn" @click="routerTo('settingsCloudFiles')"/>
    <img if="{{selectedFileIndex === -1}}" src="/common/images/add.png" style="left: 258px;top: 402px;" class="btn" @click="routerTo('newFile')"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/run.png" style="left: 6px;top: 402px;" class="btn" @click="runcode"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/upload.png" style="left: 90px;top: 402px;" class="btn {{cloudBusy ? 'disabled-icon' : ''}}" @click="uploadSelected"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/edit.png" style="left: 174px;top: 402px;" class="btn" @click="editcode"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/delete.png" style="left: 258px;top: 402px;" class="btn" @click="handleDeleteClick"/>
  
  </div>
</template>

<script>
import app from '@system.app';
import jsManager from '../../utils/files/jsManager.js';
import { push } from '../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../utils/core/uiFeedback.js';
import { getCurrentClock } from '../../utils/core/time.js';
import { formatFileSize, formatModifiedDate, utf8ByteLength } from '../../utils/files/fileMetadata.js';
import { getConfiguredEditorRoute } from '../../utils/editor/editorVersion.js';
import cloudService from '../../utils/cloud/cloudService.js';
import { formatError } from '../../utils/core/userError.js';

export default {
  private: {
    fileList: [],
    selectedFileIndex: -1,
    nowTime: "00:00",
    timer: null,
    fileChangeUnsubscribe: null,
    cloudBusy: false,
    pageActive: true,
    fileListReady: false,
    fileListError: false,
    fileListErrorText: '脚本目录尚未读取，点击重新读取',
    fileListRequestId: 0
  },

  exit() {
    vibrate('short');
    app.terminate();
  },

  updateTime() {
    this.nowTime = getCurrentClock();
  },

  onInit() {
    this.updateTime();
    this.fileChangeUnsubscribe = jsManager.subscribe(() => {
      this.loadFileList(true);
    });
    this.timer = setInterval(() => {
      this.updateTime();
    }, 60000);
  },

  onDestroy() {
    this.pageActive = false;
    clearInterval(this.timer);
    if (this.fileChangeUnsubscribe) {
      this.fileChangeUnsubscribe();
      this.fileChangeUnsubscribe = null;
    }
  },

  onShow() {
    this.loadFileList();
  },

  loadFileList(preserveSelection = false) {
    const requestId = this.fileListRequestId + 1;
    this.fileListRequestId = requestId;
    const selectedName = preserveSelection && this.fileList[this.selectedFileIndex]
      ? this.fileList[this.selectedFileIndex].name
      : '';
    this.fileListError = false;
    jsManager.list().then(fileList => {
      if (!this.pageActive || requestId !== this.fileListRequestId) return;
      this.fileList = fileList.map(fileInfo => Object.assign({}, fileInfo, {
        sizeText: formatFileSize(fileInfo.size),
        modifiedText: formatModifiedDate(fileInfo.lastModifiedTime)
      }));
      this.selectedFileIndex = selectedName
        ? this.fileList.findIndex(fileInfo => fileInfo.name === selectedName)
        : -1;
      this.fileListReady = true;
      this.fileListError = false;
    }).catch(error => {
      if (!this.pageActive || requestId !== this.fileListRequestId) return;
      console.error("获取文件列表失败:", error);
      this.fileListReady = true;
      this.fileListError = true;
      this.fileListErrorText = formatError(error, '读取本地脚本目录') + '，点击重新读取';
      showToast(formatError(error, '读取本地脚本目录'));
    });
  },

  selectFile(index) {
    vibrate('short');
    if (this.selectedFileIndex === index) {
      this.selectedFileIndex = -1;
    } else {
      this.selectedFileIndex = index;
    }
  },

  routerTo(page) {
    vibrate('short');
    push(page);
  },

  runcode() {
    // 在这里直接使用震动API
    vibrate('short');
    
    if (this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) {
      showToast('请先选择一个文件');
      return;
    }
    const fileName = this.fileList[this.selectedFileIndex].name;
    jsManager.read(fileName)
      .then(content => {
        this.$app.$def.openEditor(fileName, content, 'run');
        this.$app.$def.openRunner(fileName, content);
      })
      .catch(error => {
        console.error(`读取文件 ${fileName} 失败:`, error.message);
        if (error.message.includes('301')) {
          showToast(`文件 ${fileName} 不存在`);
        } else {
          showToast(formatError(error, '读取本地脚本 ' + fileName));
        }
      });
  },

  editcode() {
    // 在这里直接使用震动API
    vibrate('short');
    
    if (this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) {
      showToast('请先选择一个文件');
      return;
    }
    const fileName = this.fileList[this.selectedFileIndex].name;
    jsManager.read(fileName)
      .then(content => {
        if (utf8ByteLength(content) > 48 * 1024) {
          showToast('脚本超过 48 KiB，无法在手环编辑器中打开');
          return;
        }
        this.$app.$def.openEditor(fileName, content, 'edit');
        getConfiguredEditorRoute().then(route => push(route)).catch(() => push('editor'));
      })
      .catch(error => {
        console.error(`读取文件 ${fileName} 失败:`, error.message);
        if (error.message.includes('301')) {
          showToast(`文件 ${fileName} 不存在`);
        } else {
          showToast(formatError(error, '读取本地脚本 ' + fileName));
        }
      });
  },

  uploadSelected() {
    if (this.cloudBusy || this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) return;
    vibrate('short');
    const file = this.fileList[this.selectedFileIndex];
    this.cloudBusy = true;
    cloudService.getState().then((state) => {
      if (!state.paired) throw new Error('not_paired');
      return cloudService.getEntitlements();
    }).then((entitlement) => {
      if (!entitlement.cloudEnabled) throw new Error('activation_required');
      return cloudService.listCloudScripts();
    }).then((scripts) => {
      const existing = scripts.find((script) => script.name === file.name);
      this.cloudBusy = false;
      if (existing) {
        const opened = this.$app.$def.openDialog('confirm', {
          title: '云空间已有同名文件',
          message: '上传会替换云空间中的当前内容，是否继续？',
          callbacks: { onConfirm: () => this.performUpload(file.name) }
        });
        if (!opened) showToast('当前有其他操作待处理');
        return;
      }
      this.performUpload(file.name);
    }).catch((error) => {
      this.cloudBusy = false;
      showToast(cloudService.errorMessage(error, '检查上传目标云空间'));
    });
  },

  performUpload(fileName) {
    if (this.cloudBusy) return;
    this.cloudBusy = true;
    cloudService.uploadScript(fileName).then(() => {
      showToast('已上传 ' + fileName);
    }).catch((error) => {
      showToast(cloudService.errorMessage(error, '上传脚本 ' + fileName));
    }).then(() => { this.cloudBusy = false; });
  },

  handleDeleteClick() {
    vibrate('short');
    if (this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) {
      showToast('请先选择一个文件');
      return;
    }
    const fileName = this.fileList[this.selectedFileIndex].name;
    const opened = this.$app.$def.openDialog('confirm', {
      title: '删除本地文件',
      message: '确认删除 ' + fileName + '？此操作不会删除云端文件。',
      callbacks: { onConfirm: () => this.removeFile(fileName) }
    });
    if (!opened) showToast('当前有其他操作待处理');
  },

  removeFile(fileName) {
    jsManager.remove(fileName).then(() => {
      if (this.pageActive) showToast(`文件 ${fileName} 已删除`, 500);
    }).catch(error => {
      if (!this.pageActive) return;
      console.error(`删除文件 ${fileName} 失败:`, error.message);
      showToast(formatError(error, '删除本地脚本 ' + fileName));
    });
  }
};
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  color: white;
  text-align: center;
}

/* 顶部 */
.header-img {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 102px;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  font-weight: bold;
  font-size: 24px;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}

.btn {
  position: absolute;
  width: 72px;
  height: 72px;
}

.list {
  width: 336px;
  height: 480px;
  position: absolute;
  top: 0px;
  left: 0px;
  padding: 86px 6px 86px;
}

.item {
  width: 100%;
  height: 112px;
  padding: 10px 18px;
  margin-bottom: 8px;
  background-color: #262626;
  border-radius: 36px;
  flex-direction: column;
  justify-content: space-between;
}

.item2 {
  background-color: #0D6EFF;
}

.empty-img {
  position: absolute;
  left: 104px;
  top: 146px;
  width: 128px;
  height: 128px;
}

.empty-text {
  position: absolute;
  left: 0px;
  top: 298px;
  width: 336px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}

.itemtext {
  font-size: 28px;
  line-height: 34px;
  width: 100%;
  font-weight: bold;
  color: white;
  text-overflow: ellipsis;
  lines: 1;
}

.itemmeta {
  width: 100%;
  font-size: 16px;
  line-height: 22px;
  color: rgba(255,255,255,0.6);
  text-overflow: ellipsis;
  lines: 1;
}

.disabled-icon {
  background-color: #303030;
  border-radius: 36px;
}
</style>
