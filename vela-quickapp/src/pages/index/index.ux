<template>
  <div class="page" style="flex-direction: column;">

    <list bounces="true" class="list">
      <list-item for="{{(index, file) in fileList}}" tid="name" class="item {{selectedFileIndex === index ? 'item2' : ''}}"
        @click="selectFile(index)" type="nook">
        <text class="itemtext">{{file.name}}</text>
        <text class="itemmeta">大小：{{file.sizeText}}</text>
        <text class="itemmeta">最终修改日期：{{file.modifiedText}}</text>
      </list-item>
    </list>

    <img if="{{fileListReady && !fileListError && fileList.length == 0}}" src="/common/images/empty.png" class="empty-img" />
    <text if="{{fileListError && fileList.length == 0}}" class="empty-text error-state" @click="loadFileList">{{fileListErrorText}}</text>
    <text elif="{{fileListReady && fileList.length == 0}}" class="empty-text">暂无脚本</text>

    <img static src="/common/images/hd.png" class="header-img" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">JSLab</text>
    <img static src="/common/images/back.png" class="btn" style="left: 6px;top: 6px;" @click="exit" />
    <img static src="/common/images/more.png" class="btn" style="left: 258px;top: 6px;" @click="routerTo('settings')" />

    <!-- 底部按钮根据选择状态显示 -->
    <img if="{{selectedFileIndex === -1}}" src="/common/images/market.png" style="left: 6px;top: 402px;" class="btn" @click="routerTo('toolsMarket')"/>
    <img if="{{selectedFileIndex === -1}}" src="/common/images/cloud.png" style="left: 132px;top: 402px;" class="btn" @click="routerTo('settingsCloudFiles')"/>
    <img if="{{selectedFileIndex === -1}}" src="/common/images/add.png" style="left: 258px;top: 402px;" class="btn" @click="routerTo('newFile')"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/run.png" style="left: 6px;top: 402px;" class="btn {{fileActionBusy || cloudBusy ? 'disabled-icon' : ''}}" @click="runSelected"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/upload.png" style="left: 90px;top: 402px;" class="btn {{fileActionBusy || cloudBusy ? 'disabled-icon' : ''}}" @click="uploadSelected"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/edit.png" style="left: 174px;top: 402px;" class="btn {{fileActionBusy || cloudBusy ? 'disabled-icon' : ''}}" @click="editSelected"/>
    <img if="{{selectedFileIndex !== -1}}" src="/common/images/delete.png" style="left: 258px;top: 402px;" class="btn {{fileActionBusy || cloudBusy ? 'disabled-icon' : ''}}" @click="handleDeleteClick"/>

    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>

  </div>
</template>

<script>
import app from '@system.app';
import { push } from '../../utils/core/routeManager.js';
import { showToast, vibrate } from '../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../utils/core/time.js';
import { formatFileSize, formatModifiedDate } from '../../utils/files/fileMetadata.js';
import { utf8ByteLength } from '../../utils/files/textEncoding.js';
import { errorMessage } from '../../utils/cloud/cloudError.js';
import { startNetworkFeedback, updateNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../utils/core/networkFeedback.js';
import { formatError } from '../../utils/core/userError.js';
import { IS_ASTROBOX_EDITION, showAstroBoxRestriction } from '../../utils/core/edition.js';
import { chooseServer } from '../../utils/cloud/serverSelection.js';
export default {
  private: {
    fileList: [],
    selectedFileIndex: -1,
    nowTime: "00:00",
    fileChangeUnsubscribe: null,
    cloudBusy: false,
    networkStatus: '',
    networkStage: '',
    fileActionBusy: false,
    pageActive: true,
    pageVisible: false,
    fileListReady: false,
    fileListError: false,
    fileListErrorText: '脚本目录尚未读取，点击重新读取',
    fileListRequestId: 0
  },
  exit() {
    vibrate('short');
    app.terminate();
  },
  loadingTap() { return false; },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  onInit() {
    this.updateTime();
    this.fileChangeUnsubscribe = this.$app.$def.getScriptManager().subscribe(() => {
      if (this.pageVisible) this.loadFileList(true);
    });
  },
  onHide() { stopPageClock(this); setNetworkFeedbackVisible(this, false); this.pageVisible = false; },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
    if (this.fileChangeUnsubscribe) {
      this.fileChangeUnsubscribe();
      this.fileChangeUnsubscribe = null;
    }
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    this.pageVisible = true;
    if (this.$app.$def.deliverDialog(this)) { this.updateTime(); return; }
    this.loadFileList();
  },
  loadFileList(preserveSelection = false) {
    const requestId = this.fileListRequestId + 1;
    this.fileListRequestId = requestId;
    const selectedName = preserveSelection && this.fileList[this.selectedFileIndex] ? this.fileList[this.selectedFileIndex].name : '';
    this.fileListError = false;
    this.$app.$def.getScriptManager().list().then(fileList => {
      if (!this.pageActive || requestId !== this.fileListRequestId) return;
      this.fileList = fileList.map(fileInfo => Object.assign({}, fileInfo, {
        sizeText: formatFileSize(fileInfo.size),
        modifiedText: formatModifiedDate(fileInfo.lastModifiedTime)
      }));
      this.selectedFileIndex = selectedName ? this.fileList.findIndex(fileInfo => fileInfo.name === selectedName) : -1;
      this.fileListReady = true;
      this.fileListError = false;
    }).catch(error => {
      if (!this.pageActive || requestId !== this.fileListRequestId) return;
      console.error("获取文件列表失败:", error);
      this.fileListReady = true;
      this.fileListError = true;
      this.fileListErrorText = formatError(error, '读取本地脚本目录') + '，点击重新读取';
      showToast(formatError(error, '读取本地脚本目录'));
    });
  },
  selectFile(index) {
    if (this.fileActionBusy || this.cloudBusy) return;
    vibrate('short');
    if (this.selectedFileIndex === index) {
      this.selectedFileIndex = -1;
    } else {
      this.selectedFileIndex = index;
    }
  },
  routerTo(page) {
    vibrate('short');
    if (IS_ASTROBOX_EDITION && page === 'settingsCloudFiles') {
      showAstroBoxRestriction(this).catch(error => console.error('无法显示版本说明:', error));
      return;
    }
    push(page);
  },
  runSelected() { this.openSelected('run'); },
  editSelected() { this.openSelected('edit'); },
  openSelected(action) {
    if (this.fileActionBusy || this.cloudBusy) return;
    vibrate('short');
    if (this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) {
      showToast('请先选择一个文件');
      return;
    }
    const fileName = this.fileList[this.selectedFileIndex].name;
    this.fileActionBusy = true;
    this.$app.$def.getScriptManager().read(fileName).then(content => {
      if (!this.pageActive || !this.pageVisible) return;
      if (action === 'run') { this.$app.$def.openRunner(fileName, content); return; }
      if (utf8ByteLength(content) > 48 * 1024) {
        showToast('脚本超过 48 KiB，无法在手环编辑器中打开');
        return;
      }
      this.$app.$def.openEditor(fileName, content);
      push('editor');
    }).catch(error => {
      if (!this.pageActive || !this.pageVisible) return;
      console.error(`读取文件 ${fileName} 失败:`, error.message);
      showToast(formatError(error, '打开本地脚本 ' + fileName));
    }).then(() => { if (this.pageActive) this.fileActionBusy = false; });
  },
  uploadSelected() {
    if (this.cloudBusy || this.fileActionBusy || this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) return;
    vibrate('short');
    if (IS_ASTROBOX_EDITION) {
      showAstroBoxRestriction(this).catch(error => console.error('无法显示版本说明:', error));
      return;
    }
    chooseServer(this).then(selected => {
      if (selected && this.pageActive) this.uploadSelectedToCloud();
    }).catch(error => showToast(error && error.message ? error.message : '无法选择服务器'));
  },
  uploadSelectedToCloud() {
    if (this.cloudBusy || this.fileActionBusy || this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) return;
    const file = this.fileList[this.selectedFileIndex];
    this.cloudBusy = true;
    startNetworkFeedback(this, '正在检查云空间');
    this.$app.$def.getCloudClients().deviceAccount.getState().then(state => {
      if (!state.paired) throw new Error('not_paired');
      return this.$app.$def.getCloudClients().deviceAccount.getEntitlements();
    }).then(entitlement => {
      if (!entitlement.cloudEnabled) throw new Error('activation_required');
      updateNetworkFeedback(this, '正在读取云文件列表');
      return this.$app.$def.getCloudClients().cloudFilesClient.listCloudScripts();
    }).then(scripts => {
      if (!this.pageActive) return;
      const existing = scripts.find(script => script.name === file.name);
      this.cloudBusy = false;
      stopNetworkFeedback(this);
      if (existing) {
        this.$app.$def.openDialog('confirm', {
          title: '云空间已有同名文件',
          message: '上传会替换云空间中的当前内容，是否继续？'
        }, this).then(result => {
          if (result.action === "confirm") {
            this.performUpload(file.name);
          }
        }).catch(error => {
          showToast(error.message || "无法打开对话框");
        });
        return;
      }
      this.performUpload(file.name);
    }).catch(error => {
      if (!this.pageActive) return;
      this.cloudBusy = false;
      stopNetworkFeedback(this);
      showToast(errorMessage(error, '检查上传目标云空间'));
    });
  },
  performUpload(fileName) {
    if (this.cloudBusy) return;
    this.cloudBusy = true;
    startNetworkFeedback(this, '正在上传脚本');
    this.$app.$def.getCloudClients().cloudFilesClient.uploadScript(fileName).then(() => {
      if (this.pageActive) showToast('已上传 ' + fileName);
    }).catch(error => {
      if (this.pageActive) showToast(errorMessage(error, '上传脚本 ' + fileName));
    }).then(() => {
      if (this.pageActive) { this.cloudBusy = false; stopNetworkFeedback(this); }
    });
  },
  handleDeleteClick() {
    if (this.cloudBusy || this.fileActionBusy) return;
    vibrate('short');
    if (this.selectedFileIndex === -1 || !this.fileList[this.selectedFileIndex]) {
      showToast('请先选择一个文件');
      return;
    }
    const fileName = this.fileList[this.selectedFileIndex].name;
    this.$app.$def.openDialog('confirm', {
      title: '删除本地文件',
      message: '确认删除 ' + fileName + '？保存的数据和配置也会删除；云端文件不受影响。'
    }, this).then(result => {
      if (result.action === "confirm") {
        this.removeFile(fileName);
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  removeFile(fileName) {
    this.$app.$def.getScriptManager().remove(fileName).then(() => {
      if (this.pageActive) showToast(`文件 ${fileName} 已删除`, 500);
    }).catch(error => {
      if (!this.pageActive) return;
      console.error(`删除文件 ${fileName} 失败:`, error.message);
      showToast(formatError(error, '删除本地脚本 ' + fileName));
    });
  }
};
</script>

<style>
@import "../../common/styles/network-loading.css";
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  color: white;
  text-align: center;
}

/* 顶部 */
.header-img {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 84px;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  font-weight: bold;
  font-size: 24px;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}

.btn {
  position: absolute;
  width: 72px;
  height: 72px;
}

.list {
  width: 336px;
  height: 480px;
  position: absolute;
  top: 0px;
  left: 0px;
  padding: 84px 6px 86px;
}

.item {
  width: 100%;
  height: 112px;
  padding: 10px 18px;
  margin-bottom: 8px;
  background-color: #262626;
  border-radius: 36px;
  flex-direction: column;
  justify-content: space-between;
}

.item2 {
  background-color: #0D6EFF;
}

.empty-img {
  position: absolute;
  left: 104px;
  top: 146px;
  width: 128px;
  height: 128px;
}

.empty-text {
  position: absolute;
  left: 0px;
  top: 298px;
  width: 336px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}

.error-state { left:18px; top:200px; width:300px; font-size:22px; line-height:30px; lines:6; text-overflow:ellipsis; }

.itemtext {
  font-size: 28px;
  line-height: 34px;
  width: 100%;
  font-weight: bold;
  color: white;
  text-overflow: ellipsis;
  lines: 1;
}

.itemmeta {
  width: 100%;
  font-size: 16px;
  line-height: 22px;
  color: rgba(255,255,255,0.6);
  text-overflow: ellipsis;
  lines: 1;
}

.disabled-icon {
  background-color: #303030;
  border-radius: 36px;
}
</style>
