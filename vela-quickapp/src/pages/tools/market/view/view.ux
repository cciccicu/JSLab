<template>
  <div class="page">
    <scroll class="body" scroll-y="true">
      <div if="{{statusText}}" class="status-card">

        <text class="status-text {{reviewReason ? 'review-text' : ''}}">{{statusText}}</text>

      </div>
      <div if="{{script}}" class="source-card">
        <text class="script-name">{{script.name}}</text>
        <text class="script-meta">{{script.description || '没有说明'}}</text>
        <text class="script-meta">作者：{{script.authorName || '未知'}} · {{statusLabel}}</text>
        <text class="script-meta">适配设备：{{script.deviceLabel}}</text>
        <text class="script-meta">下载 {{script.downloadCount}} · 点赞 {{script.likeCount}}</text>
      </div>
      <div if="{{script}}" class="code-card">

        <text for="{{chunk in sourceChunks}}" tid="id" class="source">{{chunk.text}}</text>

      </div>
      <div class="footer-spacer"></div>
    </scroll>
    <img static src="/common/images/hd.png" class="header" />
    <text class="time-text">{{nowTime}}</text>
    <text class="heading">查看脚本</text>
    <img static src="/common/images/back.png" class="btn back" @click="goBack" />
    <img if="{{script}}" src="/common/images/download.png" class="action action-download {{script.canLike && !isMineView ? 'action-download-with-like' : ''}}" @click="download" />
    <img if="{{script && script.canLike && !script.liked}}" src="/common/images/market-like.png" class="action action-like {{isMineView ? 'action-like-last' : ''}}" @click="like" />
    <img if="{{script && script.canLike && script.liked}}" src="/common/images/market-liked.png" class="action action-like {{isMineView ? 'action-like-last' : ''}}" @click="like" />
    <img if="{{script && !isMineView}}" src="/common/images/market-report.png" class="action action-report" @click="report" />
    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import { confirmMarketDownload } from "../../../../utils/cloud/marketDevices.js";
import { back } from '../../../../utils/core/routeManager.js';
import { errorMessage } from '../../../../utils/cloud/cloudError.js';
import { normalizeMarketSaveName, suggestMarketFilename } from '../../../../utils/cloud/marketFilename.js';
import { startNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../../../utils/core/networkFeedback.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../../utils/core/time.js';
import { enterNetworkPage } from '../../../../utils/cloud/serverSelection.js';
export default {
  protected: {
    marketId: '',
    mine: '0'
  },
  private: {
    script: null,
    sourceChunks: [],
    statusLabel: '',
    statusText: '正在读取脚本...',
    reviewReason: '',
    loading: false,
    busy: false,
    initialized: false,
    pageActive: true,
    networkStatus: '',
    networkStage: '',
    nowTime: '00:00',
    isMineView: false
  },
  onInit() {
    this.nowTime = getCurrentClock();
    this.isMineView = this.mine === true || this.mine === '1' || this.mine === 'true';
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    this.$app.$def.deliverDialog(this);
    if (!this.initialized) {
      this.initialized = true;
      enterNetworkPage(this, () => this.load());
    }
  },
  onHide() {
    stopPageClock(this);
    setNetworkFeedbackVisible(this, false);
  },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.pageActive = false;
    this.$app.$def.cancelOwnedDialog(this);
  },
  load() {
    const id = Number(this.marketId);
    if (!Number.isSafeInteger(id) || id <= 0) {
      this.statusText = '脚本编号无效';
      return;
    }
    this.loading = true;
    this.statusText = '正在读取脚本...';
    startNetworkFeedback(this, '正在读取市场脚本');
    this.$app.$def.getCloudClients().marketClient.getMarketScript(id, this.isMineView).then(script => {
      if (!this.pageActive) return;
      this.sourceChunks = this.chunkSource(script.source);
      this.statusLabel = script.statusText || {
        pending: '待审核',
        published: '已发布',
        rejected: '已拒绝',
        draft: '草稿'
      }[script.status] || '状态未知';
      this.script = {
        id: script.id,
        name: script.name,
        description: script.description,
        authorName: script.authorName,
        supportedDevices: script.supportedDevices,
        deviceLabel: script.deviceLabel,
        downloadCount: script.downloadCount,
        likeCount: script.likeCount,
        liked: script.liked,
        canLike: script.publishedStatus === 'published' || script.status === 'published'
      };
      this.reviewReason = this.isMineView ? script.reviewReason || '' : '';
      this.statusText = this.reviewReason ? '审核拒绝原因：' + this.reviewReason : '';
    }).catch(error => {
      if (!this.pageActive) return;
      this.script = null;
      this.reviewReason = '';
      this.sourceChunks = [];
      this.statusText = errorMessage(error, '读取市场脚本');
    }).then(() => {
      if (!this.pageActive) return;
      this.loading = false;
      stopNetworkFeedback(this);
    });
  },
  chunkSource(source) {
    const chunks = [];
    let start = 0;
    let lineCount = 0;
    for (let index = 0; index < source.length; index++) {
      const isLineEnd = source.charCodeAt(index) === 10;
      if (isLineEnd) lineCount++;
      if (lineCount === 16 || index - start >= 511) {
        chunks.push({ id: String(start), text: source.slice(start, index + 1) });
        start = index + 1;
        lineCount = 0;
      }
    }
    if (start < source.length) chunks.push({ id: String(start), text: source.slice(start) });
    return chunks;
  },
  download() {
    if (!this.script || this.loading || this.busy) return;
    this.busy = true;
    vibrate('short');
    this.$app.$def.openDialog('text', {
      title: '下载脚本',
      message: '输入本地文件名，可省略 .js',
      value: suggestMarketFilename(this.script.name),
      maxLength: 128,
      required: true
    }, this).then(result => {
      if (!this.pageActive) return;
      if (result.action !== 'confirm') {
        this.busy = false;
        return;
      }
      let name;
      try {
        name = normalizeMarketSaveName(result.value);
      } catch (error) {
        this.busy = false;
        showToast(error.message);
        return;
      }
      this.save(name, false);
    }).catch(error => {
      if (this.pageActive) {
        this.busy = false;
        showToast(error.message || '无法打开对话框');
      }
    });
  },
  save(name, overwrite) {
    if (!this.script || !this.pageActive) return;
    startNetworkFeedback(this, overwrite ? '正在覆盖本地脚本' : '正在下载市场脚本');
    this.$app.$def.getCloudClients().marketClient.downloadMarketScript(this.script.id, name, overwrite, this.isMineView, source => confirmMarketDownload(this, source)).then(saved => {
      if (!this.pageActive) return;
      this.script = Object.assign({}, this.script, { downloadCount: saved.downloadCount, likeCount: saved.likeCount, liked: saved.liked });
      this.$app.$def.marketRefreshNeeded = true;
      stopNetworkFeedback(this);
      this.busy = false;
      showToast((overwrite ? '已覆盖 ' : '已下载 ') + saved.name);
    }).catch(error => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      if (error.message === 'market_download_cancelled') { this.busy = false; return; }
      if (error.message !== 'file_exists' || overwrite) {
        this.busy = false;
        showToast(errorMessage(error, '下载市场脚本'));
        return;
      }
      this.$app.$def.openDialog('confirm', {
        title: '本地文件已存在',
        message: '覆盖 ' + name + '？'
      }, this).then(result => {
        if (!this.pageActive) return;
        if (result.action === 'confirm') {
          this.save(name, true);
          return;
        }
        this.busy = false;
      }).catch(dialogError => {
        if (this.pageActive) {
          this.busy = false;
          showToast(dialogError.message || '无法打开对话框');
        }
      });
    });
  },
  like() {
    if (!this.script || !this.script.canLike || this.loading || this.busy) return;
    this.busy = true;
    vibrate('short');
    startNetworkFeedback(this, this.script.liked ? '正在取消点赞' : '正在点赞');
    this.$app.$def.getCloudClients().marketClient.likeMarketScript(this.script.id, !this.script.liked).then(stats => {
      if (!this.pageActive) return;
      this.script = Object.assign({}, this.script, stats);
      this.$app.$def.marketRefreshNeeded = true;
      showToast(stats.liked ? '已点赞' : '已取消点赞');
    }).catch(error => {
      if (this.pageActive) showToast(errorMessage(error, '更新点赞'));
    }).then(() => {
      if (!this.pageActive) return;
      this.busy = false;
      stopNetworkFeedback(this);
    });
  },
  report() {
    if (!this.script || this.loading || this.busy || this.isMineView) return;
    this.busy = true;
    vibrate('short');
    this.$app.$def.openDialog('text', {
      title: '举报脚本',
      message: '请说明举报原因',
      value: '',
      maxLength: 500,
      required: true
    }, this).then(result => {
      if (!this.pageActive) return;
      if (result.action !== 'confirm') {
        this.busy = false;
        return;
      }
      startNetworkFeedback(this, '正在提交举报');
      return this.$app.$def.getCloudClients().marketClient.reportMarketScript(this.script.id, result.value);
    }).then(result => {
      if (!this.pageActive || !result) return;
      stopNetworkFeedback(this);
      this.busy = false;
      showToast('举报已提交');
    }).catch(error => {
      if (this.pageActive) {
        stopNetworkFeedback(this);
        this.busy = false;
        showToast(errorMessage(error, '提交举报'));
      }
    });
  },
  goBack() {
    if (this.busy) {
      showToast('正在处理，请稍候');
      return;
    }
    vibrate('short');
    back();
  },
  onBackPress() {
    this.goBack();
    return true;
  },
  loadingTap() {
    return false;
  }
};
</script>

<style>
@import "./view.css";
</style>
