<template>
  <div class="page">
    <list if="{{stage === 'choose' && !loading && files.length > 0}}" bounces="true" class="file-list">
      <list-item for="{{(index, file) in files}}" tid="name" type="local-script" class="file-item" @click="selectScript(index)">
        <text class="file-name">{{file.name}}</text>
        <text class="file-hint">选择此本地脚本</text>
      </list-item>
    </list>
    <div if="{{stage === 'choose' && statusText}}" class="status-card">
      <text class="status-text">{{statusText}}</text>
    </div>
    <scroll if="{{stage === 'details'}}" class="details" scroll-y="true">
      <div class="source-card">
        <text class="field-label">本地脚本</text>
        <text class="field-value">{{selectedName}}</text>
      </div>
      <div class="field-card" @click="editField('marketName')">
        <text class="field-label">{{replacingMarket ? '市场名称 · 保持不变' : '市场名称 · 必填'}}</text>
        <text class="field-value">{{marketName || '点击填写名称'}}</text>
      </div>
      <div class="field-card field-tall" @click="editField('description')">
        <text class="field-label">{{replacingMarket ? '用途说明 · 保持不变' : '用途说明 · 必填'}}</text>
        <text class="field-value field-description">{{description || '点击填写用途和使用方法'}}</text>
      </div>
      <div class="field-card" @click="editField('tags')">
        <text class="field-label">{{replacingMarket ? '标签 · 保持不变' : '标签 · 可选'}}</text>
        <text class="field-value">{{tags || '用逗号分隔，最多 12 个'}}</text>
      </div>
      <div class="field-card" @click="selectDevices">
        <text class="field-label">适配设备 · 必填 · 可多选</text>
        <text class="field-value">{{devicesLabel || '点击选择 Pro / RW'}}</text>
      </div>
      <div class="note-card">
        <text class="note-text">{{replacingMarket ? '将替换当前市场脚本的源码，名称、说明和标签保持不变；审核通过后更新公开版本。' : '提交时读取本地脚本的当前源码。审核通过后，市场用户才能看到。'}}</text>
      </div>
      <div if="{{submissionText}}" class="note-card">
        <text class="note-text">{{submissionText}}</text>
      </div>
    </scroll>
    <img static src="/common/images/hd.png" class="header" />
    <text class="time-text">{{nowTime}}</text>
    <text class="heading">{{replacingMarket ? '重新上传' : '发布市场'}}</text>
    <img static src="/common/images/back.png" class="btn back" @click="goBack" />
    <img if="{{stage === 'details'}}" src="/common/images/conform.png" class="btn confirm {{busy ? 'disabled-icon' : ''}}" @click="submit" />
    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import { back } from '../../../../utils/core/routeManager.js';
import { errorMessage } from '../../../../utils/cloud/cloudError.js';
import { startNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../../../utils/core/networkFeedback.js';
import { showToast, vibrate } from '../../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../../utils/core/time.js';
import { formatError } from '../../../../utils/core/userError.js';
import { enterNetworkPage } from '../../../../utils/cloud/serverSelection.js';
import { MARKET_DEVICES, marketDevices, marketDeviceLabel } from '../../../../utils/cloud/marketDevices.js';
export default {
  protected: {
    marketId: '',
    marketTitle: '',
    marketDescription: '',
    marketTags: '',
    marketSupportedDevices: ''
  },
  private: {
    stage: 'choose',
    files: [],
    loading: false,
    initialized: false,
    busy: false,
    replacingMarket: false,
    statusText: '正在读取本地脚本...',
    networkStatus: '',
    networkStage: '',
    selectedName: '',
    marketName: '',
    description: '',
    tags: '',
    supportedDevices: [],
    devicesLabel: '',
    submissionText: '',
    nowTime: '00:00',
    pageActive: true
  },
  onInit() {
    this.nowTime = getCurrentClock();
    const marketId = Number(this.marketId);
    this.replacingMarket = Number.isSafeInteger(marketId) && marketId > 0;
    if (this.replacingMarket) {
      this.marketName = String(this.marketTitle || '');
      this.description = String(this.marketDescription || '');
      this.tags = this.normalizeMarketTags(this.marketTags);
      this.supportedDevices = marketDevices(this.marketSupportedDevices);
      this.devicesLabel = marketDeviceLabel(this.supportedDevices);
    }
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    this.$app.$def.deliverDialog(this);
    if (!this.initialized) {
      this.initialized = true;
      enterNetworkPage(this, () => this.load());
    }
  },
  onHide() {
    stopPageClock(this);
    setNetworkFeedbackVisible(this, false);
  },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.pageActive = false;
    this.$app.$def.cancelOwnedDialog(this);
  },
  load() {
    this.loading = true;
    this.statusText = '正在读取本地脚本...';
    startNetworkFeedback(this, '正在读取本地脚本');
    this.$app.$def.getScriptManager().list().then(files => {
      if (!this.pageActive) return;
      this.files = files;
      this.statusText = files.length ? '' : '本地脚本库为空';
    }).catch(error => {
      if (this.pageActive) this.statusText = formatError(error, '读取本地脚本库');
    }).then(() => {
      if (this.pageActive) {
        this.loading = false;
        stopNetworkFeedback(this);
      }
    });
  },
  selectScript(index) {
    if (this.loading || this.busy || !this.files[index]) return;
    vibrate('short');
    this.selectedName = this.files[index].name;
    if (this.replacingMarket) {
      this.marketName = String(this.marketTitle || '');
      this.description = String(this.marketDescription || '');
      this.tags = this.normalizeMarketTags(this.marketTags);
    } else {
      this.marketName = this.selectedName.replace(/\.js$/i, '').slice(0, 124);
      this.description = '';
      this.tags = '';
    }
    this.submissionText = '';
    this.stage = 'details';
    this.supportedDevices = this.replacingMarket ? marketDevices(this.marketSupportedDevices) : [];
    this.devicesLabel = marketDeviceLabel(this.supportedDevices);
  },
  selectDevices() {
    if (this.busy || this.stage !== 'details') return;
    vibrate('short');
    this.$app.$def.openDialog('select', {
      title: '适配设备', message: '选择已适配的设备，可多选', items: MARKET_DEVICES,
      multiple: true, minSelected: 1, value: this.supportedDevices
    }, this).then(result => {
      if (!this.pageActive || result.action !== 'confirm') return;
      this.supportedDevices = marketDevices(result.value);
      this.devicesLabel = marketDeviceLabel(this.supportedDevices);
    }).catch(error => { if (this.pageActive) showToast(error.message || '无法选择适配设备'); });
  },
  normalizeMarketTags(value) {
    let tags = value;
    if (typeof tags === 'string') {
      try {
        const parsed = JSON.parse(tags);
        if (Array.isArray(parsed)) tags = parsed;
      } catch (error) {
        tags = value;
      }
    }
    return Array.isArray(tags) ? tags.join(', ') : String(tags || '');
  },
  editField(field) {
    if (this.busy || this.replacingMarket || this.stage !== 'details') return;
    const settings = {
      marketName: {
        title: '市场名称',
        message: '填写公开显示的名称',
        maxLength: 124,
        required: true
      },
      description: {
        title: '用途说明',
        message: '说明用途和使用方法',
        maxLength: 1000,
        required: true
      },
      tags: {
        title: '标签',
        message: '用逗号分隔，最多 12 个，每个 40 字',
        maxLength: 500,
        required: false
      }
    }[field];
    if (!settings) return;
    vibrate('short');
    this.$app.$def.openDialog('text', Object.assign({}, settings, {
      value: this[field],
      language: 'cn'
    }), this).then(result => {
      if (this.pageActive && result.action === 'confirm') {
        this[field] = result.value;
        this.submissionText = '';
      }
    }).catch(error => {
      if (this.pageActive) showToast(error.message || '无法打开输入页');
    });
  },
  submit() {
    if (this.busy || this.stage !== 'details') return;
    const name = this.marketName.trim();
    const description = this.description.trim();
    const tags = this.tags.split(',').map(tag => tag.trim()).filter(Boolean);
    if (!this.supportedDevices.length) { showToast('请选择适配设备'); return; }
    if (!name) {
      showToast('请填写市场名称');
      return;
    }
    if (!description) {
      showToast('请填写用途说明');
      return;
    }
    if (tags.length > 12 || tags.some(tag => tag.length > 40)) {
      showToast('最多 12 个标签，每个不超过 40 字');
      return;
    }
    this.busy = true;
    this.$app.$def.openDialog('confirm', {
      title: this.replacingMarket ? '确认重新上传？' : '提交审核？',
      message: this.replacingMarket
        ? '将用 ' + this.selectedName + ' 替换“' + name + '”的市场源码并重新提交审核。审核通过后会更新公开版本。'
        : '将 ' + this.selectedName + ' 的当前源码提交为“' + name + '”。审核通过后才会公开。',
      confirmText: this.replacingMarket ? '重新上传' : '提交',
      cancelText: '返回'
    }, this).then(result => {
      if (!this.pageActive) return null;
      if (result.action !== 'confirm') {
        this.busy = false;
        return null;
      }
      this.stage = 'submitting';
      startNetworkFeedback(this, '正在提交并等待审核结果');
      const metadata = {
        name,
        description,
        tags: tags.join(', '),
        supportedDevices: this.supportedDevices.slice()
      };
      if (this.replacingMarket) metadata.marketId = Number(this.marketId);
      return this.$app.$def.getCloudClients().marketClient.submitMarketScript(this.selectedName, metadata);
    }).then(result => {
      if (!this.pageActive || !result) return;
      stopNetworkFeedback(this);
      this.busy = false;
      this.$app.$def.marketRefreshNeeded = true;
      this.$app.$def.marketSubmissionResult = result;
      showToast(result.statusText || (result.status === 'published' ? '已发布到 JS 市场' : result.status === 'rejected' ? '审核未通过' : '已提交市场审核'));
      back();
    }).catch(error => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      this.busy = false;
      this.stage = 'details';
      this.submissionText = errorMessage(error, '提交市场脚本');
      showToast(this.submissionText);
    });
  },
  goBack() {
    if (this.busy) {
      showToast('正在提交，请稍候');
      return;
    }
    vibrate('short');
    if (this.stage === 'details') {
      this.stage = 'choose';
      return;
    }
    back();
  },
  onBackPress() {
    this.goBack();
    return true;
  },
  loadingTap() {
    return false;
  }
};
</script>

<style>
@import "./upload.css";
</style>
