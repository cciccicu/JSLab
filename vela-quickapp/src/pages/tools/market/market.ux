<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div if="{{statusText}}" class="status"><text class="status-text">{{statusText}}</text></div>
      <div for="{{script in visibleScripts}}" tid="id" class="script {{busy ? 'disabled-item' : ''}}" @click="download(script)">
        <text class="name {{busy ? 'disabled-text' : ''}}">{{script.name}}</text>
        <text class="description {{busy ? 'disabled-text' : ''}}">{{script.description || '没有说明'}}</text>
        <text class="meta {{busy ? 'disabled-text' : ''}}">点击下载到本地</text>
      </div>
      <div if="{{shownCount < scripts.length}}" class="item load-more" @click="loadMore">
        <text class="load-more-text">显示更多（{{shownCount}}/{{scripts.length}}）</text>
      </div>
    </scroll>
    <div class="toolbar">
      <div class="search" @click="search"><text class="search-text">{{query || '搜索 JS 市场'}}</text></div>
      <img src="/common/images/rerun.png" class="refresh-action {{loading || busy ? 'disabled-icon' : ''}}" @click="load" />
    </div>
    <img static src="/common/images/hd.png" class="header" />
    <text class="time-text">{{nowTime}}</text>
    <text class="heading">JS 市场</text>
    <img static src="/common/images/back.png" class="back" @click="goBack" />
    <img src="/common/images/upload.png" class="upload {{loading || busy ? 'disabled-icon' : ''}}" @click="upload" />
    <div if="{{networkStatus}}" class="network-shade" @click="loadingTap">
      <div class="network-dialog">
        <text class="network-dialog-title">{{networkStatus}}</text>
        <text class="network-dialog-detail">{{networkStage}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import { back, push } from '../../../utils/core/routeManager.js';
import { errorMessage } from '../../../utils/cloud/cloudError.js';
import { startNetworkFeedback, setNetworkFeedbackVisible, stopNetworkFeedback } from '../../../utils/core/networkFeedback.js';
import { showToast, vibrate } from '../../../utils/core/uiFeedback.js';
import { getCurrentClock, startPageClock, stopPageClock } from '../../../utils/core/time.js';
const PAGE_SIZE = 10;
export default {
  private: {
    scripts: [],
    visibleScripts: [],
    shownCount: 0,
    loading: false,
    busy: false,
    networkStatus: '',
    networkStage: '',
    initialized: false,
    statusText: '正在加载...',
    query: '',
    nowTime: '00:00',
    pageActive: true
  },
  onInit() {
    this.updateTime();
  },
  onShow() {
    startPageClock(this);
    setNetworkFeedbackVisible(this, true);
    this.$app.$def.deliverDialog(this);
    if (!this.initialized) { this.initialized = true; this.load(); return; }
    if (this.$app.$def.marketRefreshNeeded) {
      this.$app.$def.marketRefreshNeeded = false;
      this.load();
    }
  },
  onHide() { stopPageClock(this); setNetworkFeedbackVisible(this, false); },
  onDestroy() {
    stopPageClock(this);
    stopNetworkFeedback(this);
    this.$app.$def.cancelOwnedDialog(this);
    this.pageActive = false;
  },
  updateTime() {
    this.nowTime = getCurrentClock();
  },
  clearResults() {
    this.scripts = [];
    this.visibleScripts = [];
    this.shownCount = 0;
  },
  load() {
    if (this.loading || this.busy) return;
    this.loading = true;
    this.clearResults();
    this.statusText = '正在加载...';
    startNetworkFeedback(this, '正在读取 JS 市场');
    this.$app.$def.getCloudClients().marketClient.listMarketScripts(this.query).then(scripts => {
      if (!this.pageActive) return;
      this.scripts = Array.isArray(scripts) ? scripts : [];
      this.shownCount = Math.min(PAGE_SIZE, this.scripts.length);
      this.visibleScripts = this.scripts.slice(0, this.shownCount);
      this.statusText = this.scripts.length === 0 ? '暂无可用脚本' : '';
    }).catch(error => {
      if (!this.pageActive) return;
      console.error('Failed to load JS market:', error);
      this.clearResults();
      this.statusText = errorMessage(error, '读取 JS 市场') + '，点刷新按钮重试';
    }).then(() => {
      if (this.pageActive) { this.loading = false; stopNetworkFeedback(this); }
    });
  },
  loadMore() {
    if (this.loading || this.busy) return;
    this.shownCount = Math.min(this.shownCount + PAGE_SIZE, this.scripts.length);
    this.visibleScripts = this.scripts.slice(0, this.shownCount);
  },
  upload() {
    if (this.loading || this.busy) return;
    vibrate('short');
    push('toolsMarketUpload');
  },
  search() {
    if (this.loading || this.busy) return;
    this.$app.$def.openDialog('text', {
      title: '搜索市场',
      value: this.query
    }, this).then(result => {
      if (result.action === "confirm") {
        const value = result.value;
        const nextQuery = String(value || '').trim();
        if (nextQuery === this.query) return;
        this.query = nextQuery;
        this.load();
      }
    }).catch(error => {
      showToast(error.message || "无法打开对话框");
    });
  },
  download(script) {
    if (!script || this.busy || this.loading) return;
    this.busy = true;
    startNetworkFeedback(this, '正在下载市场脚本');
    this.$app.$def.getCloudClients().marketClient.downloadMarketScript(script.id, false).then(saved => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      showToast('已下载 ' + saved.name);
      this.busy = false;
    }).catch(error => {
      if (!this.pageActive) return;
      stopNetworkFeedback(this);
      if (error.message !== 'file_exists') {
        this.busy = false;
        showToast(errorMessage(error, '下载市场脚本 ' + script.name));
        return;
      }
      this.busy = false;
      this.$app.$def.openDialog('confirm', {
        title: '文件已存在',
        message: '是否覆盖本地文件？'
      }, this).then(result => {
        if (result.action === "confirm") {
          if (this.busy) return;
          this.busy = true;
          startNetworkFeedback(this, '正在覆盖本地脚本');
          this.$app.$def.getCloudClients().marketClient.downloadMarketScript(script.id, true).then(() => {
            if (this.pageActive) showToast('已覆盖本地文件');
          }).catch(error => {
            if (this.pageActive) showToast(errorMessage(error, '覆盖本地市场脚本 ' + script.name));
          }).then(() => {
            if (this.pageActive) { this.busy = false; stopNetworkFeedback(this); }
          });
        }
      }).catch(error => {
        showToast(error.message || "无法打开对话框");
      });
    });
  },
  goBack() {
    vibrate('short');
    back();
  },
  loadingTap() { return false; }
};
</script>

<style>
@import "../../../common/styles/network-loading.css";
.page { width:336px; height:480px; background-color:#000000; overflow:hidden; }
.scroll { position:absolute; left:0px; top:164px; width:336px; height:316px; padding:0px 6px 24px; flex-direction:column; }
.header { position:absolute; left:0px; top:0px; width:336px; height:84px; }
.back,.upload { position:absolute; top:6px; width:72px; height:72px; }
.back { left:6px; }.upload { left:258px; }
.time-text { position:absolute; left:78px; top:7px; width:180px; line-height:32px; font-size:24px; font-weight:bold; color:rgba(255,255,255,0.6); text-align:center; }
.heading { position:absolute; left:78px; top:35px; width:180px; line-height:42px; font-size:32px; font-weight:bold; color:#fff; text-align:center; }
.toolbar { position:absolute; left:6px; top:84px; width:324px; height:72px; flex-direction:row; justify-content:space-between; }
.search { width:244px; height:72px; padding:0px 16px; border-radius:36px; background-color:#262626; justify-content:center; }
.search-text { width:212px; color:rgba(255,255,255,0.6); font-size:24px; line-height:34px; text-overflow:ellipsis; lines:1; }
.refresh-action { width:72px; height:72px; flex-shrink:0; }
.item,.script,.status { width:100%; height:112px; padding:14px 20px; margin-bottom:8px; border-radius:36px; background-color:#262626; flex-direction:column; flex-shrink:0; }
.script { justify-content:space-between; }.name { width:100%; color:#fff; font-size:28px; line-height:34px; font-weight:bold; text-overflow:ellipsis; lines:1; }.description { width:100%; color:rgba(255,255,255,0.6); font-size:19px; line-height:25px; text-overflow:ellipsis; lines:1; }.meta { width:100%; color:rgba(255,255,255,0.6); font-size:17px; line-height:22px; text-overflow:ellipsis; lines:1; }
.status { justify-content:center; }.status-text { width:100%; text-align:center; color:rgba(255,255,255,0.6); font-size:24px; line-height:32px; lines:2; }
.load-more { justify-content:center; }.load-more-text { width:100%; color:#ffffff; font-size:24px; font-weight:bold; text-align:center; }
.disabled-item { background-color:#303030; }
.disabled-text { color:#8c8c8c; }
.disabled-icon { background-color:#303030; border-radius:36px; }
</style>
