    <text if="{{running}}" class="stage">{{stage}}</text>
    <div if="{{resultVisible}}" class="result-screen">
      <text class="result-title">{{resultTitle}}</text>
      <text class="result-hint">{{resultHint}}</text>
      <div class="result-body">
        <text if="{{resultOverview}}" class="result-overview">{{resultOverview}}</text>
        <div class="result-card" for="{{card in resultCards}}" tid="id">
          <text class="result-card-title">{{card.label}}</text>
          <text class="result-card-metrics">{{card.text}}</text>
        </div>
      </div>
      <div class="result-pager">
        <div class="pager-action secondary" @click="previousResult"><text class="pager-text">上一页</text></div>
        <div class="pager-action" @click="nextResult"><text class="pager-text">下一页</text></div>
        <div class="pager-action secondary" @click="closeResults"><text class="pager-text">菜单</text></div>
      </div>
    </div>
    <div if="{{manual}}" class="manual-overlay">
      <div class="manual-action" @click="manualTap"><text class="action-text">点此测试</text></div>
      <div class="manual-action secondary" @click="nextManual"><text class="action-text">切换方案</text></div>
      <div class="manual-action secondary" @click="endManual"><text class="action-text">完成</text></div>
    </div>
  </div>
</template>

<script>
import device from '@system.device';
import brightness from '@system.brightness';
import { STYLE_CASES as CASES, createCase, statistics, summarize, buildReportPages } from '../../utils/benchmark.js';

const states = new WeakMap();
const now = () => Date.now();
const SAMPLE_COUNT = 8;
const WARMUP_COUNT = 2;

function keepScreen(state, enabled) {
  if (typeof brightness.setKeepScreenOn !== 'function') {
    if (state.report) state.report.keepScreenOn = 'unsupported';
    return;
  }
  if (!enabled && !state.screenRequested) return;
  state.screenRequested = enabled;
  brightness.setKeepScreenOn({ keepScreenOn: enabled,
    success: () => { if (enabled && !state.cancelled && state.report) state.report.keepScreenOn = 'enabled'; },
    fail: (message, code) => { if (enabled && !state.cancelled && state.report) state.report.keepScreenOn = { error: String(message), code }; }
  });
}

function delay(state, ms) {
  return new Promise((resolve, reject) => {
    if (state.cancelled) { reject(new Error('测试已停止')); return; }
    const id = setTimeout(() => { state.waits.delete(id); resolve(); }, ms);
    state.waits.set(id, reject);
  });
}

async function sample(state, testCase) {
  const value = {};
  const start = now();
  testCase.step(value);
  value.syncEnd = now();
  value.syncMs = value.syncEnd - start;
  // Engine flush is queued before this continuation. Measure its JS work,
  // then a timer turn. A timer is never labeled as a DOM or frame boundary.
  await Promise.resolve();
  if (state.cancelled) throw new Error('测试已停止');
  const jsEnded = now();
  value.jsTurnMs = jsEnded - start;
  await delay(state, 0);
  const ended = now();
  value.eventLoopMs = ended - start;
  value.waitMs = ended - jsEnded;
  await delay(state, 0);
  value.timer0Ms = now() - ended;
  const paced = now();
  await delay(state, 100);
  value.pacedOverrunMs = Math.max(0, now() - paced - 100);
  testCase.finishSample();
  delete value.syncEnd; delete value.viewEnd;
  return value;
}

export default {
  private: {
    running: false, manual: false, lean: false, square: false, uiNodes: [],
    fixed: false, fixedReady: false, objectStyles: false,
    slot0: {}, slot1: {}, slot2: {}, slot3: {}, slot4: {}, slot5: {},
    slot6: {}, slot7: {}, slot8: {}, slot9: {}, slot10: {}, slot11: {},
    slot12: {}, slot13: {}, slot14: {}, slot15: {}, slot16: {}, slot17: {},
    slot18: {}, slot19: {}, slot20: {}, slot21: {}, slot22: {}, slot23: {},
    stage: '', status: '测试不依赖 nextTick。结果分页显示，拍照即可。',
    hasResults: false, resultVisible: false, resultIndex: 0,
    resultTitle: '', resultHint: '', resultOverview: '', resultCards: []
  },
  onInit() {
    states.set(this, { cancelled: false, waits: new Map(), testCase: null, report: null, model: {}, manualIndex: 0, busy: false });
    const state = states.get(this);
    device.getInfo({ success: info => { if (states.has(this)) Object.assign(state.model, info); }, fail: (message, code) => { if (states.has(this)) Object.assign(state.model, { error: String(message), code }); } });
  },
  onDestroy() { this.cancel(); states.delete(this); },
  onHide() {
    if (!this.running) return;
    this.cancel(); this.running = false; this.manual = false;
    this.status = '测试因离开页面而停止；请重跑。';
  },
  onBackPress() {
    if (this.resultVisible) { this.closeResults(); return true; }
    if (!this.running) return false;
    if (this.manual && !states.get(this).busy) this.endManual();
    else { this.cancel(); this.running = false; this.manual = false; this.status = '测试已停止；可重跑。'; }
    return true;
  },
  cancel() {
    const state = states.get(this);
    if (!state) return;
    state.cancelled = true;
    keepScreen(state, false);
    if (state.testCase) state.testCase.dispose();
    state.waits.forEach((reject, id) => { clearTimeout(id); reject(new Error('测试已停止')); });
    state.waits.clear();
  },
  freshState() {
    const old = states.get(this);
    this.cancel();
    const state = { cancelled: false, waits: new Map(), testCase: null, model: old ? old.model : {}, manualIndex: 0, busy: false };
    state.report = { format: 'UI_PERF_V5', suite: 'auto', boundary: 'event-loop/timer0', clock: 'Date.now/ms', device: state.model, warmup: WARMUP_COUNT, samplesPerRound: SAMPLE_COUNT, rounds: 2,
      notes: 'jsTurn为回调与引擎微任务JS，eventLoop为之后timer(0)回调；均不是DOM或屏幕呈现时间。自动测试无振动。', scheduling: {}, cases: [], failures: [] };
    states.set(this, state);
    this.hasResults = false; this.resultVisible = false;
    keepScreen(state, true);
    return state;
  },
  prepareScene(mode) {
    this.fixedReady = false;
    this.uiNodes = [];
    for (let i = 0; i < 24; i++) this['slot' + i] = {};
    this.fixed = !!mode.fixed; this.lean = !!mode.lean; this.square = !!mode.square;
    this.objectStyles = !!mode.objectStyles;
  },
  async start() {
    if (this.running) return;
    const state = this.freshState();
    this.running = true; this.manual = false;
    try {
      this.stage = '调度校准';
      const promises = []; const timers = [];
      await delay(state, 0); await delay(state, 350);
      for (let i = 0; i < 8; i++) {
        let start = now(); await Promise.resolve(); promises.push(now() - start);
        start = now(); await delay(state, 0); timers.push(now() - start);
      }
      state.report.scheduling = { promise: statistics(promises), timer0: statistics(timers) };
      // Forward then reverse order reduces systematic warming/order bias.
      for (let round = 0; round < 2; round++) {
        const modes = round === 0 ? CASES : CASES.slice().reverse();
        for (const mode of modes) {
          if (state.testCase) state.testCase.dispose();
          this.prepareScene(mode);
          this.stage = (round + 1) + '/2 ' + mode.label;
          state.testCase = createCase(this, mode, now);
          await delay(state, 0); await delay(state, 350);
          for (let i = 0; i < WARMUP_COUNT; i++) await sample(state, state.testCase);
          const samples = [];
          for (let i = 0; i < SAMPLE_COUNT; i++) samples.push(await sample(state, state.testCase));
          state.report.cases.push({ id: mode.id, label: mode.label, round: round + 1, summary: summarize(samples), samples });
        }
      }
      this.finish(state);
    } catch (error) {
      if (state.cancelled || states.get(this) !== state) return;
      state.report.failures.push(String(error.message || error));
      this.finish(state);
    }
  },
  finish(state) {
    if (state.cancelled || states.get(this) !== state) return;
    if (state.testCase) state.testCase.dispose();
    keepScreen(state, false);
    this.running = false; this.manual = false;
    const result = buildReportPages(state.report);
    state.pages = result.pages;
    result.rows.forEach(row => console.log('UI_PERF_V5 ' + JSON.stringify({ suite: state.report.suite, id: row.id, summary: row.summary })));
    this.hasResults = true;
    this.status = state.report.failures.length ? '部分测试失败：' + state.report.failures.join('；') : '测试完成。点查看结果，逐页拍照即可。';
    console.log('UI_PERF_V5 ' + JSON.stringify({ suite: state.report.suite, device: state.report.device, scheduling: state.report.scheduling, boundary: state.report.boundary, failures: state.report.failures }));
    this.showResults();
  },
  showResults() {
    const state = states.get(this);
    if (!state || !state.pages || !state.pages.length || this.running) return;
    this.resultIndex = 0; this.resultVisible = true;
    this.refreshResultPage();
  },
  refreshResultPage() {
    const state = states.get(this);
    if (!state || !state.pages || !state.pages.length) return;
    const page = state.pages[this.resultIndex];
    this.resultTitle = page.title;
    this.resultHint = (this.resultIndex + 1) + ' / ' + state.pages.length + ' 页 · 拍照即可';
    this.resultOverview = page.overview || '';
    this.resultCards = page.cards || [];
  },
  previousResult() { this.changeResultPage(-1); },
  nextResult() { this.changeResultPage(1); },
  changeResultPage(direction) {
    const state = states.get(this);
    if (!state || !state.pages || !state.pages.length) return;
    this.resultIndex = (this.resultIndex + direction + state.pages.length) % state.pages.length;
    this.refreshResultPage();
  },
  closeResults() { this.resultVisible = false; },
  startManual() {
    if (this.running) return;
    const state = this.freshState();
    state.report.suite = 'manual'; state.report.rounds = 0; state.report.notes += ' 手动模式额外包含操作覆盖层，不能与自动测试绝对时间直接比较。';
    this.running = true; this.manual = true;
    this.setupManual(state);
  },
  setupManual(state) {
    if (state.testCase) state.testCase.dispose();
    const modes = ['string-game', 'object-game'].map(id => CASES.find(mode => mode.id === id));
    const mode = modes[state.manualIndex % modes.length];
    state.mode = mode;
    this.prepareScene(mode);
    this.stage = mode.label + '，请慢慢点';
    state.testCase = createCase(this, mode, now);
  },
  async manualTap() {
    const state = states.get(this);
    if (!this.manual || !state || state.cancelled || state.busy) return;
    state.busy = true;
    try {
      const value = await sample(state, state.testCase);
      if (!state.cancelled) state.report.cases.push({ id: state.mode.id, label: state.mode.label, round: 0, summary: summarize([value]), samples: [value] });
    } catch (error) {
      if (!state.cancelled) { state.report.failures.push(String(error.message || error)); this.finish(state); }
    } finally { state.busy = false; }
  },
  nextManual() {
    const state = states.get(this);
    if (!state || state.busy) return;
    state.manualIndex++; this.setupManual(state);
  },
  endManual() {
    const state = states.get(this);
    if (!state || state.busy) return;
    this.finish(state);
  }
};
</script>

<style>
.page { width:336px; height:480px; background-color:#000000; }
.menu { width:336px; height:480px; flex-direction:column; }
.menu-inner { width:336px; padding:18px 12px; flex-direction:column; flex-shrink:0; }
.title { width:312px; color:#ffffff; font-size:27px; line-height:36px; font-weight:bold; flex-shrink:0; }
.description { width:312px; color:#aaaaaa; font-size:18px; line-height:25px; margin-top:10px; flex-shrink:0; }
.action { width:312px; height:60px; background-color:#1769d2; border-radius:24px; justify-content:center; align-items:center; margin-top:12px; flex-shrink:0; }
.secondary { background-color:#34373d; }
.action-text { color:#ffffff; font-size:22px; line-height:30px; text-align:center; }
.result-screen { position:absolute; left:0px; top:0px; width:336px; height:480px; background-color:#000000; }
.result-title { position:absolute; left:12px; top:14px; width:312px; height:36px; color:#ffffff; font-size:26px; line-height:36px; font-weight:bold; lines:1; }
.result-hint { position:absolute; left:12px; top:50px; width:312px; height:24px; color:#aaaaaa; font-size:18px; line-height:24px; lines:1; }
.result-body { position:absolute; left:12px; top:80px; width:312px; height:312px; flex-direction:column; }
.result-overview { width:312px; height:312px; color:#ffffff; font-size:18px; line-height:26px; lines:12; flex-shrink:0; }
.result-card { width:312px; height:144px; margin-bottom:12px; flex-direction:column; flex-shrink:0; }
.result-card-title { width:312px; height:30px; color:#9cdcfe; font-size:20px; line-height:30px; font-weight:bold; lines:1; text-overflow:ellipsis; flex-shrink:0; }
.result-card-metrics { width:312px; height:104px; color:#ffffff; font-size:18px; line-height:26px; lines:4; flex-shrink:0; }
.result-pager { position:absolute; left:12px; top:408px; width:312px; height:60px; flex-direction:row; justify-content:space-between; }
.pager-action { width:100px; height:60px; background-color:#1769d2; border-radius:20px; justify-content:center; align-items:center; }
.pager-text { color:#ffffff; font-size:20px; line-height:28px; text-align:center; }
.content { width:336px; height:480px; flex-direction:column; }
.content-inner { width:336px; height:480px; flex-shrink:0; }
.surface { width:336px; height:480px; }
.node-wrap { position:absolute; flex-direction:column; justify-content:center; align-items:center; overflow:hidden; }
.ui-text { width:100%; flex-shrink:0; text-overflow:ellipsis; }
.ui-button { width:100%; height:100%; padding:0px 8px; justify-content:center; align-items:center; }
.control-card { width:100%; height:100%; padding:12px 16px; flex-direction:row; align-items:center; }
.control-copy { flex-direction:column; }
.control-label { width:100%; font-size:23px; line-height:28px; font-weight:bold; lines:1; text-overflow:ellipsis; }
.control-detail { width:100%; font-size:20px; line-height:26px; lines:2; text-overflow:ellipsis; }
.ui-switch { width:68px; margin-left:8px; }
.value-card { width:100%; height:100%; padding:12px 16px; flex-direction:column; justify-content:center; }
.value-header { width:100%; flex-direction:row; align-items:center; }
.value-label { flex:1; font-size:23px; line-height:28px; font-weight:bold; lines:1; text-overflow:ellipsis; }
.value-text { font-size:21px; line-height:28px; font-weight:bold; margin-left:6px; }
.ui-slider { width:100%; margin-top:8px; padding-left:0px; padding-right:0px; }
.ui-progress { width:100%; margin-top:12px; stroke-width:12px; }
.stage { position:absolute; left:6px; top:464px; width:324px; height:16px; color:#aaaaaa; font-size:14px; line-height:16px; lines:1; }
.manual-overlay { position:absolute; left:6px; top:402px; width:324px; height:60px; flex-direction:row; }
.manual-action { width:108px; height:60px; background-color:#1769d2; justify-content:center; align-items:center; }
</style>
