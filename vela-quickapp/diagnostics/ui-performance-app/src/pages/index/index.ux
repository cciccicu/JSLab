<template>
  <div class="page">
    <scroll if="{{!running && !resultVisible}}" class="menu" scroll-y="true">
      <div class="menu-inner">
        <text class="title">UI 性能诊断 v5</text>
        <text class="description">比较字符串与对象样式。测试时保持常亮，结束恢复。自动测试期间不要点击。约 1–3 分钟。</text>
        <div class="action" @click="start"><text class="action-text">开始自动测试</text></div>
        <div class="action secondary" @click="startManual"><text class="action-text">手动点击 A/B</text></div>
        <div if="{{hasResults}}" class="action secondary" @click="showResults"><text class="action-text">查看结果（拍照）</text></div>
        <text class="description">{{status}}</text>
      </div>
    </scroll>
    <scroll if="{{running}}" class="content" scroll-y="true" bounces="true">
      <div class="content-inner">
        <div if="{{!lean && !fixed && !objectStyles}}" class="surface">
        <div for="{{node in uiNodes}}" tid="id" class="node-wrap" style="left: {{node.x}}px; top: {{node.y}}px; width: {{node.width}}px; height: {{node.height}}px; background-color: {{node.background}}; border-radius: {{node.radius}}px;">
          <text if="{{node.kind === 'heading' || node.kind === 'text'}}" class="ui-text" style="color: {{node.color}}; font-size: {{node.size}}px; line-height: {{node.lineHeight}}px; font-weight: {{node.bold}}; text-align: {{node.align}}; lines: {{node.lines}};">{{node.text}}</text>
          <div elif="{{node.kind === 'button'}}" class="ui-button" @click="manualTap">
            <text class="ui-text" style="color: {{node.color}}; font-size: {{node.size}}px; line-height: {{node.lineHeight}}px; lines: {{node.lines}}; font-weight: bold; text-align: center;">{{node.text}}</text>
          </div>
          <div elif="{{node.kind === 'switch'}}" class="control-card">
            <div class="control-copy" style="width: {{node.copyWidth}}px;">
              <text class="control-label" style="color: {{node.color}};">{{node.text}}</text>
              <text if="{{node.detail}}" class="control-detail" style="color: {{node.detailColor}};">{{node.detail}}</text>
            </div>
            <switch class="ui-switch" checked="{{node.checked}}" style="track-color: {{node.accent}}; thumb-color: {{node.thumbColor}};"></switch>
          </div>
          <div elif="{{node.kind === 'slider'}}" class="value-card">
            <div class="value-header">
              <text class="value-label" style="color: {{node.color}};">{{node.text}}</text>
              <text class="value-text" style="color: {{node.accent}};">{{node.value}}</text>
            </div>
            <slider class="ui-slider" min="{{node.min}}" max="{{node.max}}" step="{{node.step}}" value="{{node.value}}" style="color: {{node.trackColor}}; selected-color: {{node.accent}}; block-color: {{node.thumbColor}};"></slider>
          </div>
          <div elif="{{node.kind === 'progress'}}" class="value-card">
            <div class="value-header">
              <text class="value-label" style="color: {{node.color}};">{{node.text}}</text>
              <text class="value-text" style="color: {{node.accent}};">{{node.percent}}%</text>
            </div>
            <progress class="ui-progress" percent="{{node.percent}}" style="color: {{node.accent}}; layer-color: {{node.trackColor}};"></progress>
          </div>
          <qrcode elif="{{node.kind === 'qrcode'}}" value="{{node.value}}" style="width: {{node.qrSize}}px; height: {{node.qrSize}}px; color: {{node.color}}; background-color: {{node.background}};"></qrcode>
        </div>
        </div>
        <div if="{{objectStyles}}" class="surface">
        <!-- OBJECT_NODES_START -->
        <div for="{{node in uiNodes}}" tid="id" class="node-wrap" style="{{ { left: '' + (node.x) + 'px', top: '' + (node.y) + 'px', width: '' + (node.width) + 'px', height: '' + (node.height) + 'px', backgroundColor: '' + (node.background), borderRadius: '' + (node.radius) + 'px' } }}">
