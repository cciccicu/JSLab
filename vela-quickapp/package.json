{
  "name": "JSLab",
  "version": "2.0.3",
  "description": "",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot server --watch --open-nuttx",
    "build": "aiot build --enable-jsc",
    "release": "aiot release --enable-jsc",
    "release:astrobox": "node scripts/release-astrobox.cjs",
    "release:community": "node scripts/release-community.cjs",
    "watch": "aiot watch --open-nuttx",
    "lint": "eslint --format codeframe --ext .ux,.js src/",
    "test": "node scripts/check-runtime-contract.cjs && node --test tests/*.test.cjs",
    "test:core": "node --test tests/core.test.cjs",
    "test:files": "node --test tests/files.test.cjs",
    "test:editor": "node --test tests/editor.test.cjs",
    "test:cloud": "node --test tests/cloud.test.cjs",
    "test:runtime": "node --test tests/runtime.test.cjs",
    "sync:contract": "node scripts/sync-runtime-contract.cjs",
    "check:contract": "node scripts/check-runtime-contract.cjs",
    "prebuild": "npm run sync:contract",
    "prerelease": "npm run sync:contract"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.7",
    "aiot-toolkit": "^2.0.5",
    "babel-eslint": "^10.0.1",
    "eslint": "^6.8.0",
    "eslint-plugin-ux": "^0.0.4"
  }
}
