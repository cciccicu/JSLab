<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
	<div class="page" style="flex-direction: column;">
		<!-- 单一连续代码文档。 -->
		<scroll 
		id="code-scroll"
		class="scroll" 
		scroll-x="true" 
		scroll-y="true" 
		style="position:absolute;top:0px;left:0px;height:480px;width:100%;flex-direction: column;padding: 0px 6px;"
	  >
		<div class="code-top-spacer"></div>
		<div class="code-document" @click="onCodeClick" style="width: {{codeWidth + 20}}px; height: {{codeHeight}}px;">
		  <text if="{{highlightEnabled}}" class="code" style="font-family: {{fontFamily}}; font-size: {{fontSize}}px; line-height: {{cursorHeight}}px; width: {{codeWidth + 40}}px;"><span for="{{token in codeTokens}}" tid="id" style="color: {{token.color}};">{{token.text}}</span></text>
		  <text else class="code" style="font-family: {{fontFamily}}; font-size: {{fontSize}}px; line-height: {{cursorHeight}}px; width: {{codeWidth + 40}}px;">{{codeText}}</text>
		  <div if="{{showCursor}}" class="code-cursor" style="left: {{cursorX}}px; top: {{cursorY}}px; width: {{fontSize/6}}px; height: {{cursorHeight}}px;"></div>
		</div>
		<div class="code-bottom-spacer"></div>
	  </scroll>

		<!-- 第三方输入法 -->
		<input-method if="{{!hideInputMethod}}" 
			hide="{{hideInputMethod}}"
			initial-language="en"
			maxlength="{{maxlength}}" 
			vibratemode="{{vibrateMode}}"
			@delete="onInputMethodDelete"
			@complete="onInputMethodCompleteSelf" 
		></input-method>
    
		<!-- 光标方向控制 -->
		<div if="{{showCursorControls}}" class="cursormove">
			<img src="/common/images/up.png" class="cursor-btn" @click="move('up')"></img>
			<img src="/common/images/left.png" class="cursor-btn" @click="move('left')"></img>
			<img src="/common/images/right.png" class="cursor-btn" @click="move('right')"></img>
			<img src="/common/images/down.png" class="cursor-btn" @click="move('down')"></img>
		</div>

		<!-- 底部工具栏 -->
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/save.png" style="left: 6px;top: 402px;" @click="savecode" />
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/run.png" style="left: 90px;top: 402px;" @click="runcode" />
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/move.png" style="left: 174px;top: 402px;" @click="changeMoveCursor" />
		<img if="{{!hideToolbar}}" class="btn" src="/common/images/edit.png" style="left: 258px;top: 402px;" @click="changeKeybord" />

		<!-- 顶栏 -->
		<img static src="/common/images/hd.png" class="topbar-bg" />
		<img static class="btn" src="/common/images/back.png" @click="back" style="left: 6px;top: 6px;" />
		<img static class="btn" src="/common/images/more.png" @click="routerTo('more')" style="left: 258px;top: 6px;" />
		<img static if="{{!hideInputMethod}}" class="btn" src="/common/images/down.png" @click="changeKeybord" style="left: 258px;top: 6px;" />
		<text class="time-text">{{nowTime}}</text>
		<text class="title-text">编辑JS</text>
	</div>
</template>

<script>
import configManager from '../../utils/configManager.js';
import jsManager from '../../utils/jsManager.js';
import { back as navigateBack, push } from '../../utils/routeManager.js';
import { showToast, vibrate } from '../../utils/uiFeedback.js';
import { getCurrentClock } from '../../utils/time.js';
import highlightJavascript from '../../utils/javascriptHighlighter.js';
import {
  getCursorPosition,
  getLineHeight,
  getTextWidth,
  moveCursorToPoint,
  moveCursorVertically
} from '../../utils/codeEditor.js';

const CODE_VIEWPORT_HEIGHT = 300;
const HIGHLIGHT_INPUT_DELAY = 160;
const LARGE_FILE_CHAR_THRESHOLD = 12 * 1024;
const LARGE_FILE_LINE_THRESHOLD = 240;
const DEFAULT_FONT_SIZE = 16;
const MIN_FONT_SIZE = 10;
const MAX_FONT_SIZE = 32;
let activeSource = '';

function normalizeFontSize(value) {
	const parsed = Number(value);
	if (isNaN(parsed)) return DEFAULT_FONT_SIZE;
	return Math.min(MAX_FONT_SIZE, Math.max(MIN_FONT_SIZE, Math.round(parsed)));
}

function analyzeCodeSize(source) {
	const code = String(source || '');
	let lineCount = 1;
	for (let index = 0; index < code.length; index += 1) {
		if (code.charCodeAt(index) === 10) lineCount += 1;
	}
	return {
		lineCount,
		isLarge: code.length >= LARGE_FILE_CHAR_THRESHOLD || lineCount >= LARGE_FILE_LINE_THRESHOLD
	};
}

export default {
	private: {
		nowTime: "00:00",
		timer: null,
		hideToolbar: false,
		codeText: '',
		codeTokens: [],
		codeHeight: CODE_VIEWPORT_HEIGHT,
		highlightEnabled: true,
		largeFileMode: false,
		highlightRefreshTimer: null,
		preferencesLoading: false,
		pageActive: true,
		showCursorControls: false,
		hideInputMethod: true,
		maxlength: 5,
		vibrateMode: "short",
		fontFamily: 'UbuntuMono',
		fontSize: DEFAULT_FONT_SIZE,
		codeWidth: 336,
		// 光标状态
		showCursor: true,
		cursorX: 0,
		cursorY: 0,
		cursorHeight: 20,
		cursorBlinkTimer: null
	},

	onInit() {
		const editor = this.$app.$def.editor;
		if (!editor.before && !editor.after && editor.code) editor.before = editor.code;
		editor.code = '';
		this.updateCodeDisplay();
		this.loadEditorPreferences();
		this.updateTime();
		this.timer = setInterval(() => {
			this.updateTime();
		}, 60000);
		if (!this.largeFileMode) this.startCursorBlink();
	},

	onDestroy() {
		this.pageActive = false;
		if (this.timer) clearInterval(this.timer);
		if (this.highlightRefreshTimer) clearTimeout(this.highlightRefreshTimer);
		this.stopCursorBlink();
		activeSource = '';
		this.codeText = '';
		this.codeTokens = [];
		if (typeof global !== 'undefined' && typeof global.runGC === 'function') global.runGC();
	},

	onShow() {
		this.loadEditorPreferences();
		if (!this.largeFileMode) this.startCursorBlink();
	},

	onHide() {
		this.stopCursorBlink();
	},

	loadEditorPreferences() {
		if (this.preferencesLoading) return;
		this.preferencesLoading = true;
		Promise.all([
			configManager.get('editor.font.size', DEFAULT_FONT_SIZE),
			configManager.get('editor.font.family', 'UbuntuMono')
		]).then((values) => {
			this.preferencesLoading = false;
			if (!this.pageActive) return;
			const nextSize = normalizeFontSize(values[0]);
			const nextFamily = values[1] === 'SarasaTermSCNerd' ? 'SarasaTermSCNerd' : 'UbuntuMono';
			if (nextSize === this.fontSize && nextFamily === this.fontFamily) return;
			this.fontSize = nextSize;
			this.fontFamily = nextFamily;
			this.refreshCodeLayout();
		}).catch((error) => {
			this.preferencesLoading = false;
			console.error('Failed to load editor preferences:', error);
		});
	},

	startCursorBlink() {
		if (this.cursorBlinkTimer) return;
		this.cursorBlinkTimer = setInterval(() => {
			this.showCursor = !this.showCursor;
		}, 500);
	},

	stopCursorBlink() {
		if (this.cursorBlinkTimer) {
			clearInterval(this.cursorBlinkTimer);
			this.cursorBlinkTimer = null;
		}
	},

	routerTo(page) {
		vibrate('short');
		push(page);
	},

	back() {
		vibrate('short');
		navigateBack();
	},

	changeKeybord() {
		vibrate('short');
		this.hideInputMethod = !this.hideInputMethod;
		this.hideToolbar = !this.hideInputMethod;
		if (this.showCursorControls) this.showCursorControls = false;
	},

	changeMoveCursor() {
		vibrate('short');
		this.showCursorControls = !this.showCursorControls;
	},

	onInputMethodDelete() {
		this.del();
	},

	onInputMethodCompleteSelf(evt) {
		if (evt && evt.detail && evt.detail.content) {
			this.add(evt.detail.content);
		}
	},

	onCodeClick(event) {
		this.moveCursorTo(event.offsetX - 6, event.offsetY);
		vibrate('short');
	},

	scheduleHighlightRefresh() {
		if (this.highlightRefreshTimer) clearTimeout(this.highlightRefreshTimer);
		this.highlightRefreshTimer = setTimeout(() => {
			this.highlightRefreshTimer = null;
			this.refreshCodeHighlight();
		}, HIGHLIGHT_INPUT_DELAY);
	},

	refreshCodeHighlight() {
		if (this.largeFileMode) return;
		this.highlightEnabled = true;
		this.codeTokens = highlightJavascript(activeSource, 'code-token');
	},

	refreshCodeLayout() {
		this.cursorHeight = getLineHeight(this.fontFamily, this.fontSize);
		const metrics = analyzeCodeSize(activeSource);
		this.codeHeight = Math.max(CODE_VIEWPORT_HEIGHT, metrics.lineCount * this.cursorHeight);
		this.codeWidth = Math.max(336, getTextWidth(activeSource, this.fontSize) + 20);
		this.calculateCursorPosition();
	},

	moveCursorTo(x, y) {
		const editor = this.$app.$def.editor;
		const cursor = moveCursorToPoint(editor.before + editor.after, x, y, this.fontFamily, this.fontSize);
		editor.before = cursor.before;
		editor.after = cursor.after;
		this.refreshCursorPosition();
	},

	refreshCursorPosition() {
		const position = getCursorPosition(this.$app.$def.editor.before, this.fontFamily, this.fontSize);
		this.applyCursorPosition(position);
	},

	updateCodeDisplay(deferHighlight) {
		const editor = this.$app.$def.editor;
		activeSource = editor.before + editor.after;
		editor.code = '';
		const metrics = analyzeCodeSize(activeSource);
		const wasLarge = this.largeFileMode;
		this.largeFileMode = metrics.isLarge;
		this.codeText = activeSource;
		const position = getCursorPosition(editor.before, this.fontFamily, this.fontSize);
		this.cursorHeight = position.height;
		this.codeHeight = Math.max(CODE_VIEWPORT_HEIGHT, metrics.lineCount * position.height);
		this.codeWidth = Math.max(336, getTextWidth(activeSource, this.fontSize) + 20);
		this.highlightEnabled = !metrics.isLarge && !deferHighlight;
		this.codeTokens = this.highlightEnabled
			? highlightJavascript(activeSource, 'code-token')
			: [];
		this.applyCursorPosition(position);
		if (!wasLarge && this.largeFileMode) {
			this.stopCursorBlink();
			this.showCursor = true;
		} else if (wasLarge && !this.largeFileMode) {
			this.startCursorBlink();
		}
		if (deferHighlight && !this.largeFileMode) {
			this.scheduleHighlightRefresh();
		} else if (this.highlightRefreshTimer) {
			clearTimeout(this.highlightRefreshTimer);
			this.highlightRefreshTimer = null;
		}
	},

	add(str) {
		this.$app.$def.editor.before += str;
		this.updateCodeDisplay(true);
	},

	del() {
		const editor = this.$app.$def.editor;
		if (editor.before.length > 0) {
			editor.before = editor.before.slice(0, -1);
			this.updateCodeDisplay(true);
		}
	},

	move(direction) {
		vibrate('short');
		const editor = this.$app.$def.editor;
		switch (direction) {
			case "left":
				if (editor.before.length > 0) {
					const charToMove = editor.before.slice(-1);
					editor.before = editor.before.slice(0, -1);
					editor.after = charToMove + editor.after;
					this.refreshCursorPosition();
				}
				break;
			case "right":
				if (editor.after.length > 0) {
					const charToMove = editor.after.charAt(0);
					editor.after = editor.after.slice(1);
					editor.before += charToMove;
					this.refreshCursorPosition();
				}
				break;
			case "up":
				this.moveVertical(-1);
				break;
			case "down":
				this.moveVertical(1);
				break;
		}
	},

	moveVertical(direction) {
		const editor = this.$app.$def.editor;
		const cursor = moveCursorVertically(editor.before, editor.after, direction);
		if (!cursor) return;
		editor.before = cursor.before;
		editor.after = cursor.after;
		this.refreshCursorPosition();
	},

	calculateCursorPosition() {
		const position = getCursorPosition(this.$app.$def.editor.before, this.fontFamily, this.fontSize);
		this.applyCursorPosition(position);
	},

	applyCursorPosition(position) {
		this.cursorX = position.x;
		this.cursorY = position.y;
		this.cursorHeight = position.height;
	},

	savecode() {
		vibrate('short');
		const editor = this.$app.$def.editor;
		const code = editor.before + editor.after;
		jsManager.write(editor.name, code)
			.then(() => showToast('代码已保存'))
			.catch((error) => showToast('保存失败: ' + error.message));
	},

	runcode() {
		vibrate('short');
		const editor = this.$app.$def.editor;
		editor.code = editor.before + editor.after;
		push('run');
	},

	updateTime() {
		this.nowTime = getCurrentClock();
	},
};
</script>

<style>
	@font-face {
		font-family: 'SarasaTermSCNerd';
		src: url('../../common/fonts/SarasaTermSCNerd-Misans-v2.ttf') format('ttf');
		font-weight: normal;
		font-style: normal;
	}
	@font-face {
		font-family: 'UbuntuMono';
		src: url('../../common/fonts/UbuntuMono-MiSans-v2.ttf') format('ttf');
		font-weight: normal;
		font-style: normal;
	}
	.page {
		width: 336px;
		height: 480px;
		background-color: #000000;
		position: relative; 
	}

	.code {
    	color: #ffffff;
  	}

	.code-top-spacer {
		height: 102px;
		flex-shrink: 0;
	}

	.code-document {
		position: relative;
		flex-direction: column;
		flex-shrink: 0;
	}

	.code-cursor {
		position: absolute;
		background-color: #ffffff;
	}

	.code-bottom-spacer {
		height: 78px;
		flex-shrink: 0;
	}

	.btn {
		position: absolute;
		width: 72px;
		height: 72px;
	}

	.topbar-bg {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 336px;
		height: 102px;
	}

	.time-text {
		position: absolute;
		left: 78px;
		top: 7px;
		width: 180px;
		line-height: 32px;
		font-weight: bold;
		font-size: 24px;
		color: rgba(255,255,255,0.6);
		text-align: center;
	}

	.title-text {
		position: absolute;
		left: 78px;
		top: 35px;
		width: 180px;
		line-height: 42px;
		font-weight: bold;
		font-size: 32px;
		color: white;
		text-align: center;
	}

	.cursormove {
		position: absolute;
		left: 6px;
		top: 300px;
		width: 324px;
		height: 90px;
		border-radius: 36px;
		background-color: #333;
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
	}

	.cursor-btn {
		width: 72px;
		height: 72px;
	}
</style>
