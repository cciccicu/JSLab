<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="content">
        <div if="{{viewMode === 'directory'}}" class="directory-view">
          <div class="directory-intro">
            <text class="directory-title">{{directoryTitle}}</text>
            <text class="directory-summary">{{directorySummary}}</text>
          </div>
          <div class="menu-card" for="{{directoryItems}}" tid="id" @click="openItem($item.id)">
            <div class="menu-copy">
              <text class="menu-title">{{$item.title}}</text>
              <text class="menu-summary">{{$item.summary}}</text>
            </div>
            <img static src="/common/images/enter.png" class="chevron" />
          </div>
        </div>

        <div if="{{viewMode === 'article'}}">
          <div class="article-card">
            <text class="article-title">{{activeDocument.title}}</text>
            <text class="article-summary">{{activeDocument.summary}}</text>
            <text class="article-intro">{{activeDocument.intro}}</text>
            <div class="method-card" for="{{activeDocument.methods}}" tid="id">
              <text class="method-name">{{$item.name}}</text>
              <text class="method-description">{{$item.description}}</text>
              <text if="{{$item.example}}" class="code-block">{{$item.example}}</text>
              <text if="{{$item.note}}" class="method-note">{{$item.note}}</text>
            </div>
            <text if="{{activeDocument.note}}" class="article-note">{{activeDocument.note}}</text>
          </div>
        </div>
      </div>
    </scroll>

    <img static src="/common/images/hd.png" class="topbar-bg" />
    <img static src="/common/images/back.png" class="btn" @click="goBack" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">{{pageTitle}}</text>
  </div>
</template>

<script>
import { back as navigateBack } from '../../utils/routeManager.js';
import { vibrate } from '../../utils/uiFeedback.js';
import { getCurrentClock } from '../../utils/time.js';
import { HELP_ROOT, findHelpNode, getDirectoryItems } from '../../data/helpDocs.js';

const ROOT_DIRECTORY = {
  title: '帮助',
  summary: '教程、UI 模式与系统 API 文档'
};

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    viewMode: 'directory',
    currentDirectoryId: '',
    directoryTrail: [],
    directoryTitle: ROOT_DIRECTORY.title,
    directorySummary: ROOT_DIRECTORY.summary,
    directoryItems: HELP_ROOT,
    activeDocument: null,
    pageTitle: '帮助'
  },

  onInit() {
    this.updateTime();
    this.timer = setInterval(() => this.updateTime(), 60000);
  },

  onShow() {
    this.updateTime();
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer);
  },

  updateTime() {
    this.nowTime = getCurrentClock();
  },

  openItem(id) {
    const node = findHelpNode(id);
    if (!node) return;
    vibrate('short');
    if (node.type === 'directory') {
      this.openDirectory(node);
      return;
    }
    this.activeDocument = node;
    this.viewMode = 'article';
    this.pageTitle = node.title;
  },

  openDirectory(node) {
    this.directoryTrail = this.directoryTrail.concat(this.currentDirectoryId);
    this.currentDirectoryId = node.id;
    this.directoryTitle = node.title;
    this.directorySummary = node.summary;
    this.directoryItems = getDirectoryItems(node.id);
    this.viewMode = 'directory';
    this.pageTitle = node.title;
  },

  restoreDirectory(id) {
    const node = id ? findHelpNode(id) : null;
    this.currentDirectoryId = id;
    this.directoryTitle = node ? node.title : ROOT_DIRECTORY.title;
    this.directorySummary = node ? node.summary : ROOT_DIRECTORY.summary;
    this.directoryItems = getDirectoryItems(id);
    this.viewMode = 'directory';
    this.pageTitle = node ? node.title : '帮助';
  },

  goBack() {
    vibrate('short');
    if (this.viewMode === 'article') {
      this.activeDocument = null;
      this.restoreDirectory(this.currentDirectoryId);
      return;
    }
    if (this.directoryTrail.length) {
      const previousId = this.directoryTrail[this.directoryTrail.length - 1];
      this.directoryTrail = this.directoryTrail.slice(0, this.directoryTrail.length - 1);
      this.restoreDirectory(previousId);
      return;
    }
    navigateBack();
  }
};
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; overflow: hidden; }
.scroll { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; }
.content { flex-direction: column; padding: 102px 6px 84px; }
.directory-view { flex-direction: column; }
.directory-intro, .article-card { width: 324px; flex-direction: column; padding: 18px 20px; margin-bottom: 12px; background-color: #262626; border-radius: 28px; }
.directory-title, .article-title { width: 284px; font-size: 30px; line-height: 38px; font-weight: bold; color: #ffffff; }
.directory-summary, .article-summary { width: 284px; margin-top: 8px; font-size: 20px; line-height: 29px; color: rgba(255,255,255,0.68); lines: -1; }
.menu-card { width: 324px; height: 96px; padding: 14px 18px 14px 20px; margin-bottom: 8px; background-color: #262626; border-radius: 28px; align-items: center; justify-content: space-between; }
.menu-copy { width: 250px; flex-direction: column; }
.menu-title { width: 250px; font-size: 25px; line-height: 32px; font-weight: bold; color: #ffffff; text-overflow: ellipsis; lines: 1; }
.menu-summary { width: 250px; margin-top: 3px; font-size: 18px; line-height: 24px; color: rgba(255,255,255,0.6); text-overflow: ellipsis; lines: 1; }
.chevron { width: 36px; height: 36px; }
.article-intro { width: 284px; margin-top: 18px; font-size: 21px; line-height: 31px; color: #ffffff; lines: -1; }
.method-card { width: 284px; flex-direction: column; padding: 16px 0px; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.12); }
.method-name { width: 284px; font-family: UbuntuMono; font-size: 21px; line-height: 29px; font-weight: bold; color: #7db8ff; lines: -1; }
.method-description { width: 284px; margin-top: 6px; font-size: 20px; line-height: 29px; color: #ffffff; lines: -1; }
.code-block { width: 284px; padding: 12px; margin-top: 12px; background-color: #111111; border-radius: 12px; font-family: UbuntuMono; font-size: 17px; line-height: 24px; color: #b7d9ff; lines: -1; }
.method-note, .article-note { width: 284px; margin-top: 10px; font-size: 18px; line-height: 27px; color: #ffbf66; lines: -1; }
.article-note { margin-top: 16px; }
.topbar-bg { position: absolute; left: 0px; top: 0px; width: 336px; height: 102px; }
.btn { position: absolute; left: 6px; top: 6px; width: 72px; height: 72px; }
.time-text { position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center; }
.title-text { position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 30px; color: #ffffff; text-align: center; text-overflow: ellipsis; lines: 1; }
</style>
