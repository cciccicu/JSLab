<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- 输出控制台 -->
    <scroll bounces="true" class="scroll-container" scroll-y="true">
      <div class="console-card">
        <text class="result-title">console：</text>
        <div class="result-box">
          <text class="result" if="{{!hasError}}">{{result}}</text>
          <text class="error" if="{{hasError}}">{{error}}</text>
          <text class="runtime" if="{{runTime}}">同步运行耗时: {{runTime}} ms</text>
        </div>
      </div>
    </scroll>

    <!-- Prompt 输入区域：仅在需要时渲染 -->
    <text if="{{!hideInputMethod}}" class="prompt-message">{{promptMessage}}</text>
    <text if="{{!hideInputMethod}}" class="input-display">{{inputBuffer}}</text>
    <img if="{{!hideInputMethod}}" class="btn-confirm" src="/common/images/conform.png" @click="onPromptConfirm" />
    <!-- 输入法键盘 -->
  <input-method 
    hide="{{inputMethodHide}}"
    initial-language="cn"
    maxlength="5"
    vibratemode="short"
    @complete="onComplete"
    @delete="onDelete"
  >
  </input-method>

    <!-- 顶部工具栏 -->
    <img static src="/common/images/hd.png" class="topbar-bg" />
    <img static src="/common/images/back.png" class="btn" style="left: 6px; top: 6px;" @click="onBack" />
    <img static src="/common/images/rerun.png" class="btn" style="left: 258px; top: 6px;" @click="onRerun" />
    <text class="time-text">{{nowTime}}</text>
    <text class="title-text">运行JS</text>
  </div>
</template>

<script>
  import app from '@system.app';
  import device from '@system.device';
  import router from '@system.router';
  import configuration from '@system.configuration';

  import storage from '@system.storage';
  import file from '@system.file';

  import network from '@system.network';
  import brightness from '@system.brightness';
  import battery from '@system.battery';
  import geolocation from '@system.geolocation';
  import vibrator from '@system.vibrator';
  import event from '@system.event';
  import sensor from '@system.sensor';
  import record from '@system.record';

  import fetch from '@system.fetch';
  import interconnect from '@system.interconnect';
  import uploadtask from '@system.uploadtask';
  import request from '@system.request';
  import prompt from '@system.prompt';

  import crypto from '@system.crypto';
  import audio from '@system.audio';

  import { back as navigateBack } from '../../utils/routeManager.js';
  import { vibrate } from '../../utils/uiFeedback.js';
  import { getCurrentClock } from '../../utils/time.js';

  const MAX_CONSOLE_CHARACTERS = 6 * 1024;
  const CONSOLE_FLUSH_DELAY = 80;
	const MAX_PREVIEW_ITEMS = 20;
  let consoleBuffer = '';
  let consoleFlushTimer = null;
  let consoleOutputTruncated = false;

	function formatConsoleArgument(argument) {
	  if (typeof argument !== 'object' || argument === null) return String(argument);
	  try {
		if (Array.isArray(argument)) {
		  const preview = argument.slice(0, MAX_PREVIEW_ITEMS);
		  return JSON.stringify(preview) + (argument.length > MAX_PREVIEW_ITEMS ? ' …(' + argument.length + ' 项)' : '');
		}
		const keys = Object.keys(argument);
		const preview = {};
		keys.slice(0, MAX_PREVIEW_ITEMS).forEach((key) => { preview[key] = argument[key]; });
		return JSON.stringify(preview) + (keys.length > MAX_PREVIEW_ITEMS ? ' …(' + keys.length + ' 个字段)' : '');
	  } catch (error) {
		return '[object Object]';
	  }
	}

  export default {
    private: {
      nowTime: "00:00",
      timer: null,
      code: "",
      result: "",
      error: "",
      hasError: false,
      runTime: "",

      // Prompt 状态
      currentInputCallback: null,
      promptMessage: "",
      inputBuffer: "",          // 手动维护的输入内容
      hideInputMethod: true,    // 控制 prompt 区域是否渲染
      inputMethodHide: true,    // 控制输入法键盘显隐
      waitingForInput: false,   // 当前是否正在等待用户输入

      // 全局虚拟 window
      vwindow: null,

      // input 回调队列：[{ message, callback }, ...]
      inputQueue: [],
    },

    onInit() {
      this.updateTime();
      this.timer = setInterval(() => {
        this.updateTime();
      }, 60000);

      // 初始化 vwindow（只创建一次）
      this.initVWindow();

      const editor = this.$app.$def.editor;
      this.code = editor.code || editor.before + editor.after;
      editor.code = '';
      this.runCode();
    },

    onDestroy() {
      if (this.timer) clearInterval(this.timer);
	  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
	  consoleFlushTimer = null;
	  consoleBuffer = '';
	  consoleOutputTruncated = false;
	  this.code = '';
	  this.result = '';
	  this.error = '';
	  this.inputQueue = [];
	  this.currentInputCallback = null;
    },

    updateTime() {
      this.nowTime = getCurrentClock();
    },

    onBack() {
      vibrate('short');
      navigateBack();
    },

    onRerun() {
      vibrate('short');
      this.runCode();
    },

    exit() {
      app.terminate();
    },

    initVWindow() {
      // console 实现
      const vconsole = {
        log: (...args) => {
		  const output = args.map(formatConsoleArgument).join(' ');
		  this.appendConsoleOutput(output);
        },
        error: (...args) => {
          const output = args.map(String).join(' ');
		  this.appendConsoleOutput("[ERROR] " + output);
        }
      };

      // input 实现：使用回调
      const input = (message, callback) => {
        if (typeof message === 'function') {
          // 兼容 input(callback) 形式
          callback = message;
          message = "请输入内容";
        }
        message = String(message || "请输入内容");
        this.inputQueue.push({ message, callback });
        this.processInputQueue();
      };

      this.vwindow = {
        console: vconsole,
        input: input
      };
    },

	appendConsoleOutput(output) {
	  if (consoleOutputTruncated) return;
	  const separator = consoleBuffer ? '\n' : '';
	  const available = MAX_CONSOLE_CHARACTERS - consoleBuffer.length - separator.length;
	  if (available <= 0 || output.length > available) {
		consoleBuffer += separator + output.slice(0, Math.max(0, available));
		consoleBuffer += '\n…输出过多，已截断';
		consoleOutputTruncated = true;
	  } else {
		consoleBuffer += separator + output;
	  }
	  if (!consoleFlushTimer) {
		consoleFlushTimer = setTimeout(() => {
		  consoleFlushTimer = null;
		  this.flushConsoleOutput();
		}, CONSOLE_FLUSH_DELAY);
	  }
	},

	flushConsoleOutput() {
	  this.result = consoleBuffer || '暂无输出';
	},

    processInputQueue() {
      if (this.waitingForInput || this.inputQueue.length === 0) {
        return;
      }

      const { message, callback } = this.inputQueue.shift();
      this.promptMessage = message;
      this.inputBuffer = "";
      this.hideInputMethod = false;
      this.inputMethodHide = false;
      this.waitingForInput = true;

      // 存储当前回调
      this.currentInputCallback = callback;
    },

    runCode() {
	  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
	  consoleFlushTimer = null;
	  consoleBuffer = '';
	  consoleOutputTruncated = false;
      this.result = "";
      this.error = "";
      this.hasError = false;
      this.runTime = "";

      if (!this.code.trim()) {
        this.result = "没有代码可执行";
        return;
      }

      // 清空输入队列（可选：根据需求决定是否保留）
      this.inputQueue = [];
      this.waitingForInput = false;

      const exposedModules = {
        app, device, router, configuration,
        storage, file,
        network, brightness, battery, geolocation, vibrator, event, sensor, record,
        fetch, interconnect, uploadtask, request, prompt,
        crypto, audio,
        console: this.vwindow.console,
        input: this.vwindow.input   // 使用全局 input
      };

      try {
        const userFunction = new Function(...Object.keys(exposedModules), `
            ${this.code}
        `);

		setTimeout(() => {
		  const startTime = Date.now();
		  try {
			userFunction(...Object.values(exposedModules));
		  } catch (error) {
			this.error = `${error.name}: ${error.message}`;
			this.hasError = true;
		  }
		  this.runTime = Date.now() - startTime;
		  if (consoleFlushTimer) clearTimeout(consoleFlushTimer);
		  consoleFlushTimer = null;
		  this.flushConsoleOutput();
		}, 0);
      } catch (e) {
        this.result = "";
        this.error = `${e.name}: ${e.message}`;
        this.hasError = true;
      }
    },

    // 中文选词完成或英文输入完成
    onComplete(e) {
      this.inputBuffer += e.detail.content;
    },

    // 删除最后一个字符
    onDelete() {
      if (this.inputBuffer.length > 0) {
        this.inputBuffer = this.inputBuffer.slice(0, -1);
      }
    },

    // 用户点击确认按钮
    onPromptConfirm() {
      vibrate('short');
      const finalInput = this.inputBuffer;

      // 隐藏区域和键盘
      this.hideInputMethod = true;
      this.inputMethodHide = true;
      this.waitingForInput = false;

      // 执行回调
      if (this.currentInputCallback) {
        try {
          this.currentInputCallback(finalInput);
        } catch (e) {
          this.vwindow.console.error("Input callback error:", e);
        }
        this.currentInputCallback = null;
      }

      this.inputBuffer = "";

      // 处理下一个输入请求（如果有）
      this.$nextTick(() => {
        this.processInputQueue();
      });
    }
  }
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  position: relative;
  flex-direction: column;
}

.scroll-container {
  position: absolute;
  top: 0px;
  left: 0px;
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 86px 6px 6px;
}

.console-card {
  flex-direction: column;
  padding: 14px 20px;
  margin-bottom: 8px;
  border-radius: 36px;
  background-color: #262626;
}

.result-title {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 8px;
}

.result-box {
  flex-direction: column;
}

.result {
  color: #9cdcfe;
  font-size: 24px;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.error {
  color: #f48771;
  font-size: 24px;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.runtime {
  color: rgba(200, 200, 200, 0.8);
  font-size: 20px;
  margin-top: 6px;
}


.prompt-message {
  position: absolute;
  bottom: 320px;
  left: 6px;
  color: #ffffff;
  font-size: 24px;
  min-height: 36px;
  background-color: #262626a0;
}

.input-display {
  position: absolute;
  left: 6px;
  bottom: 260px;
  width: 258px;
  color: #9cdcfe;
  font-size: 24px;
  min-height: 60px;
  border-width: 3px;
  border-color: #0d6eff;
  border-radius: 36px;
  background-color: #262626;

}

.btn-confirm {
  position: absolute;
  right: 6px;
  bottom: 260px;
  width: 60px;
  height: 60px;
}

.topbar-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 336px;
  height: 102px;
}

.btn {
  position: absolute;
  width: 72px;
  height: 72px;
}

.time-text {
  position: absolute;
  left: 78px;
  top: 7px;
  width: 180px;
  line-height: 32px;
  font-weight: bold;
  font-size: 24px;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

.title-text {
  position: absolute;
  left: 78px;
  top: 35px;
  width: 180px;
  line-height: 42px;
  font-weight: bold;
  font-size: 32px;
  color: white;
  text-align: center;
}
</style>
